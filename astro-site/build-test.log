[96mdist/assets/FAQAccordion.Bd8TpdAc.js[0m:[93m1[0m:[93m5428[0m - [93mwarning[0m[90m ts(7027): [0mUnreachable code detected.

[7m1[0m import{r as e,j as n}from"./react-vendor.vHlgZV4x.js";/* empty css                       */import"./vendor.vjhJKvYF.js";const i=[{id:1,question:"Welche Dienstleistungen bietet Gartenbau Z.M. an?",answer:"Wir bieten ein umfassendes Spektrum an Gartenbau-Dienstleistungen: Professionelle Gartengestaltung und -planung, hochwertige Natursteinarbeiten, Terrassenbau, Pflasterarbeiten für Wege und Zufahrten, Hausmeisterservice, Sichtschutz-Installation, Erdarbeiten sowie Rollrasen-Verlegung. Alle Arbeiten führen wir in Remseck, Stuttgart, Ludwigsburg, Waiblingen und der gesamten Region aus."},{id:2,question:"In welchen Regionen sind Sie tätig?",answer:"Unser Hauptarbeitsgebiet umfasst Remseck am Neckar, Stuttgart, Ludwigsburg, Waiblingen, Kornwestheim, Fellbach, Esslingen, Böblingen und Backnang. Wir bedienen die gesamte Region Stuttgart und den Rems-Murr-Kreis. Für größere Projekte sind wir auch in Baden-Württemberg darüber hinaus tätig."},{id:3,question:"Bieten Sie kostenlose Beratung und Kostenvoranschläge an?",answer:"Ja, wir bieten kostenlose Erstberatung vor Ort an. Dabei besichtigen wir Ihr Grundstück, besprechen Ihre Wünsche und Vorstellungen und erstellen anschließend einen detaillierten, unverbindlichen Kostenvoranschlag. Kontaktieren Sie uns telefonisch unter +49 178 2747470 oder per WhatsApp, um einen Termin zu vereinbaren."},{id:4,question:"Wie lange dauert ein typisches Gartenbau-Projekt?",answer:"Die Projektdauer variiert je nach Umfang: Kleinere Arbeiten wie Rollrasen-Verlegung oder Pflanzungen können 1-3 Tage dauern. Terrassenbau und Pflasterarbeiten benötigen typischerweise 3-7 Tage. Komplette Gartenumgestaltungen mit Natursteinarbeiten, Terrassen und Bepflanzung können 2-4 Wochen in Anspruch nehmen. Bei der Erstberatung geben wir Ihnen eine genaue Zeitplanung."},{id:5,question:"Welche Materialien verwenden Sie für Natursteinarbeiten?",answer:"Wir arbeiten mit hochwertigen Natursteinen wie Granit, Sandstein, Muschelkalk, Basalt und Porphyr sowie mit modernen Betonsteinen. Die Materialauswahl erfolgt individuell nach Ihren Wünschen, dem Projektbudget und der vorgesehenen Verwendung. Wir beraten Sie ausführlich zu den Eigenschaften, Vor- und Nachteilen der verschiedenen Materialien und zeigen Ihnen Mustersteine."},{id:6,question:"Übernehmen Sie auch Wartung und Pflege nach Projektabschluss?",answer:"Ja, wir bieten umfassende Gartenpflege und Hausmeisterservice an. Nach Abschluss Ihres Projekts können wir regelmäßige Pflegearbeiten wie Rasenmähen, Heckenschnitt, Unkrautbekämpfung und Laubbeseitigung übernehmen. Wir erstellen gerne einen individuellen Pflegeplan, der zu Ihrem Garten und Budget passt."},{id:7,question:"Welche Zahlungsmöglichkeiten bieten Sie an?",answer:"Wir akzeptieren Barzahlung und Banküberweisung. Die Zahlungsmodalitäten werden individuell vereinbart – typischerweise eine Anzahlung bei Projektbeginn, Teilzahlungen bei größeren Projekten und die Restzahlung nach erfolgreicher Fertigstellung. Alle Details werden transparent im Kostenvoranschlag und Vertrag festgehalten."},{id:8,question:"Arbeiten Sie mit umweltfreundlichen Materialien und Methoden?",answer:"Ja, Nachhaltigkeit ist uns wichtig. Wir verwenden bevorzugt regionale Materialien, um Transportwege zu minimieren. Bei Bepflanzungen setzen wir auf einheimische, bienenfreundliche Pflanzen. Wir verzichten auf chemische Unkrautvernichter und nutzen stattdessen mechanische oder thermische Methoden. Zudem beraten wir zu wassersparenden Bewässerungssystemen und nachhaltigen Gartenlösungen."},{id:9,question:"Bieten Sie auch Winterdienst an?",answer:"Ja, wir bieten professionellen Winterdienst für Privathaushalte und Gewerbeobjekte an. Unser Service umfasst Schneeräumung, Streudienst und die Sicherstellung der Verkehrssicherheit auf Ihren Wegen und Zufahrten. Wir sind zuverlässig erreichbar und sorgen dafür, dass Ihr Grundstück auch bei Schnee und Eis sicher begehbar bleibt."},{id:10,question:"Können Sie auch bei bestehenden Gärten helfen?",answer:"Selbstverständlich! Wir übernehmen nicht nur Neuanlagen, sondern auch die Umgestaltung und Modernisierung bestehender Gärten. Ob Sie einzelne Bereiche erneuern möchten, einen veralteten Garten komplett neu gestalten oder nur kleinere Verbesserungen wünschen – wir finden gemeinsam mit Ihnen die beste Lösung und setzen diese professionell um."}];function r({faq:i,isOpen:r,onToggle:t}){const s=e.useRef(null),[a,u]=e.useState(void 0);return e.useEffect(()=>{s.current&&u(r?s.current.scrollHeight:0)},[r]),n.jsxs("div",{className:"faq-item "+(r?"active":""),children:[n.jsxs("button",{className:"faq-question",onClick:t,"aria-expanded":r,"aria-controls":`faq-answer-${i.id}`,id:`faq-question-${i.id}`,children:[n.jsx("h3",{children:i.question}),n.jsx("svg",{className:"faq-icon",width:"24",height:"24",viewBox:"0 0 24 24",fill:"none",stroke:"currentColor",strokeWidth:"2",strokeLinecap:"round",strokeLinejoin:"round","aria-hidden":"true",children:n.jsx("path",{d:"M19 9l-7 7-7-7"})})]}),n.jsx("div",{id:`faq-answer-${i.id}`,className:"faq-answer",role:"region","aria-labelledby":`faq-question-${i.id}`,style:{height:void 0!==a?`${a}px`:void 0},children:n.jsx("div",{className:"faq-answer-content",ref:s,children:n.jsx("p",{children:i.answer})})})]})}function t(){const[t,s]=e.useState(null);return n.jsx("div",{className:"faq-accordion",children:i.map(e=>n.jsx(r,{faq:e,isOpen:t===e.id,onToggle:()=>{return n=e.id,void s(t===n?null:n);var n}},e.id))})}export{t as default};
