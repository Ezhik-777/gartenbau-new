---
// Footer.astro v5.0 - Modern Three-Column Footer with Green Theme
const currentYear = new Date().getFullYear();

const services = [
  'Gartengestaltung',
  'Natursteinarbeiten',
  'Terrassenbau',
  'Pflasterarbeiten',
  'Sichtschutz & Zäune',
  'Gartenpflege'
];
---

<footer class="footer" role="contentinfo" transition:name="footer">
  <div class="container">
    <!-- Footer Top - Three Column Layout -->
    <div class="footer__top">
      <!-- Column 1: Services -->
      <div class="footer__column footer__services">
        <h4 class="footer__heading">Leistungen</h4>
        <ul class="footer__list">
          {services.map(service => (
            <li class="footer__list-item">
              <span class="footer__list-icon">✓</span>
              {service}
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 2: Contact -->
      <div class="footer__column footer__contact">
        <h4 class="footer__heading">Kontakt</h4>
        <div class="footer__contact-info">
          <p class="footer__contact-item">
            <span class="footer__icon">📍</span>
            Lerchenrain 9<br>
            <span class="footer__indent">71686 Remseck am Neckar</span>
          </p>
          <p class="footer__contact-item">
            <span class="footer__icon">📞</span>
            <a href="tel:+491782747470" class="footer__link">+49 178 2747470</a>
          </p>
          <p class="footer__contact-item">
            <span class="footer__icon">📧</span>
            <a href="mailto:info.gartenbauzm@gmx.de" class="footer__link">info.gartenbauzm@gmx.de</a>
          </p>
        </div>

        <!-- Social Icons -->
        <div class="footer__social">
          <a
            href="https://wa.me/491782747470"
            class="footer__social-link footer__social-link--whatsapp"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp kontaktieren"
          >
            <svg class="footer__social-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            WhatsApp
          </a>
          <a
            href="https://g.page/r/CZk_BZnPcSqHEB0/review"
            class="footer__social-link footer__social-link--google"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Google Bewertung schreiben"
          >
            <svg class="footer__social-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
            </svg>
            Bewerten
          </a>
        </div>
      </div>

      <!-- Column 3: Legal & Info -->
      <div class="footer__column footer__legal">
        <h4 class="footer__heading">Rechtliches</h4>
        <nav class="footer__nav" aria-label="Legal Navigation">
          <a href="/impressum" class="footer__nav-link">Impressum</a>
          <a href="/datenschutz" class="footer__nav-link">Datenschutz</a>
        </nav>

        <div class="footer__info">
          <h5 class="footer__subheading">Servicegebiet</h5>
          <p class="footer__text">
            Stuttgart, Remseck am Neckar, Ludwigsburg, Waiblingen, Kornwestheim, Fellbach & Umgebung
          </p>
        </div>
      </div>
    </div>

    <!-- Footer Bottom - Copyright -->
    <div class="footer__bottom">
      <div class="footer__copyright">
        <p>&copy; {currentYear} Gartenbau Z.M. | Alle Rechte vorbehalten</p>
      </div>
      <div class="footer__brand-badge">
        <span class="footer__brand-icon">🌿</span>
        <span class="footer__brand-text">Ihr Partner für professionelle Gartengestaltung</span>
      </div>
    </div>

    <!-- Back to Top Button -->
    <a href="#top" class="back-to-top" aria-label="Nach oben scrollen">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 19V5M5 12l7-7 7 7"/>
      </svg>
    </a>
  </div>
</footer>

<style>
  /* ========================================
     FOOTER v5.0 - Modern Green Theme
     ======================================== */

  .footer {
    background: linear-gradient(135deg, var(--color-neutral-900) 0%, var(--color-neutral-800) 100%);
    color: var(--color-neutral-100);
    padding: var(--space-16) 0 var(--space-6);
    position: relative;
    overflow: hidden;
  }

  /* Subtle green accent overlay */
  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg,
      transparent 0%,
      var(--color-primary-500) 50%,
      transparent 100%
    );
  }

  /* ========== THREE-COLUMN LAYOUT ========== */
  .footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 768px) {
    .footer__top {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-10);
    }
  }

  @media (min-width: 1024px) {
    .footer__top {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-12);
    }
  }

  /* Column Styling */
  .footer__column {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* ========== HEADINGS ========== */
  .footer__heading {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-primary-400);
    margin: 0 0 var(--space-4);
    position: relative;
    padding-bottom: var(--space-3);
  }

  .footer__heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    height: 2px;
    background: var(--color-primary-500);
  }

  .footer__subheading {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-neutral-200);
    margin: 0 0 var(--space-2);
  }

  /* ========== SERVICES COLUMN ========== */
  .footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__list-item {
    font-size: var(--text-sm);
    color: var(--color-neutral-300);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    line-height: var(--leading-relaxed);
  }

  .footer__list-icon {
    color: var(--color-primary-500);
    font-weight: var(--font-bold);
    font-size: var(--text-base);
    flex-shrink: 0;
  }

  /* ========== CONTACT COLUMN ========== */
  .footer__contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer__contact-item {
    font-size: var(--text-sm);
    color: var(--color-neutral-300);
    margin: 0;
    line-height: var(--leading-relaxed);
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .footer__icon {
    font-size: var(--text-lg);
    flex-shrink: 0;
    display: inline-block;
    width: 24px;
  }

  .footer__indent {
    display: inline-block;
    padding-left: calc(24px + var(--space-3));
  }

  .footer__link {
    color: var(--color-primary-400);
    text-decoration: none;
    transition: all var(--transition-fast);
    position: relative;
  }

  .footer__link:hover {
    color: var(--color-primary-300);
    text-shadow: 0 0 8px rgba(34, 197, 94, 0.3);
  }

  /* ========== SOCIAL ICONS ========== */
  .footer__social {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    color: var(--color-neutral-200);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    transition: all var(--transition-base);
  }

  .footer__social-link:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--color-primary-500);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(34, 197, 94, 0.15);
  }

  .footer__social-link--whatsapp:hover {
    color: #25D366;
    border-color: #25D366;
  }

  .footer__social-link--google:hover {
    color: #4285F4;
    border-color: #4285F4;
  }

  .footer__social-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  /* ========== LEGAL COLUMN ========== */
  .footer__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__nav-link {
    font-size: var(--text-sm);
    color: var(--color-neutral-300);
    text-decoration: none;
    transition: all var(--transition-fast);
    width: fit-content;
    position: relative;
  }

  .footer__nav-link::before {
    content: '→';
    position: absolute;
    left: -20px;
    opacity: 0;
    color: var(--color-primary-500);
    transition: all var(--transition-fast);
  }

  .footer__nav-link:hover {
    color: var(--color-primary-400);
    padding-left: var(--space-5);
  }

  .footer__nav-link:hover::before {
    opacity: 1;
    left: 0;
  }

  .footer__info {
    margin-top: var(--space-4);
  }

  .footer__text {
    font-size: var(--text-sm);
    color: var(--color-neutral-400);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* ========== FOOTER BOTTOM ========== */
  .footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-8);
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer__copyright p {
    font-size: var(--text-sm);
    color: var(--color-neutral-500);
    margin: 0;
  }

  .footer__brand-badge {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-neutral-400);
    font-size: var(--text-sm);
  }

  .footer__brand-icon {
    font-size: var(--text-lg);
    animation: float 6s ease-in-out infinite;
  }

  .footer__brand-text {
    font-weight: var(--font-medium);
  }

  /* ========== BACK TO TOP BUTTON ========== */
  .back-to-top {
    position: fixed;
    bottom: var(--space-8);
    right: var(--space-6);
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, var(--color-primary-600), var(--color-primary-500));
    color: white;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    box-shadow: var(--shadow-xl);
    transition: all var(--transition-base);
    opacity: 0;
    visibility: hidden;
    z-index: 999;
    border: 2px solid rgba(255, 255, 255, 0.2);
  }

  .back-to-top svg {
    width: 24px;
    height: 24px;
    stroke-width: 3;
  }

  /* Show on scroll (will be handled by island or CSS) */
  @media (min-width: 768px) {
    .back-to-top {
      opacity: 0.9;
      visibility: visible;
    }

    .back-to-top:hover {
      opacity: 1;
      background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-400));
      transform: translateY(-4px);
      box-shadow: var(--glow-green), var(--shadow-2xl);
    }

    .back-to-top:active {
      transform: translateY(-2px);
    }
  }

  /* ========== RESPONSIVE ADJUSTMENTS ========== */
  @media (max-width: 640px) {
    .footer {
      padding: var(--space-12) 0 var(--space-6);
    }

    .footer__social {
      flex-direction: column;
    }

    .footer__social-link {
      justify-content: center;
    }
  }
</style>
