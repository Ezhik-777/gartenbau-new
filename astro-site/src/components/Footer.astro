---
// Footer.astro v6.0 — Organic Luxury Footer with Warm Forest Theme
const currentYear = new Date().getFullYear();

const services = [
  { name: 'Gartengestaltung', href: '/gartengestaltung' },
  { name: 'Natursteinarbeiten', href: '/natursteinarbeiten' },
  { name: 'Terrassenbau', href: '/terrassenbau' },
  { name: 'Pflasterarbeiten', href: '/pflasterarbeiten' },
  { name: 'Landschaftsbau', href: '/landschaftsbau' },
  { name: 'Sichtschutz', href: '/sichtschutz' },
];
---

<footer class="relative bg-forest text-ivory" role="contentinfo" transition:name="footer">
  <!-- Top terracotta accent line -->
  <div class="h-0.5 bg-terracotta"></div>

  <!-- Main footer content -->
  <div class="mx-auto max-w-7xl px-6 pt-16 pb-8 lg:px-8">

    <!-- 4-column grid -->
    <div class="grid grid-cols-1 gap-12 text-center sm:grid-cols-2 sm:text-left lg:grid-cols-4 lg:gap-8">

      <!-- Column 1: Brand -->
      <div class="flex flex-col items-center sm:items-start gap-5">
        <h2 class="font-heading text-xl text-white tracking-wide">GARTENBAU Z.M.</h2>
        <p class="text-sand/80 text-sm leading-relaxed max-w-xs">
          Ihr Partner für professionellen Gartenbau in Stuttgart&nbsp;&amp;&nbsp;Region
        </p>

        <!-- Social row -->
        <div class="flex items-center gap-4 mt-1">
          <!-- WhatsApp -->
          <a
            href="https://wa.me/491782747470"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp kontaktieren"
            class="group flex items-center justify-center w-10 h-10 rounded-full border border-ivory/20 text-ivory/70 transition-all duration-300 hover:border-[#25D366] hover:text-[#25D366] hover:bg-[#25D366]/10"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>

          <!-- Google Reviews -->
          <a
            href="https://g.page/r/CZk_BZnPcSqHEB0/review"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Google Bewertung schreiben"
            class="group flex items-center justify-center w-10 h-10 rounded-full border border-ivory/20 text-ivory/70 transition-all duration-300 hover:border-[#4285F4] hover:text-[#4285F4] hover:bg-[#4285F4]/10"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Leistungen -->
      <div class="flex flex-col items-center sm:items-start gap-5">
        <h3 class="text-xs font-semibold uppercase tracking-widest text-sand">Leistungen</h3>
        <ul class="space-y-3">
          {services.map(({ name, href }) => (
            <li>
              <a
                href={href}
                class="text-sm text-ivory/70 transition-colors duration-300 hover:text-terracotta"
              >
                {name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Kontakt -->
      <div class="flex flex-col items-center sm:items-start gap-5">
        <h3 class="text-xs font-semibold uppercase tracking-widest text-sand">Kontakt</h3>
        <ul class="space-y-4">
          <!-- Address -->
          <li class="flex items-start gap-3 text-sm text-ivory/70">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-terracotta/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span>Remseck am Neckar</span>
          </li>

          <!-- Phone -->
          <li class="flex items-start gap-3 text-sm">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-terracotta/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
            </svg>
            <a
              href="tel:+491782747470"
              class="text-ivory/70 transition-colors duration-300 hover:text-terracotta"
            >
              +49 178 2747470
            </a>
          </li>

          <!-- Email -->
          <li class="flex items-start gap-3 text-sm">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-terracotta/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="M22 7l-8.97 5.7a1.94 1.94 0 01-2.06 0L2 7"/>
            </svg>
            <a
              href="mailto:info.gartenbauzm@gmx.de"
              class="text-ivory/70 transition-colors duration-300 hover:text-terracotta"
            >
              info.gartenbauzm@gmx.de
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Oeffnungszeiten -->
      <div class="flex flex-col items-center sm:items-start gap-5">
        <h3 class="text-xs font-semibold uppercase tracking-widest text-sand">&Ouml;ffnungszeiten</h3>
        <dl class="space-y-3 text-sm text-ivory/70">
          <div class="flex justify-between gap-6">
            <dt>Mo &ndash; Fr</dt>
            <dd>08:00 &ndash; 18:00</dd>
          </div>
          <div class="flex justify-between gap-6">
            <dt>Sa</dt>
            <dd>09:00 &ndash; 14:00</dd>
          </div>
          <div class="flex justify-between gap-6">
            <dt>So</dt>
            <dd class="text-ivory/50">Geschlossen</dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-14 flex flex-col items-center gap-4 border-t border-forest-light pt-8 sm:flex-row sm:justify-between">
      <p class="text-sm text-ivory/50">
        &copy; {currentYear} Gartenbau Z.M. Alle Rechte vorbehalten.
      </p>
      <nav class="flex items-center gap-6" aria-label="Rechtliche Links">
        <a href="/impressum" class="text-sm text-ivory/50 transition-colors duration-300 hover:text-sand">Impressum</a>
        <a href="/datenschutz" class="text-sm text-ivory/50 transition-colors duration-300 hover:text-sand">Datenschutz</a>
      </nav>
    </div>
  </div>

  <!-- Back-to-top button -->
  <button
    id="back-to-top"
    type="button"
    aria-label="Nach oben scrollen"
    class="fixed bottom-8 right-6 z-50 flex h-11 w-11 items-center justify-center rounded-full bg-terracotta text-white shadow-lg transition-all duration-300 hover:bg-terracotta-dark hover:shadow-xl hover:-translate-y-1 opacity-0 invisible"
  >
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 19V5"/>
      <path d="M5 12l7-7 7 7"/>
    </svg>
  </button>
</footer>

<script>
  function initBackToTop() {
    const btnEl = document.getElementById('back-to-top');
    if (!btnEl) return;
    const btn = btnEl;

    let visible = false;

    function toggle() {
      const shouldShow = window.scrollY > 400;
      if (shouldShow === visible) return;
      visible = shouldShow;
      if (shouldShow) {
        btn.classList.remove('opacity-0', 'invisible');
        btn.classList.add('opacity-100', 'visible');
      } else {
        btn.classList.remove('opacity-100', 'visible');
        btn.classList.add('opacity-0', 'invisible');
      }
    }

    window.addEventListener('scroll', toggle, { passive: true });
    toggle();

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  initBackToTop();
  document.addEventListener('astro:page-load', initBackToTop);
</script>
