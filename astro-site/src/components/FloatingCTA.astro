---
/**
 * FloatingCTA.astro - Floating Call-to-Action Buttons
 * WhatsApp and Phone buttons for quick contact
 */
---

<div class="floating-cta" id="floating-cta" aria-label="Schnellkontakt">
  <a
    href="https://wa.me/491782747470?text=Hallo%2C%20ich%20interessiere%20mich%20für%20Ihre%20Gartendienstleistungen."
    class="floating-cta__btn floating-cta__btn--whatsapp"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="WhatsApp Nachricht senden"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
    <span class="floating-cta__tooltip">WhatsApp</span>
  </a>

  <a
    href="tel:+491782747470"
    class="floating-cta__btn floating-cta__btn--phone"
    aria-label="Anrufen: +49 178 2747470"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
    </svg>
    <span class="floating-cta__tooltip">Anrufen</span>
  </a>
</div>

<style>
  .floating-cta {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    z-index: var(--z-fixed);
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition: all 0.3s ease;
  }

  .floating-cta.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .floating-cta__btn {
    position: relative;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    transition: all 0.3s ease;
  }

  .floating-cta__btn--whatsapp {
    background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
  }

  .floating-cta__btn--phone {
    background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary) 100%);
  }

  .floating-cta__btn:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 25px rgba(0, 0, 0, 0.3);
  }

  .floating-cta__btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* Pulse animation for WhatsApp */
  .floating-cta__btn--whatsapp::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: rgba(37, 211, 102, 0.3);
    animation: pulse-ring 2s infinite;
  }

  @keyframes pulse-ring {
    0% {
      transform: scale(1);
      opacity: 1;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  .floating-cta__tooltip {
    position: absolute;
    right: 100%;
    margin-right: 0.75rem;
    padding: 0.5rem 0.75rem;
    background: var(--color-gray-900);
    color: white;
    font-size: var(--text-sm);
    font-weight: 500;
    border-radius: var(--radius-md);
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transform: translateX(10px);
    transition: all 0.2s ease;
    pointer-events: none;
  }

  .floating-cta__tooltip::after {
    content: '';
    position: absolute;
    right: -6px;
    top: 50%;
    transform: translateY(-50%);
    border: 6px solid transparent;
    border-left-color: var(--color-gray-900);
  }

  .floating-cta__btn:hover .floating-cta__tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }

  @media (max-width: 768px) {
    .floating-cta {
      bottom: 1rem;
      right: 1rem;
    }

    .floating-cta__btn {
      width: 3rem;
      height: 3rem;
    }

    .floating-cta__btn svg {
      width: 20px;
      height: 20px;
    }

    .floating-cta__tooltip {
      display: none;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .floating-cta__btn--whatsapp::before {
      animation: none;
    }

    .floating-cta,
    .floating-cta__btn,
    .floating-cta__tooltip {
      transition: none;
    }
  }
</style>

<script>
  const floatingCta = document.getElementById('floating-cta');

  if (floatingCta) {
    // Show after scrolling
    window.addEventListener('scroll', () => {
      if (window.scrollY > 200) {
        floatingCta.classList.add('visible');
      } else {
        floatingCta.classList.remove('visible');
      }
    });

    // Show immediately if already scrolled
    if (window.scrollY > 200) {
      floatingCta.classList.add('visible');
    }
  }
</script>
