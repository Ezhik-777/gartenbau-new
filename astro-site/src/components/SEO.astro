---
// SEO.astro - Enhanced SEO component with Schema.org structured data
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType = 'website',
  noindex = false
} = Astro.props;

const siteUrl = 'https://gartenbauzm.de';
const fullCanonical = canonical || Astro.url.pathname;
const fullOgImage = ogImage || `${siteUrl}/img/image_25.webp`;

// LocalBusiness Schema.org
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "LandscapingBusiness"],
  "@id": `${siteUrl}/#business`,
  "name": "Gartenbau Z.M.",
  "legalName": "Gartenbau Z.M.",
  "description": "Professioneller Garten- und Landschaftsbau in Remseck am Neckar, Stuttgart und Region. Gartengestaltung, Natursteinarbeiten, Terrassenbau, Pflasterarbeiten.",
  "url": siteUrl,
  "logo": {
    "@type": "ImageObject",
    "url": `${siteUrl}/img/logo.webp`,
    "width": "200",
    "height": "200"
  },
  "image": [
    `${siteUrl}/img/image_25.webp`,
    `${siteUrl}/img/image_42.webp`,
    `${siteUrl}/img/image_87.webp`
  ],
  "telephone": "+491782747470",
  "email": "info.gartenbauzm@gmx.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Lerchenrain 9",
    "addressLocality": "Remseck am Neckar",
    "postalCode": "71686",
    "addressRegion": "Baden-Württemberg",
    "addressCountry": "DE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "48.8951",
    "longitude": "9.2742"
  },
  "areaServed": [
    {
      "@type": "City",
      "name": "Remseck am Neckar",
      "containedInPlace": {
        "@type": "State",
        "name": "Baden-Württemberg"
      }
    },
    {
      "@type": "City",
      "name": "Stuttgart"
    },
    {
      "@type": "City",
      "name": "Ludwigsburg"
    },
    {
      "@type": "City",
      "name": "Waiblingen"
    },
    {
      "@type": "City",
      "name": "Kornwestheim"
    },
    {
      "@type": "City",
      "name": "Fellbach"
    }
  ],
  "priceRange": "€€",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Saturday",
      "opens": "09:00",
      "closes": "14:00"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "47",
    "bestRating": "5",
    "worstRating": "1"
  },
  "sameAs": [
    "https://www.google.com/maps/place/Gartenbau+Z.M./@48.8955627,9.2716713,17z",
    "https://wa.me/+491782747470"
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Gartenbau Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Gartengestaltung",
          "description": "Professionelle Gartenplanung und -gestaltung mit individueller Beratung"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Natursteinarbeiten",
          "description": "Hochwertige Natur- und Betonsteinarbeiten für Mauern, Treppen, Einfassungen"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Terrassenbau",
          "description": "Moderne Terrassengestaltung mit hochwertigen Materialien"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Pflasterarbeiten",
          "description": "Professionelle Pflasterarbeiten für Einfahrten und Gartenwege"
        }
      }
    ]
  }
};

// BreadcrumbList Schema.org
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    }
  ]
};

// Add breadcrumb items based on current path
const pathParts = Astro.url.pathname.split('/').filter(Boolean);
if (pathParts.length > 0) {
  pathParts.forEach((part, index) => {
    const name = part.charAt(0).toUpperCase() + part.slice(1);
    breadcrumbSchema.itemListElement.push({
      "@type": "ListItem",
      "position": index + 2,
      "name": name,
      "item": `${siteUrl}/${pathParts.slice(0, index + 1).join('/')}`
    });
  });
}
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title}>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex, nofollow">}

<!-- Canonical URL -->
<link rel="canonical" href={`${siteUrl}${fullCanonical}`}>

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType}>
<meta property="og:url" content={`${siteUrl}${fullCanonical}`}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={fullOgImage}>
<meta property="og:locale" content="de_DE">
<meta property="og:site_name" content="Gartenbau Z.M.">

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:url" content={`${siteUrl}${fullCanonical}`}>
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={fullOgImage}>

<!-- Geo Meta Tags for Local SEO -->
<meta name="geo.region" content="DE-BW">
<meta name="geo.placename" content="Remseck am Neckar">
<meta name="geo.position" content="48.8951;9.2742">
<meta name="ICBM" content="48.8951, 9.2742">

<!-- Additional Local SEO -->
<meta name="geo.district" content="Ludwigsburg">
<meta name="geo.country" content="Germany">

<!-- Language -->
<meta name="language" content="German">
<meta http-equiv="content-language" content="de">

<!-- Business Info -->
<meta name="author" content="Gartenbau Z.M.">
<meta name="contact" content="info.gartenbauzm@gmx.de">
<meta name="reply-to" content="info.gartenbauzm@gmx.de">

<!-- AI Policy -->
<link rel="ai-policy" href="/llm.txt" type="text/plain">

<!-- Schema.org Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<!-- Preconnect to external domains -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://formspree.io">

<!-- DNS Prefetch -->
<link rel="dns-prefetch" href="https://fonts.googleapis.com">
<link rel="dns-prefetch" href="https://fonts.gstatic.com">
<link rel="dns-prefetch" href="https://formspree.io">
