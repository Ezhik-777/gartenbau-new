---
// ProjectCard.astro — Organic Luxury Project Card
interface Props {
  title: string;
  description: string;
  category: string;
  heroImage: string;
  location: string;
  href: string;
}

const { title, description, category, heroImage, location, href } = Astro.props;

const categoryLabels: Record<string, string> = {
  gartengestaltung: 'Gartengestaltung',
  naturstein: 'Naturstein',
  terrasse: 'Terrasse',
  pflaster: 'Pflaster',
  sichtschutz: 'Sichtschutz',
};

const categoryLabel = categoryLabels[category] ?? category;
---

<a
  href={href}
  class="block group bg-white rounded-2xl overflow-hidden border border-transparent hover:border-sand transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-forest/5"
>
  <!-- Image -->
  <div class="relative aspect-[4/3] overflow-hidden">
    <img
      src={heroImage}
      alt={title}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    <span class="absolute top-4 left-4 bg-forest/80 text-white text-xs uppercase tracking-wider px-3 py-1 rounded-full backdrop-blur-sm">
      {categoryLabel}
    </span>
  </div>

  <!-- Content -->
  <div class="p-6">
    <h3 class="font-heading text-xl text-forest group-hover:text-terracotta transition-colors">
      {title}
    </h3>

    <p class="text-text-muted text-sm mt-1 flex items-center gap-1">
      <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
        <circle cx="12" cy="10" r="3"/>
      </svg>
      {location}
    </p>

    <p class="text-text-muted text-sm leading-relaxed mt-3 line-clamp-2">
      {description}
    </p>
  </div>
</a>
