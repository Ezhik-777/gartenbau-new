---
// Gallery.astro - Photo gallery with lazy loading island
import GalleryGrid from './GalleryGrid';

// Generate all 180 image data
const images = Array.from({ length: 180 }, (_, i) => {
  const id = i + 1;

  // Categorize images based on ID ranges
  let category = 'garden';
  let alt = '';
  let title = '';

  if (id >= 1 && id <= 60) {
    category = 'garden';
    alt = `Gartengestaltung Projekt ${id} - Gartenbau Z.M. in Remseck und Stuttgart`;
    title = `Gartengestaltung #${id}`;
  } else if (id >= 61 && id <= 105) {
    category = 'stone';
    alt = `Natursteinarbeiten Projekt ${id} - Hochwertige Steinarbeiten in der Region Stuttgart`;
    title = `Natursteinarbeiten #${id}`;
  } else if (id >= 106 && id <= 140) {
    category = 'terrace';
    alt = `Terrassenbau Projekt ${id} - Moderner Terrassenbau in Ludwigsburg und Waiblingen`;
    title = `Terrassenbau #${id}`;
  } else if (id >= 141 && id <= 165) {
    category = 'paving';
    alt = `Pflasterarbeiten Projekt ${id} - Professionelle Pflasterarbeiten in Stuttgart`;
    title = `Pflasterarbeiten #${id}`;
  } else {
    category = 'privacy';
    alt = `Sichtschutz Projekt ${id} - Sichtschutz und Zaunbau in Remseck`;
    title = `Sichtschutz #${id}`;
  }

  return {
    id,
    src: `/img/image_${id}.webp`,
    alt,
    category,
    title,
    width: 800,
    height: 600
  };
});
---

<div class="gallery-wrapper">
  <!-- Section Header -->
  <div class="gallery-header">
    <h2 class="gallery-title">Unsere Projekte</h2>
    <p class="gallery-subtitle">
      Entdecken Sie über 180 erfolgreich abgeschlossene Gartenprojekte in Stuttgart und der Region
    </p>
  </div>

  <!-- Filter buttons -->
  <div class="gallery-filters">
    <button class="filter-btn active" data-filter="all">
      Alle Projekte (180)
    </button>
    <button class="filter-btn" data-filter="garden">
      🌱 Gartengestaltung (60)
    </button>
    <button class="filter-btn" data-filter="stone">
      🪨 Natursteinarbeiten (45)
    </button>
    <button class="filter-btn" data-filter="terrace">
      🏗️ Terrassenbau (35)
    </button>
    <button class="filter-btn" data-filter="paving">
      🛤️ Pflasterarbeiten (25)
    </button>
    <button class="filter-btn" data-filter="privacy">
      🏡 Sichtschutz (15)
    </button>
  </div>

  <!-- Gallery Grid - React Island for virtual scrolling & lightbox -->
  <GalleryGrid client:visible images={images} />
</div>

<style>
  /* Gallery Wrapper */
  .gallery-wrapper {
    width: 100%;
  }

  /* Gallery Header */
  .gallery-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .gallery-title {
    font-size: var(--text-4xl);
    font-weight: var(--font-extrabold);
    background: linear-gradient(135deg, var(--color-primary-600), var(--color-primary-400));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--space-3);
  }

  .gallery-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Filter Buttons */
  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
    justify-content: center;
  }

  .filter-btn {
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    background: white;
    color: var(--text-secondary);
    border: 2px solid var(--color-neutral-200);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-base);
    white-space: nowrap;
    position: relative;
    overflow: hidden;
  }

  .filter-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-400));
    opacity: 0;
    transition: opacity var(--transition-base);
    z-index: -1;
  }

  .filter-btn:hover {
    border-color: var(--color-primary-500);
    color: var(--color-primary-700);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .filter-btn.active {
    background: linear-gradient(135deg, var(--color-primary-600), var(--color-primary-500));
    color: white;
    border-color: var(--color-primary-600);
    box-shadow: var(--glow-green);
  }

  .filter-btn.active::before {
    opacity: 1;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .gallery-header {
      margin-bottom: var(--space-8);
    }

    .gallery-title {
      font-size: var(--text-3xl);
    }

    .gallery-subtitle {
      font-size: var(--text-base);
      padding: 0 var(--space-4);
    }

    .gallery-filters {
      gap: var(--space-2);
      margin-bottom: var(--space-6);
    }

    .filter-btn {
      padding: var(--space-2) var(--space-4);
      font-size: var(--text-sm);
    }
  }
</style>
