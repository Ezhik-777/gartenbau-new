---
interface Props {
  opacity?: number;
  color?: string;
  class?: string;
}

const {
  opacity = 0.03,
  color = 'currentColor',
  class: className = ''
} = Astro.props;

// Generate a unique ID for this pattern instance to avoid conflicts
const patternId = `leaf-pattern-${Math.random().toString(36).substr(2, 9)}`;
---

<div class={`background-pattern ${className}`} aria-hidden="true">
  <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern
        id={patternId}
        x="0"
        y="0"
        width="120"
        height="120"
        patternUnits="userSpaceOnUse"
        patternTransform="rotate(15)"
      >
        <!-- Oak leaf -->
        <g transform="translate(20, 20) scale(0.4)" opacity={opacity} fill={color}>
          <path d="M24 2c-3 0-6 2-8 4-2-2-5-4-8-4-6 0-8 6-8 10 0 8 6 14 12 18 2 1 3 2 4 2s2-1 4-2c6-4 12-10 12-18 0-4-2-10-8-10z M24 28c-1 0-2-1-3-1-5-3-10-8-10-15 0-3 1-7 5-7 2 0 4 1 6 3l2 2 2-2c2-2 4-3 6-3 4 0 5 4 5 7 0 7-5 12-10 15-1 0-2 1-3 1z" />
        </g>

        <!-- Maple leaf -->
        <g transform="translate(80, 60) scale(0.3)" opacity={opacity} fill={color}>
          <path d="M24 2L20 12 10 8 14 18 4 22 14 26 10 36 20 32 24 42 28 32 38 36 34 26 44 22 34 18 38 8 28 12z" />
        </g>

        <!-- Birch leaf -->
        <g transform="translate(60, 90) scale(0.35)" opacity={opacity} fill={color}>
          <path d="M24 2c-2 0-4 1-5 3L12 18c-1 2-2 4-2 6 0 4 3 8 7 10l5 2c1 0 2 0 2 0l5-2c4-2 7-6 7-10 0-2-1-4-2-6L27 5c-1-2-3-3-5-3z M24 6c1 0 2 0 2 1l7 13c1 1 1 2 1 3 0 2-2 5-4 6l-5 2h-2l-5-2c-2-1-4-4-4-6 0-1 0-2 1-3l7-13c0-1 1-1 2-1z" />
        </g>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#${patternId})`} />
  </svg>
</div>

<style>
  .background-pattern {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .background-pattern svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  /* Subtle animation for the pattern */
  @media (prefers-reduced-motion: no-preference) {
    .background-pattern svg {
      animation: pattern-drift 60s linear infinite;
    }
  }

  @keyframes pattern-drift {
    0% {
      transform: translate(0, 0);
    }
    100% {
      transform: translate(120px, 120px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .background-pattern svg {
      animation: none;
    }
  }
</style>
