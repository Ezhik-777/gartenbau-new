---
// Header.astro - Static Navigation (Zero JS)
// Mobile menu will be handled by MobileMenu.tsx island
---

<header class="header" id="top" role="banner">
  <div class="container">
    <div class="header__row">
      <!-- Logo -->
      <a href="/" class="logo" aria-label="Gartenbau Z.M. - Zurück zur Startseite">
        Gartenbau Z.M.
      </a>

      <!-- Desktop Navigation -->
      <nav class="header__nav" role="navigation" aria-label="Hauptnavigation">
        <ul class="nav__list" role="menubar">
          <li role="menuitem">
            <a href="/" aria-current="page">HOME</a>
          </li>
          <li role="menuitem">
            <a href="#Leistungen">LEISTUNGEN</a>
          </li>
          <li role="menuitem">
            <a href="#Ueber-uns">ÜBER UNS</a>
          </li>
          <li role="menuitem">
            <a href="#Projekte">PROJEKTE</a>
          </li>
          <li role="menuitem">
            <a href="#Kontakt">KONTAKT</a>
          </li>
        </ul>
      </nav>

      <!-- Phone (Desktop) -->
      <a href="https://wa.me/+491782747470" class="header__phone">
        <span class="phone__icon">📞</span>
        <span class="phone__number">+49 178 2747470</span>
      </a>

      <!-- Mobile Menu Button (will be enhanced by island) -->
      <button
        class="burger"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menü öffnen"
        data-mobile-toggle
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<style>
  /* Header Styles */
  .header {
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(16px);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    box-shadow: 0 1px 4px rgba(45, 90, 61, 0.1);
    transition: all var(--transition-fast);
    border-bottom: 1px solid rgba(45, 90, 61, 0.08);
  }

  .header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) 0;
    min-height: 64px;
  }

  @media (min-width: 768px) {
    .header__row {
      min-height: 80px;
      padding: var(--space-4) 0;
    }
  }

  /* Logo */
  .logo {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 4vw, 1.8rem);
    font-weight: var(--font-bold);
    background: linear-gradient(135deg, var(--color-brand), var(--color-brand-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-decoration: none;
    transition: transform var(--transition-fast);
  }

  .logo:hover {
    transform: scale(1.02);
  }

  .logo:active {
    transform: scale(0.98);
  }

  /* Desktop Navigation */
  .header__nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .header__nav {
      display: block;
      flex: 1;
      margin: 0 var(--space-8);
    }
  }

  .nav__list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__list a {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
    position: relative;
    padding: var(--space-2) 0;
  }

  .nav__list a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-brand);
    transform: scaleX(0);
    transition: transform var(--transition-fast);
  }

  .nav__list a:hover {
    color: var(--color-brand);
  }

  .nav__list a:hover::after,
  .nav__list a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  /* Phone (Desktop) */
  .header__phone {
    display: none;
  }

  @media (min-width: 1024px) {
    .header__phone {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-3) var(--space-5);
      background: var(--color-brand);
      color: white;
      text-decoration: none;
      border-radius: var(--radius-lg);
      font-weight: var(--font-semibold);
      font-size: var(--text-sm);
      transition: all var(--transition-base);
    }

    .header__phone:hover {
      background: var(--color-brand-dark);
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
    }

    .phone__icon {
      font-size: var(--text-lg);
    }
  }

  /* Mobile Burger */
  .burger {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 30px;
    height: 24px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 1001;
  }

  @media (min-width: 1024px) {
    .burger {
      display: none;
    }
  }

  .burger span {
    display: block;
    width: 100%;
    height: 3px;
    background: var(--color-brand);
    border-radius: 3px;
    transition: all var(--transition-base);
  }

  .burger:hover span {
    background: var(--color-brand-dark);
  }

  /* Burger Animation (enhanced by island) */
  .burger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(10.5px) rotate(45deg);
  }

  .burger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .burger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-10.5px) rotate(-45deg);
  }

  /* Scrolled State (will be added by JS island if needed) */
  .header.scrolled {
    box-shadow: 0 2px 12px rgba(45, 90, 61, 0.15);
  }
</style>
