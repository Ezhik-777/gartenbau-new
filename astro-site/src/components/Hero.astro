---
/**
 * Hero.astro - Premium Hero Section
 * Modern, clean design with excellent mobile experience
 */

export interface Props {
  title?: string;
  subtitle?: string;
  showStats?: boolean;
  backgroundImage?: string;
}

const {
  title = 'Ihr Traumgarten beginnt hier',
  subtitle = 'Professioneller Garten- und Landschaftsbau in Remseck am Neckar und Stuttgart. Wir verwandeln Ihre Außenbereiche in grüne Oasen.',
  showStats = true,
  backgroundImage = '/images/gallery/hero-bg.png'
} = Astro.props;
---

<section class="hero" aria-label="Willkommen bei Gartenbau Z.M.">
  <!-- Background -->
  <div class="hero__bg">
    <img
      src={backgroundImage}
      alt=""
      class="hero__bg-image"
      loading="eager"
      fetchpriority="high"
      aria-hidden="true"
    />
  </div>

  <!-- Gradient Overlay -->
  <div class="hero__overlay" aria-hidden="true"></div>

  <!-- Content -->
  <div class="container">
    <div class="hero__content">
      <!-- Rating Badge -->
      <div class="hero__rating">
        <div class="hero__rating-stars" aria-label="Bewertung: 5 von 5 Sternen">
          <svg class="hero__star" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <svg class="hero__star" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <svg class="hero__star" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <svg class="hero__star" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <svg class="hero__star" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
        </div>
        <span class="hero__rating-text">5.0 · 47 Google-Bewertungen</span>
      </div>

      <!-- Title -->
      <h1 class="hero__title">{title}</h1>

      <!-- Subtitle -->
      <p class="hero__subtitle">{subtitle}</p>

      <!-- CTA Buttons -->
      <div class="hero__cta">
        <a href="/kontakt/" class="hero__btn hero__btn--primary">
          Kostenlose Beratung
        </a>
        <a href="tel:+491782747470" class="hero__btn hero__btn--secondary">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Anrufen
        </a>
      </div>

      <!-- Stats -->
      {showStats && (
        <div class="hero__stats">
          <div class="hero__stat">
            <div class="hero__stat-value">
              <span class="hero__stat-number" data-count="500">0</span>
              <span class="hero__stat-suffix">+</span>
            </div>
            <span class="hero__stat-label">Projekte</span>
          </div>
          <div class="hero__stat-divider"></div>
          <div class="hero__stat">
            <div class="hero__stat-value">
              <span class="hero__stat-number" data-count="10">0</span>
              <span class="hero__stat-suffix">+</span>
            </div>
            <span class="hero__stat-label">Jahre</span>
          </div>
          <div class="hero__stat-divider"></div>
          <div class="hero__stat">
            <div class="hero__stat-value">
              <span class="hero__stat-number" data-count="100">0</span>
              <span class="hero__stat-suffix">%</span>
            </div>
            <span class="hero__stat-label">Zufrieden</span>
          </div>
        </div>
      )}

      <!-- Trust Badges -->
      <div class="hero__trust">
        <div class="hero__trust-item">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          <span>Kostenlose Beratung</span>
        </div>
        <div class="hero__trust-item">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          <span>Festpreisgarantie</span>
        </div>
        <div class="hero__trust-item">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          <span>Lokaler Service</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator (desktop only) -->
  <div class="hero__scroll" aria-hidden="true">
    <div class="hero__scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 6rem 0 3rem;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      rgba(13, 51, 33, 0.8) 0%,
      rgba(26, 77, 46, 0.85) 40%,
      rgba(13, 51, 33, 0.9) 100%
    );
  }

  /* Content */
  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 680px;
  }

  /* Rating */
  .hero__rating {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1.25rem;
    opacity: 0;
    animation: fadeIn 0.6s ease-out 0.1s forwards;
  }

  .hero__rating-stars {
    display: flex;
    gap: 0.125rem;
  }

  .hero__star {
    width: 1.125rem;
    height: 1.125rem;
    color: #fbbf24;
  }

  .hero__rating-text {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.875rem;
    font-weight: 500;
  }

  /* Title */
  .hero__title {
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    color: white;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
    opacity: 0;
    animation: slideUp 0.6s ease-out 0.2s forwards;
  }

  /* Subtitle */
  .hero__subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    margin-bottom: 1.75rem;
    max-width: 540px;
    opacity: 0;
    animation: slideUp 0.6s ease-out 0.3s forwards;
  }

  /* CTA */
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
    opacity: 0;
    animation: slideUp 0.6s ease-out 0.4s forwards;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    border-radius: 0.625rem;
    transition: all 0.2s ease;
    cursor: pointer;
    border: none;
  }

  .hero__btn--primary {
    background: var(--color-accent);
    color: #1a1a1a;
    box-shadow: 0 4px 20px rgba(201, 169, 97, 0.35);
  }

  .hero__btn--primary:hover {
    background: var(--color-accent-light);
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(201, 169, 97, 0.45);
    text-decoration: none;
  }

  .hero__btn--secondary {
    background: rgba(255, 255, 255, 0.12);
    color: white;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .hero__btn--secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    text-decoration: none;
    color: white;
  }

  .hero__btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Stats */
  .hero__stats {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
    opacity: 0;
    animation: slideUp 0.6s ease-out 0.5s forwards;
  }

  .hero__stat {
    text-align: center;
  }

  .hero__stat-value {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.125rem;
  }

  .hero__stat-number {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
    color: white;
    line-height: 1;
  }

  .hero__stat-suffix {
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    font-weight: 700;
    color: var(--color-accent);
  }

  .hero__stat-label {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.65);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.25rem;
  }

  .hero__stat-divider {
    width: 1px;
    height: 2.5rem;
    background: rgba(255, 255, 255, 0.2);
  }

  /* Trust Badges */
  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    opacity: 0;
    animation: slideUp 0.6s ease-out 0.6s forwards;
  }

  .hero__trust-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .hero__trust-item svg {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* Scroll Indicator */
  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: none;
  }

  .hero__scroll-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, rgba(255,255,255,0.5), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% {
      opacity: 0.5;
      transform: scaleY(1);
    }
    50% {
      opacity: 1;
      transform: scaleY(1.2);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Desktop */
  @media (min-width: 768px) {
    .hero {
      padding: 8rem 0 4rem;
    }

    .hero__rating {
      margin-bottom: 1.5rem;
    }

    .hero__star {
      width: 1.25rem;
      height: 1.25rem;
    }

    .hero__title {
      margin-bottom: 1.25rem;
    }

    .hero__subtitle {
      margin-bottom: 2rem;
    }

    .hero__cta {
      margin-bottom: 2.5rem;
    }

    .hero__btn {
      padding: 1rem 2rem;
      font-size: 1.0625rem;
    }

    .hero__stats {
      gap: 2rem;
      margin-bottom: 2rem;
    }

    .hero__stat-divider {
      height: 3rem;
    }

    .hero__scroll {
      display: block;
    }
  }

  @media (min-width: 1024px) {
    .hero__content {
      max-width: 720px;
    }

    .hero__trust {
      gap: 1rem 2rem;
    }

    .hero__trust-item {
      font-size: 0.875rem;
    }
  }

  /* Small mobile */
  @media (max-width: 480px) {
    .hero {
      padding: 5rem 0 2rem;
      min-height: auto;
    }

    .hero__rating {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.375rem;
      margin-bottom: 1rem;
    }

    .hero__star {
      width: 1rem;
      height: 1rem;
    }

    .hero__rating-text {
      font-size: 0.8125rem;
    }

    .hero__cta {
      flex-direction: column;
    }

    .hero__btn {
      width: 100%;
      padding: 0.875rem 1.5rem;
    }

    .hero__stats {
      gap: 0.75rem;
    }

    .hero__stat-divider {
      height: 2rem;
    }

    .hero__trust {
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hero__rating,
    .hero__title,
    .hero__subtitle,
    .hero__cta,
    .hero__stats,
    .hero__trust {
      opacity: 1;
      animation: none;
    }

    .hero__scroll-line {
      animation: none;
    }
  }
</style>

<script>
  // Counter animation for stats
  function animateCounters() {
    const counters = document.querySelectorAll('[data-count]');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const counter = entry.target as HTMLElement;
          const target = parseInt(counter.dataset.count || '0');
          let current = 0;
          const duration = 1500;
          const increment = target / (duration / 16);

          const updateCounter = () => {
            current += increment;
            if (current < target) {
              counter.textContent = Math.floor(current).toString();
              requestAnimationFrame(updateCounter);
            } else {
              counter.textContent = target.toString();
            }
          };

          // Respect reduced motion preference
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            counter.textContent = target.toString();
          } else {
            updateCounter();
          }

          observer.unobserve(counter);
        }
      });
    }, { threshold: 0.5 });

    counters.forEach(counter => observer.observe(counter));
  }

  document.addEventListener('DOMContentLoaded', animateCounters);
</script>
