---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sorted = projects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<MainLayout
  title="Projekte | Gartenbau Z.M."
  description="Entdecken Sie unsere realisierten Gartenbau-Projekte in Stuttgart, Remseck, Ludwigsburg und der Region. Gartengestaltung, Naturstein, Terrassen und mehr."
>
  <Header />

  <!-- Hero Banner -->
  <section class="bg-forest pt-28 pb-20 md:pt-36 md:pb-28 text-center">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="text-sand/60 text-sm mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-sand transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-sand">Projekte</span>
      </nav>

      <h1 class="font-heading text-4xl md:text-5xl text-white">
        Unsere Projekte
      </h1>
      <p class="text-ivory/80 mt-4 max-w-2xl mx-auto">
        Von der ersten Idee bis zur fertigen Umsetzung — entdecken Sie eine Auswahl unserer realisierten Garten- und Landschaftsbauprojekte.
      </p>
    </div>
  </section>

  <!-- Project Listing -->
  <main class="py-16 md:py-24 bg-ivory">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sorted.map((project, i) => (
          <div class="reveal" style={`transition-delay: ${i * 100}ms`}>
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              category={project.data.category}
              heroImage={project.data.heroImage}
              location={project.data.location}
              href={`/projekte/${project.id}`}
            />
          </div>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</MainLayout>
