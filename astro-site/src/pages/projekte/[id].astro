---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import BeforeAfterSlider from '../../components/gallery/BeforeAfterSlider';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allProjects = await getCollection('projects');
const related = allProjects.filter((p) => p.id !== entry.id).slice(0, 3);

const categoryLabels: Record<string, string> = {
  gartengestaltung: 'Gartengestaltung',
  naturstein: 'Naturstein',
  terrasse: 'Terrasse',
  pflaster: 'Pflaster',
  sichtschutz: 'Sichtschutz',
};

const categoryLabel = categoryLabels[entry.data.category] ?? entry.data.category;
---

<MainLayout
  title={`${entry.data.title} | Gartenbau Z.M.`}
  description={entry.data.description}
  ogImage={entry.data.heroImage}
>
  <Header />

  <!-- Hero Image -->
  <section class="relative pt-16 lg:pt-20">
    <div class="aspect-[21/9] overflow-hidden">
      <img
        src={entry.data.heroImage}
        alt={entry.data.title}
        class="w-full h-full object-cover"
      />
    </div>
    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-forest/80 via-forest/30 to-transparent flex items-end">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-8 md:pb-12 w-full">
        <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-white drop-shadow-lg">
          {entry.data.title}
        </h1>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <div class="bg-ivory-warm border-b border-sand/30">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4">
      <nav class="text-text-muted text-sm" aria-label="Breadcrumb">
        <a href="/" class="hover:text-terracotta transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href="/projekte" class="hover:text-terracotta transition-colors">Projekte</a>
        <span class="mx-2">/</span>
        <span class="text-forest font-medium">{entry.data.title}</span>
      </nav>
    </div>
  </div>

  <!-- Main Content -->
  <main class="py-16 md:py-24 bg-ivory">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

      <!-- Meta Bar -->
      <div class="flex flex-wrap items-center gap-4 mb-8 reveal">
        <span class="bg-forest/10 text-forest text-xs font-medium uppercase tracking-wider px-3 py-1.5 rounded-full">
          {categoryLabel}
        </span>
        <span class="flex items-center gap-1.5 text-text-muted text-sm">
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          {entry.data.location}
        </span>
        {entry.data.duration && (
          <span class="flex items-center gap-1.5 text-text-muted text-sm">
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            {entry.data.duration}
          </span>
        )}
      </div>

      <!-- Description -->
      <p class="text-lg text-text-muted leading-relaxed mb-12 reveal" style="transition-delay: 100ms">
        {entry.data.description}
      </p>

      <!-- Markdown Content -->
      <div class="project-content mb-16 reveal" style="transition-delay: 200ms">
        <Content />
      </div>

      <!-- Before/After Sliders -->
      {entry.data.beforeAfter && entry.data.beforeAfter.length > 0 && (
        <section class="mb-16 reveal" style="transition-delay: 300ms">
          <h2 class="font-heading text-2xl md:text-3xl text-forest mb-8">
            Vorher & Nachher
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {entry.data.beforeAfter.map((ba: { before: string; after: string }, i: number) => (
              <div class="rounded-2xl overflow-hidden shadow-md">
                <BeforeAfterSlider
                  client:visible
                  beforeImage={ba.before}
                  afterImage={ba.after}
                  beforeAlt={`${entry.data.title} — Vorher ${i + 1}`}
                  afterAlt={`${entry.data.title} — Nachher ${i + 1}`}
                />
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Image Gallery -->
      {entry.data.images.length > 0 && (
        <section class="mb-16 reveal" style="transition-delay: 400ms">
          <h2 class="font-heading text-2xl md:text-3xl text-forest mb-8">
            Projektbilder
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            {entry.data.images.map((img: string, i: number) => (
              <div class="rounded-xl overflow-hidden aspect-[4/3]">
                <img
                  src={img}
                  alt={`${entry.data.title} — Bild ${i + 1}`}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </section>
      )}
    </div>

    <!-- Related Projects -->
    {related.length > 0 && (
      <section class="mt-16 md:mt-24 border-t border-sand/30 pt-16 md:pt-24">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-12 reveal">
            <h2 class="font-heading text-3xl md:text-4xl text-forest">
              Weitere Projekte
            </h2>
            <p class="text-text-muted mt-4">
              Entdecken Sie mehr unserer Arbeiten
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {related.map((project, i) => (
              <div class="reveal" style={`transition-delay: ${i * 100}ms`}>
                <ProjectCard
                  title={project.data.title}
                  description={project.data.description}
                  category={project.data.category}
                  heroImage={project.data.heroImage}
                  location={project.data.location}
                  href={`/projekte/${project.id}`}
                />
              </div>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</MainLayout>

<style>
  /* Prose-like styling for markdown content without @tailwindcss/typography */
  .project-content :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--color-forest);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .project-content :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--color-forest);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .project-content :global(p) {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .project-content :global(ul) {
    list-style-type: disc;
  }

  .project-content :global(ol) {
    list-style-type: decimal;
  }

  .project-content :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.75;
  }

  .project-content :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .project-content :global(a) {
    color: var(--color-terracotta);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .project-content :global(a:hover) {
    color: var(--color-terracotta-dark);
  }

  .project-content :global(blockquote) {
    border-left: 3px solid var(--color-sand);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .project-content :global(h2:first-child) {
    margin-top: 0;
  }
</style>
