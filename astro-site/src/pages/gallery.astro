---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GalleryGrid from '../components/GalleryGrid';
import BackgroundPattern from '../components/decorations/BackgroundPattern.astro';

// Generate all 180 image data with proper categorization and titles
const images = Array.from({ length: 180 }, (_, i) => {
  const id = i + 1;

  // Categorize images based on ID ranges with realistic distribution
  let category = 'garden';
  let alt = '';
  let title = '';

  if (id >= 1 && id <= 60) {
    // Garden landscaping projects (1-60)
    category = 'garden';
    const subcategories = [
      'Komplette Gartengestaltung',
      'Neuanlage Garten',
      'Gartenumbau',
      'Bepflanzung',
      'Gartenplanung'
    ];
    const subcategory = subcategories[Math.floor((id - 1) / 12) % subcategories.length];
    alt = `${subcategory} Projekt ${id} - Professioneller Gartenbau in Stuttgart und Remseck am Neckar`;
    title = `${subcategory} #${id}`;
  } else if (id >= 61 && id <= 105) {
    // Natural stone work (61-105)
    category = 'stone';
    const subcategories = [
      'Natursteinmauer',
      'Betonsteinarbeiten',
      'Gabionen',
      'Steintreppen',
      'Steineinfassungen'
    ];
    const subcategory = subcategories[Math.floor((id - 61) / 9) % subcategories.length];
    alt = `${subcategory} Projekt ${id} - Hochwertige Natursteinarbeiten in der Region Stuttgart`;
    title = `${subcategory} #${id}`;
  } else if (id >= 106 && id <= 140) {
    // Terrace construction (106-140)
    category = 'terrace';
    const subcategories = [
      'Holzterrasse',
      'WPC Terrasse',
      'Steinterrasse',
      'Dachterrasse',
      'Terrassenüberdachung'
    ];
    const subcategory = subcategories[Math.floor((id - 106) / 7) % subcategories.length];
    alt = `${subcategory} Projekt ${id} - Moderner Terrassenbau in Ludwigsburg und Waiblingen`;
    title = `${subcategory} #${id}`;
  } else if (id >= 141 && id <= 165) {
    // Paving work (141-165)
    category = 'paving';
    const subcategories = [
      'Einfahrt pflastern',
      'Gartenwege',
      'Hofpflasterung',
      'Parkplatz',
      'Gehwegplatten'
    ];
    const subcategory = subcategories[Math.floor((id - 141) / 5) % subcategories.length];
    alt = `${subcategory} Projekt ${id} - Professionelle Pflasterarbeiten in Stuttgart`;
    title = `${subcategory} #${id}`;
  } else {
    // Privacy screens / fencing (166-180)
    category = 'privacy';
    const subcategories = [
      'Sichtschutz Holz',
      'Sichtschutzzaun',
      'Gabionen Sichtschutz',
      'Bambuszaun',
      'Zaunbau'
    ];
    const subcategory = subcategories[Math.floor((id - 166) / 3) % subcategories.length];
    alt = `${subcategory} Projekt ${id} - Sichtschutz und Zaunbau in Remseck`;
    title = `${subcategory} #${id}`;
  }

  return {
    id,
    src: `/img/image_${id}.webp`,
    alt,
    category,
    title,
    width: 800,
    height: 600
  };
});

// Calculate category counts
const categoryCounts = {
  all: images.length,
  garden: images.filter(img => img.category === 'garden').length,
  stone: images.filter(img => img.category === 'stone').length,
  terrace: images.filter(img => img.category === 'terrace').length,
  paving: images.filter(img => img.category === 'paving').length,
  privacy: images.filter(img => img.category === 'privacy').length
};
---

<MainLayout
  title="Projekt Galerie - 180+ Gartenprojekte | Gartenbau Z.M. Remseck"
  description="Entdecken Sie über 180 erfolgreich abgeschlossene Gartenprojekte in Stuttgart, Remseck, Ludwigsburg & Waiblingen. Gartengestaltung, Naturstein, Terrassen, Pflaster & mehr."
  canonical="https://gartenbauzm.de/gallery"
  ogImage="/img/image_1.webp"
  ogType="website"
>
  <!-- Header -->
  <Header />

  <!-- Gallery Hero Section -->
  <section class="gallery-hero" data-aos="fade-in">
    <BackgroundPattern />
    <div class="gallery-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item">
            <a href="/" class="breadcrumb__link">Home</a>
          </li>
          <li class="breadcrumb__separator">›</li>
          <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">
            Galerie
          </li>
        </ol>
      </nav>

      <h1 class="gallery-hero__title">Unsere Projekte</h1>
      <p class="gallery-hero__subtitle">
        180+ erfolgreiche Gartenprojekte in Stuttgart & Region
      </p>

      <!-- Social Share Buttons -->
      <div class="social-share" data-aos="fade-up" data-aos-delay="200">
        <span class="social-share__label">Teilen:</span>
        <a
          href="https://www.facebook.com/sharer/sharer.php?u=https://gartenbauzm.de/gallery"
          target="_blank"
          rel="noopener noreferrer"
          class="social-share__btn social-share__btn--facebook"
          aria-label="Auf Facebook teilen"
        >
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <a
          href="https://twitter.com/intent/tweet?url=https://gartenbauzm.de/gallery&text=Über%20180%20Gartenprojekte%20von%20Gartenbau%20Z.M."
          target="_blank"
          rel="noopener noreferrer"
          class="social-share__btn social-share__btn--twitter"
          aria-label="Auf Twitter teilen"
        >
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
          </svg>
        </a>
        <a
          href="https://wa.me/?text=Schau%20dir%20diese%20Gartenprojekte%20an:%20https://gartenbauzm.de/gallery"
          target="_blank"
          rel="noopener noreferrer"
          class="social-share__btn social-share__btn--whatsapp"
          aria-label="Per WhatsApp teilen"
        >
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Main Gallery Content -->
  <main>
    <section id="gallery-section" style="padding: var(--space-16) 0; background: var(--bg-primary);">
      <div class="container">
        <!-- Enhanced Filter Section with Sorting -->
        <div class="gallery-controls" data-aos="fade-up">
          <!-- Filter Pills -->
          <div class="gallery-filters">
            <button class="filter-btn active" data-filter="all">
              Alle Projekte ({categoryCounts.all})
            </button>
            <button class="filter-btn" data-filter="garden">
              🌱 Gartengestaltung ({categoryCounts.garden})
            </button>
            <button class="filter-btn" data-filter="stone">
              🪨 Natursteinarbeiten ({categoryCounts.stone})
            </button>
            <button class="filter-btn" data-filter="terrace">
              🏗️ Terrassenbau ({categoryCounts.terrace})
            </button>
            <button class="filter-btn" data-filter="paving">
              🛤️ Pflasterarbeiten ({categoryCounts.paving})
            </button>
            <button class="filter-btn" data-filter="privacy">
              🏡 Sichtschutz ({categoryCounts.privacy})
            </button>
          </div>

          <!-- Sort Dropdown -->
          <div class="gallery-sort">
            <label for="sort-select" class="sort-label">Sortieren:</label>
            <select id="sort-select" class="sort-select" data-sort-select>
              <option value="newest">Neueste zuerst</option>
              <option value="oldest">Älteste zuerst</option>
              <option value="title-asc">Titel A-Z</option>
              <option value="title-desc">Titel Z-A</option>
            </select>
          </div>
        </div>

        <!-- Gallery Grid Component -->
        <div data-aos="fade-up" data-aos-delay="100">
          <GalleryGrid client:load images={images} />
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section" data-aos="fade-up">
      <div class="container">
        <div class="cta-content">
          <h2 class="cta-title">Bereit für Ihr nächstes Projekt?</h2>
          <p class="cta-text">
            Lassen Sie uns gemeinsam Ihren Traumgarten verwirklichen. Kostenlose Beratung vor Ort in Stuttgart und Umgebung.
          </p>
          <div class="cta-buttons">
            <a href="/#Kontakt" class="btn btn-primary">
              Jetzt Kontakt aufnehmen
            </a>
            <a href="https://wa.me/+491782747470" class="btn btn-secondary">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              WhatsApp direkt
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <Footer />
</MainLayout>

<style>
  /* Gallery Hero Section */
  .gallery-hero {
    position: relative;
    background: linear-gradient(135deg, var(--color-primary-700) 0%, var(--color-primary-500) 100%);
    padding: var(--space-24) 0 var(--space-20);
    overflow: hidden;
  }

  .gallery-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top right, rgba(255, 255, 255, 0.1), transparent 70%);
    pointer-events: none;
  }

  .gallery-hero__content {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-6);
    text-align: center;
  }

  /* Breadcrumb Navigation */
  .breadcrumb {
    margin-bottom: var(--space-8);
  }

  .breadcrumb__list {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .breadcrumb__item {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.9);
  }

  .breadcrumb__link {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .breadcrumb__link:hover {
    color: white;
    text-decoration: underline;
  }

  .breadcrumb__separator {
    color: rgba(255, 255, 255, 0.5);
    user-select: none;
  }

  .breadcrumb__item--current {
    font-weight: var(--font-semibold);
  }

  /* Hero Title */
  .gallery-hero__title {
    font-size: var(--text-6xl);
    font-weight: var(--font-extrabold);
    color: white;
    margin-bottom: var(--space-4);
    line-height: 1.1;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
  }

  .gallery-hero__subtitle {
    font-size: var(--text-xl);
    color: rgba(255, 255, 255, 0.95);
    margin-bottom: var(--space-8);
    font-weight: var(--font-medium);
  }

  /* Social Share Buttons */
  .social-share {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .social-share__label {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.9);
    font-weight: var(--font-semibold);
  }

  .social-share__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.2);
    color: white;
    text-decoration: none;
    transition: all var(--transition-base);
    backdrop-filter: blur(10px);
  }

  .social-share__btn:hover {
    background: white;
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .social-share__btn--facebook:hover {
    color: #1877f2;
  }

  .social-share__btn--twitter:hover {
    color: #1da1f2;
  }

  .social-share__btn--whatsapp:hover {
    color: #25d366;
  }

  /* Gallery Controls */
  .gallery-controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }

  .filter-btn {
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    background: white;
    color: var(--text-secondary);
    border: 2px solid var(--color-neutral-200);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-base);
    white-space: nowrap;
  }

  .filter-btn:hover {
    border-color: var(--color-primary-500);
    color: var(--color-primary-700);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .filter-btn.active {
    background: linear-gradient(135deg, var(--color-primary-600), var(--color-primary-500));
    color: white;
    border-color: var(--color-primary-600);
    box-shadow: var(--glow-green);
  }

  /* Sort Dropdown */
  .gallery-sort {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
  }

  .sort-label {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
  }

  .sort-select {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-base);
    border: 2px solid var(--color-neutral-200);
    border-radius: var(--radius-md);
    background: white;
    color: var(--text-primary);
    cursor: pointer;
    transition: all var(--transition-base);
  }

  .sort-select:hover {
    border-color: var(--color-primary-500);
  }

  .sort-select:focus {
    outline: none;
    border-color: var(--color-primary-600);
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.1);
  }

  /* CTA Section */
  .cta-section {
    background: linear-gradient(135deg, var(--color-primary-600) 0%, var(--color-primary-500) 100%);
    padding: var(--space-20) 0;
  }

  .cta-content {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .cta-title {
    font-size: var(--text-4xl);
    font-weight: var(--font-extrabold);
    color: white;
    margin-bottom: var(--space-4);
  }

  .cta-text {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.95);
    margin-bottom: var(--space-8);
    line-height: 1.6;
  }

  .cta-buttons {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-8);
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--transition-base);
    cursor: pointer;
  }

  .btn-primary {
    background: white;
    color: var(--color-primary-700);
    border: 2px solid white;
  }

  .btn-primary:hover {
    background: transparent;
    color: white;
    transform: translateY(-2px);
    box-shadow: var(--shadow-xl);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    border: 2px solid white;
    backdrop-filter: blur(10px);
  }

  .btn-secondary:hover {
    background: white;
    color: var(--color-primary-700);
    transform: translateY(-2px);
    box-shadow: var(--shadow-xl);
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .gallery-hero {
      padding: var(--space-16) 0 var(--space-12);
    }

    .gallery-hero__title {
      font-size: var(--text-4xl);
    }

    .gallery-hero__subtitle {
      font-size: var(--text-lg);
    }

    .social-share {
      margin-top: var(--space-4);
    }

    .gallery-controls {
      gap: var(--space-4);
    }

    .gallery-filters {
      gap: var(--space-2);
    }

    .filter-btn {
      padding: var(--space-2) var(--space-4);
      font-size: var(--text-sm);
    }

    .gallery-sort {
      flex-direction: column;
      gap: var(--space-2);
    }

    .cta-title {
      font-size: var(--text-3xl);
    }

    .cta-text {
      font-size: var(--text-base);
    }

    .cta-buttons {
      flex-direction: column;
      align-items: stretch;
    }

    .btn {
      justify-content: center;
    }
  }
</style>

<script>
  // Sorting functionality for gallery
  document.addEventListener('DOMContentLoaded', () => {
    const sortSelect = document.querySelector('[data-sort-select]') as HTMLSelectElement;

    if (sortSelect) {
      sortSelect.addEventListener('change', (e) => {
        const sortValue = (e.target as HTMLSelectElement).value;

        // Dispatch custom event that GalleryGrid.tsx can listen to
        window.dispatchEvent(new CustomEvent('gallery-sort', {
          detail: { sortValue }
        }));
      });
    }
  });
</script>
