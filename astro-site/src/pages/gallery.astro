---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GalleryGrid from '../components/GalleryGrid';
// Generate all 180 image data with proper categorization and titles
const images = Array.from({ length: 180 }, (_, i) => {
  const id = i + 1;

  // Categorize images based on ID ranges with realistic distribution
  let category = 'garden';
  let alt = '';
  let title = '';

  if (id >= 1 && id <= 60) {
    // Garden landscaping projects (1-60)
    category = 'garden';
    const subcategories = [
      'Komplette Gartengestaltung',
      'Neuanlage Garten',
      'Gartenumbau',
      'Bepflanzung',
      'Gartenplanung'
    ];
    const subcategory = subcategories[Math.floor((id - 1) / 12) % subcategories.length];
    alt = `${subcategory} Projekt ${id} - Professioneller Gartenbau in Stuttgart und Remseck am Neckar`;
    title = `${subcategory} #${id}`;
  } else if (id >= 61 && id <= 105) {
    // Natural stone work (61-105)
    category = 'stone';
    const subcategories = [
      'Natursteinmauer',
      'Betonsteinarbeiten',
      'Gabionen',
      'Steintreppen',
      'Steineinfassungen'
    ];
    const subcategory = subcategories[Math.floor((id - 61) / 9) % subcategories.length];
    alt = `${subcategory} Projekt ${id} - Hochwertige Natursteinarbeiten in der Region Stuttgart`;
    title = `${subcategory} #${id}`;
  } else if (id >= 106 && id <= 140) {
    // Terrace construction (106-140)
    category = 'terrace';
    const subcategories = [
      'Holzterrasse',
      'WPC Terrasse',
      'Steinterrasse',
      'Dachterrasse',
      'Terrassenüberdachung'
    ];
    const subcategory = subcategories[Math.floor((id - 106) / 7) % subcategories.length];
    alt = `${subcategory} Projekt ${id} - Moderner Terrassenbau in Ludwigsburg und Waiblingen`;
    title = `${subcategory} #${id}`;
  } else if (id >= 141 && id <= 165) {
    // Paving work (141-165)
    category = 'paving';
    const subcategories = [
      'Einfahrt pflastern',
      'Gartenwege',
      'Hofpflasterung',
      'Parkplatz',
      'Gehwegplatten'
    ];
    const subcategory = subcategories[Math.floor((id - 141) / 5) % subcategories.length];
    alt = `${subcategory} Projekt ${id} - Professionelle Pflasterarbeiten in Stuttgart`;
    title = `${subcategory} #${id}`;
  } else {
    // Privacy screens / fencing (166-180)
    category = 'privacy';
    const subcategories = [
      'Sichtschutz Holz',
      'Sichtschutzzaun',
      'Gabionen Sichtschutz',
      'Bambuszaun',
      'Zaunbau'
    ];
    const subcategory = subcategories[Math.floor((id - 166) / 3) % subcategories.length];
    alt = `${subcategory} Projekt ${id} - Sichtschutz und Zaunbau in Remseck`;
    title = `${subcategory} #${id}`;
  }

  return {
    id,
    src: `/img/image_${id}.webp`,
    alt,
    category,
    title,
    width: 800,
    height: 600
  };
});

// Calculate category counts
const categoryCounts = {
  all: images.length,
  garden: images.filter(img => img.category === 'garden').length,
  stone: images.filter(img => img.category === 'stone').length,
  terrace: images.filter(img => img.category === 'terrace').length,
  paving: images.filter(img => img.category === 'paving').length,
  privacy: images.filter(img => img.category === 'privacy').length
};
---

<MainLayout
  title="Projekt Galerie - 180+ Gartenprojekte | Gartenbau Z.M. Remseck"
  description="Entdecken Sie über 180 erfolgreich abgeschlossene Gartenprojekte in Stuttgart, Remseck, Ludwigsburg & Waiblingen. Gartengestaltung, Naturstein, Terrassen, Pflaster & mehr."
  canonical="https://gartenbauzm.de/gallery"
  ogImage="/img/image_1.webp"
  ogType="website"
>
  <Header />

  <!-- Hero Banner -->
  <section class="bg-forest pt-28 pb-20 md:pt-36 md:pb-28 text-center">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="text-sand/60 text-sm mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-sand transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-sand">Galerie</span>
      </nav>

      <h1 class="font-heading text-4xl md:text-5xl text-white">
        Unsere Galerie
      </h1>
      <p class="text-ivory/80 mt-4 max-w-2xl mx-auto">
        180+ erfolgreiche Gartenprojekte in Stuttgart & Region
      </p>
    </div>
  </section>

  <!-- Main Gallery Content -->
  <main class="py-16 md:py-24 bg-ivory">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Gallery Controls -->
      <div class="flex flex-col gap-6 mb-10">
        <!-- Filter Pills -->
        <div class="flex flex-wrap gap-3 justify-center">
          <button class="filter-btn active px-5 py-2.5 text-sm font-semibold rounded-full cursor-pointer transition-all whitespace-nowrap bg-forest text-white" data-filter="all">
            Alle Projekte ({categoryCounts.all})
          </button>
          <button class="filter-btn px-5 py-2.5 text-sm font-semibold rounded-full cursor-pointer transition-all whitespace-nowrap bg-ivory-warm text-forest border border-sand hover:bg-sand-light" data-filter="garden">
            Gartengestaltung ({categoryCounts.garden})
          </button>
          <button class="filter-btn px-5 py-2.5 text-sm font-semibold rounded-full cursor-pointer transition-all whitespace-nowrap bg-ivory-warm text-forest border border-sand hover:bg-sand-light" data-filter="stone">
            Natursteinarbeiten ({categoryCounts.stone})
          </button>
          <button class="filter-btn px-5 py-2.5 text-sm font-semibold rounded-full cursor-pointer transition-all whitespace-nowrap bg-ivory-warm text-forest border border-sand hover:bg-sand-light" data-filter="terrace">
            Terrassenbau ({categoryCounts.terrace})
          </button>
          <button class="filter-btn px-5 py-2.5 text-sm font-semibold rounded-full cursor-pointer transition-all whitespace-nowrap bg-ivory-warm text-forest border border-sand hover:bg-sand-light" data-filter="paving">
            Pflasterarbeiten ({categoryCounts.paving})
          </button>
          <button class="filter-btn px-5 py-2.5 text-sm font-semibold rounded-full cursor-pointer transition-all whitespace-nowrap bg-ivory-warm text-forest border border-sand hover:bg-sand-light" data-filter="privacy">
            Sichtschutz ({categoryCounts.privacy})
          </button>
        </div>

        <!-- Sort Dropdown -->
        <div class="flex items-center justify-center gap-3">
          <label for="sort-select" class="text-sm font-semibold text-forest">Sortieren:</label>
          <select id="sort-select" class="px-3 py-2 text-sm border border-sand rounded-lg bg-white text-forest cursor-pointer transition-all hover:border-terracotta focus:outline-none focus:border-terracotta focus:ring-2 focus:ring-terracotta/20" data-sort-select>
            <option value="newest">Neueste zuerst</option>
            <option value="oldest">Älteste zuerst</option>
            <option value="title-asc">Titel A-Z</option>
            <option value="title-desc">Titel Z-A</option>
          </select>
        </div>
      </div>

      <!-- Gallery Grid Component -->
      <GalleryGrid client:load images={images} />
    </div>
  </main>

  <!-- CTA Section -->
  <section class="bg-forest py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-4">
        Bereit für Ihr nächstes Projekt?
      </h2>
      <p class="text-ivory/80 text-lg leading-relaxed mb-8">
        Lassen Sie uns gemeinsam Ihren Traumgarten verwirklichen. Kostenlose Beratung vor Ort in Stuttgart und Umgebung.
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a href="/#Kontakt" class="inline-flex items-center gap-2 bg-terracotta text-white px-8 py-4 rounded-lg font-semibold text-lg transition-all hover:bg-terracotta-dark hover:-translate-y-0.5 hover:shadow-lg">
          Jetzt Kontakt aufnehmen
        </a>
        <a href="https://wa.me/+491782747470" class="inline-flex items-center gap-2 border-2 border-white text-white px-8 py-4 rounded-lg font-semibold text-lg transition-all hover:bg-white hover:text-forest hover:-translate-y-0.5 hover:shadow-lg">
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp direkt
        </a>
      </div>
    </div>
  </section>

  <Footer />
</MainLayout>

<style>
  /* Filter button active state toggling (JS adds/removes .active) */
  .filter-btn.active {
    background-color: var(--color-forest) !important;
    color: white !important;
    border-color: var(--color-forest) !important;
  }
</style>

<script>
  // Sorting functionality for gallery - works with both initial load and View Transitions
  function initGallerySort() {
    const sortSelect = document.querySelector('[data-sort-select]') as HTMLSelectElement;

    if (sortSelect) {
      // Check if listener is already attached using data attribute
      if (sortSelect.dataset.sortInitialized) {
        return;
      }

      const handleSortChange = (e: Event) => {
        const sortValue = (e.target as HTMLSelectElement).value;

        // Dispatch custom event that GalleryGrid.tsx can listen to
        window.dispatchEvent(new CustomEvent('gallery-sort', {
          detail: { sortValue }
        }));
      };

      sortSelect.addEventListener('change', handleSortChange);
      sortSelect.dataset.sortInitialized = 'true';
    }
  }

  // Initialize on both DOMContentLoaded and astro:page-load (for View Transitions)
  document.addEventListener('DOMContentLoaded', initGallerySort);
  document.addEventListener('astro:page-load', initGallerySort);
</script>
