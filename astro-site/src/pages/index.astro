---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSlider from '../components/HeroSlider';
import ServiceCard from '../components/ServiceCard.astro';
import Gallery from '../components/Gallery.astro';
import FAQAccordion from '../components/FAQAccordion';
import FAQSchema from '../components/FAQSchema.astro';
import ContactForm from '../components/ContactForm.astro';
---

<MainLayout
  title="Gartenbau Remseck | Landschaftsbau Stuttgart | Garten Ludwigsburg"
  description="Professioneller Gartenbau in Remseck, Stuttgart, Ludwigsburg & Waiblingen. Gartengestaltung, Terrassen, Natursteinarbeiten. Kostenlose Beratung vor Ort."
>
  <!-- Header -->
  <Header />

  <!-- Hero Slider (React Island) -->
  <HeroSlider client:load />

  <!-- Main Content -->
  <main>
    <!-- Leistungen Section -->
    <section id="Leistungen" style="padding: var(--space-20) 0; background: var(--bg-secondary);">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Unsere Leistungen</h2>
          <p class="section-subtitle">
            Professioneller Gartenbau und Landschaftsbau in Stuttgart & Region
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-6); margin-top: var(--space-12);">
          <ServiceCard
            icon="🌱"
            title="Gartengestaltung"
            description="Professionelle Gartenplanung und -gestaltung mit individueller Beratung. Von der Idee bis zur Umsetzung."
          />

          <ServiceCard
            icon="🪨"
            title="Natursteinarbeiten"
            description="Hochwertige Natur- und Betonsteinarbeiten für Mauern, Treppen, Einfassungen und Gabionen."
          />

          <ServiceCard
            icon="🏗️"
            title="Terrassenbau"
            description="Moderne Terrassengestaltung mit hochwertigen Materialien für Ihr Outdoor-Living-Erlebnis."
          />

          <ServiceCard
            icon="🛤️"
            title="Wege & Zufahrten"
            description="Professionelle Pflasterarbeiten für Einfahrten, Gartenwege, Parkplätze und Hofflächen."
          />

          <ServiceCard
            icon="🏡"
            title="Landschaftsbau"
            description="Kompletter Landschaftsbau Service - von Erdarbeiten über Drainagen bis zur Bepflanzung."
          />

          <ServiceCard
            icon="🌾"
            title="Rollrasen"
            description="Rollrasen-Verlegung für sofort nutzbaren, dichten Rasen inklusive Bodenvorbereitung."
          />

          <ServiceCard
            icon="🧹"
            title="Hausmeisterservice"
            description="Regelmäßige Gartenpflege - Rasenmähen, Heckenschnitt, Unkrautbekämpfung und Laubbeseitigung."
          />

          <ServiceCard
            icon="🌳"
            title="Sichtschutz"
            description="Installation von Sichtschutzzäunen, Hecken und Gabionen für Ihre Privatsphäre."
          />
        </div>
      </div>
    </section>

    <!-- Über uns Section -->
    <section id="Ueber-uns" style="padding: var(--space-20) 0;">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Über uns</h2>
          <p class="section-subtitle">
            Ihr zuverlässiger Partner für Garten- und Landschaftsbau seit Jahren
          </p>
        </div>

        <div style="max-width: 800px; margin: var(--space-12) auto 0; text-align: center;">
          <p style="font-size: var(--text-lg); line-height: var(--leading-relaxed); color: var(--text-secondary); margin-bottom: var(--space-6);">
            Gartenbau Z.M. steht für höchste Qualität und Zuverlässigkeit im Garten- und Landschaftsbau.
            Mit jahrelanger Erfahrung und Leidenschaft für Grün gestalten wir Ihren Traumgarten in
            Remseck am Neckar, Stuttgart, Ludwigsburg und der gesamten Region.
          </p>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-8); margin-top: var(--space-10);">
            <div>
              <div style="font-size: var(--text-4xl); font-weight: var(--font-extrabold); color: var(--color-brand); margin-bottom: var(--space-2);">5.0⭐</div>
              <div style="color: var(--text-secondary);">Google Bewertung</div>
            </div>
            <div>
              <div style="font-size: var(--text-4xl); font-weight: var(--font-extrabold); color: var(--color-brand); margin-bottom: var(--space-2);">180+</div>
              <div style="color: var(--text-secondary);">Projekte</div>
            </div>
            <div>
              <div style="font-size: var(--text-4xl); font-weight: var(--font-extrabold); color: var(--color-brand); margin-bottom: var(--space-2);">100%</div>
              <div style="color: var(--text-secondary);">Zufriedenheit</div>
            </div>
          </div>

          <a href="#Kontakt" class="btn btn-primary" style="margin-top: var(--space-10);">
            🏡 Kostenlose Beratung anfragen
          </a>
        </div>
      </div>
    </section>

    <!-- Projekte Section (Gallery placeholder) -->
    <section id="Projekte" style="padding: var(--space-20) 0; background: var(--bg-secondary);">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Unsere Projekte</h2>
          <p class="section-subtitle">
            Referenzen aus Stuttgart, Ludwigsburg, Waiblingen und Umgebung
          </p>
        </div>

        <div style="margin-top: var(--space-12);">
          <Gallery />
        </div>
      </div>
    </section>

    <!-- FAQ Section with React Island -->
    <section id="FAQ" style="padding: var(--space-20) 0;">
      <!-- FAQPage Schema.org for rich snippets -->
      <FAQSchema />

      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Häufig gestellte Fragen</h2>
          <p class="section-subtitle">
            Alles, was Sie über unsere Gartenbau-Services wissen müssen
          </p>
        </div>

        <div style="margin-top: var(--space-12);">
          <FAQAccordion client:visible />
        </div>
      </div>
    </section>

    <!-- Kontakt Section with Form -->
    <section id="Kontakt" style="padding: var(--space-20) 0; background: var(--bg-secondary);">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Kontakt</h2>
          <p class="section-subtitle">
            Kostenlose Beratung vor Ort - Wir freuen uns auf Ihre Anfrage!
          </p>
        </div>

        <div style="margin-top: var(--space-12);">
          <ContactForm />
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <Footer />
</MainLayout>
