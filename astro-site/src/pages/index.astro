---
/**
 * index.astro - Homepage
 * Premium design with maximum SEO and WCAG 2.1 AA compliance
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

// FAQ Schema for homepage
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet eine Gartengestaltung in Remseck oder Stuttgart?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten für eine Gartengestaltung variieren je nach Größe und Umfang des Projekts. Wir bieten kostenlose Beratung vor Ort und erstellen Ihnen ein transparentes Festpreisangebot ohne versteckte Kosten. Kleinere Projekte starten ab ca. 2.000 EUR, umfangreiche Gartenumgestaltungen können 10.000-50.000 EUR kosten."
      }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert eine Gartenumgestaltung?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Dauer hängt vom Projektumfang ab. Eine einfache Terrassengestaltung kann in 3-5 Tagen abgeschlossen sein, während eine komplette Gartenumgestaltung 2-4 Wochen dauern kann. Wir erstellen einen detaillierten Zeitplan und halten diesen verbindlich ein."
      }
    },
    {
      "@type": "Question",
      "name": "Bieten Sie kostenlose Beratung an?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, wir bieten eine vollkommen kostenlose und unverbindliche Beratung vor Ort an. Dabei besprechen wir Ihre Wünsche, nehmen Maß und erstellen anschließend ein detailliertes Angebot mit Festpreisgarantie."
      }
    },
    {
      "@type": "Question",
      "name": "In welchen Gebieten sind Sie tätig?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wir sind in Remseck am Neckar ansässig und bedienen die gesamte Region Stuttgart: Stuttgart, Ludwigsburg, Waiblingen, Fellbach, Kornwestheim, Esslingen, Böblingen, Backnang, Winnenden, Leonberg, Sindelfingen sowie den gesamten Rems-Murr-Kreis und Landkreis Ludwigsburg."
      }
    },
    {
      "@type": "Question",
      "name": "Welche Garantie geben Sie auf Ihre Arbeiten?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wir gewähren auf alle unsere Arbeiten eine Gewährleistung gemäß BGB. Zusätzlich stehen wir auch nach Projektabschluss für Fragen und Pflegeratschläge zur Verfügung. Kundenzufriedenheit steht bei uns an erster Stelle."
      }
    }
  ]
};

// Services data
const services = [
  {
    title: 'Gartengestaltung',
    description: 'Individuelle Gartenplanung und -gestaltung nach Ihren Wünschen. Von der ersten Idee bis zur fertigen Grünoase.',
    iconImage: '/images/icons/garden-design.png',
    image: '/images/gallery/gal-1.png'
  },
  {
    title: 'Terrassenbau',
    description: 'Hochwertige Terrassen aus Naturstein, Holz oder WPC. Schaffen Sie Ihren persönlichen Outdoor-Wohnraum.',
    iconImage: '/images/icons/terrace.png',
    image: '/images/gallery/gal-2.png'
  },
  {
    title: 'Pflasterarbeiten',
    description: 'Professionelle Pflasterungen für Einfahrten, Wege und Höfe. Langlebig und ästhetisch ansprechend.',
    iconImage: '/images/icons/paving.png',
    image: '/images/gallery/gal-3.png'
  },
  {
    title: 'Natursteinarbeiten',
    description: 'Mauern, Treppen und Einfassungen aus Naturstein. Zeitlose Eleganz für Ihren Außenbereich.',
    iconImage: '/images/icons/stone.png',
    image: '/images/gallery/gal-4.png'
  },
  {
    title: 'Gartenpflege',
    description: 'Regelmäßige Pflege und Wartung Ihres Gartens. Damit Ihr Grün das ganze Jahr über erstrahlt.',
    iconImage: '/images/icons/maintenance.png',
    image: '/images/gallery/gal-5.png'
  },
  {
    title: 'Zaunbau',
    description: 'Zäune und Sichtschutz in verschiedenen Materialien. Sicherheit und Privatsphäre für Ihr Grundstück.',
    iconImage: '/images/icons/fence.png',
    image: '/images/gallery/gal-6.png'
  }
];

// Service areas
const serviceAreas = [
  'Remseck am Neckar', 'Stuttgart', 'Ludwigsburg', 'Waiblingen',
  'Fellbach', 'Kornwestheim', 'Esslingen', 'Böblingen',
  'Backnang', 'Winnenden', 'Leonberg', 'Sindelfingen'
];

// Testimonials
const testimonials = [
  {
    name: 'Michael K.',
    location: 'Stuttgart',
    rating: 5,
    text: 'Hervorragende Arbeit! Das Team war professionell, pünktlich und das Ergebnis übertrifft unsere Erwartungen. Unser Garten ist jetzt eine echte Wohlfühloase.',
    date: '2024-11-15'
  },
  {
    name: 'Sandra M.',
    location: 'Ludwigsburg',
    rating: 5,
    text: 'Sehr kompetente Beratung und super Umsetzung. Die neue Terrasse ist genau so geworden, wie wir es uns vorgestellt haben. Klare Empfehlung!',
    date: '2024-10-22'
  },
  {
    name: 'Thomas W.',
    location: 'Waiblingen',
    rating: 5,
    text: 'Von der ersten Beratung bis zur Fertigstellung alles perfekt. Das Team ist zuverlässig und macht exzellente Arbeit. Wir sind begeistert!',
    date: '2024-09-30'
  }
];
---

<BaseLayout
  title="Gartenbau Z.M. | #1 Garten- und Landschaftsbau Remseck, Stuttgart Region | Seit 10+ Jahren"
  description="Professioneller Gartenbau in Remseck am Neckar & Stuttgart. Gartengestaltung, Terrassen, Naturstein, Pflasterarbeiten. 500+ Projekte, 5.0 Sterne bei Google. Kostenlose Beratung!"
  keywords="Gartenbau Remseck, Landschaftsbau Stuttgart, Gartengestaltung Ludwigsburg, Terrassen bauen Waiblingen, Natursteinarbeiten, Pflasterarbeiten, Gartenpflege, Gartenplaner"
  schemaOrg={[faqSchema]}
  transparentHeader={true}
>
  <!-- Hero Section -->
  <Hero />

  <!-- Trust Bar -->
  <section class="trust-bar" aria-label="Vertrauensleiste">
    <div class="container">
      <div class="trust-bar__inner">
        <div class="trust-item">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          <span>Festpreisgarantie</span>
        </div>
        <div class="trust-item">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>Termingerecht</span>
        </div>
        <div class="trust-item">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span>Kostenlose Beratung</span>
        </div>
        <div class="trust-item">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
          </svg>
          <span>5.0 bei Google</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="section section--gray" id="leistungen" aria-labelledby="services-title">
    <div class="container">
      <header class="section__header">
        <h2 class="section__title" id="services-title">Unsere Leistungen</h2>
        <p class="section__subtitle">
          Vom kleinen Garten bis zum großen Landschaftsprojekt – wir bieten Ihnen
          das komplette Spektrum professioneller Gartengestaltung.
        </p>
      </header>

      <div class="services-grid">
        {services.map((service, index) => (
          <article class="service-card reveal" style={`--delay: ${index * 0.1}s`}>
            <div class="service-card__icon" aria-hidden="true">
              <img 
                src={service.iconImage} 
                alt="" 
                width="64" 
                height="64"
                loading="lazy"
              />
            </div>
            <h3 class="service-card__title">{service.title}</h3>
            <p class="service-card__text">{service.description}</p>
            <a href="/leistungen/" class="service-card__link" aria-label={`Mehr über ${service.title} erfahren`}>
              Mehr erfahren
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </article>
        ))}
      </div>

      <div class="section__cta">
        <a href="/leistungen/" class="btn btn--primary btn--large">
          Alle Leistungen ansehen
        </a>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="section about-section" aria-labelledby="about-title">
    <div class="container">
      <div class="about-grid">
        <div class="about-content reveal">
          <h2 class="about-title" id="about-title">
            Ihr Partner für <span class="text-accent">Traumgärten</span>
          </h2>
          <p class="about-text">
            Seit über 10 Jahren verwandeln wir Außenbereiche in grüne Oasen. Als lokaler Familienbetrieb
            aus Remseck am Neckar kennen wir die Region und ihre Besonderheiten.
          </p>
          <p class="about-text">
            Unser erfahrenes Team vereint handwerkliche Präzision mit kreativer Gartengestaltung.
            Jedes Projekt wird individuell geplant und mit Liebe zum Detail umgesetzt.
          </p>

          <ul class="about-features">
            <li class="about-feature">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span>Über 500 erfolgreich realisierte Projekte</span>
            </li>
            <li class="about-feature">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span>Transparente Festpreise ohne versteckte Kosten</span>
            </li>
            <li class="about-feature">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span>Termingerechte und saubere Ausführung</span>
            </li>
            <li class="about-feature">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span>Persönliche Beratung und Betreuung</span>
            </li>
          </ul>

          <a href="/ueber-uns/" class="btn btn--primary">
            Mehr über uns erfahren
          </a>
        </div>

        <div class="about-image reveal">
          <img
            src="/images/gallery/gal-10.png"
            alt="Professionelle Gartengestaltung durch Gartenbau Z.M."
            loading="lazy"
            width="600"
            height="400"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="section section--dark testimonials-section" aria-labelledby="testimonials-title">
    <div class="container">
      <header class="section__header">
        <h2 class="section__title" id="testimonials-title" style="color: white;">
          Was unsere Kunden sagen
        </h2>
        <p class="section__subtitle">
          Über 47 zufriedene Kunden bewerten uns mit 5.0 Sternen bei Google
        </p>
      </header>

      <div class="testimonials-grid">
        {testimonials.map((testimonial, index) => (
          <article class="testimonial-card reveal" style={`--delay: ${index * 0.1}s`}>
            <div class="testimonial-card__rating" aria-label={`${testimonial.rating} von 5 Sternen`}>
              {Array.from({ length: 5 }).map(() => (
                <svg fill="currentColor" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                </svg>
              ))}
            </div>
            <blockquote class="testimonial-card__text">
              "{testimonial.text}"
            </blockquote>
            <footer class="testimonial-card__author">
              <span class="testimonial-card__name">{testimonial.name}</span>
              <span class="testimonial-card__location">{testimonial.location}</span>
            </footer>
          </article>
        ))}
      </div>

      <div class="section__cta">
        <a
          href="https://g.page/r/CZk_BZnPcSqHEB0/review"
          class="btn btn--outline"
          target="_blank"
          rel="noopener noreferrer"
          style="border-color: white; color: white;"
        >
          Bewertung bei Google abgeben
        </a>
      </div>
    </div>
  </section>

  <!-- Service Areas Section -->
  <section class="section" aria-labelledby="areas-title">
    <div class="container">
      <header class="section__header">
        <h2 class="section__title" id="areas-title">Unser Einzugsgebiet</h2>
        <p class="section__subtitle">
          Wir sind in der gesamten Region Stuttgart für Sie da
        </p>
      </header>

      <div class="areas-grid reveal">
        {serviceAreas.map(area => (
          <span class="area-tag">{area}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section--gray" id="faq" aria-labelledby="faq-title">
    <div class="container">
      <header class="section__header">
        <h2 class="section__title" id="faq-title">Häufige Fragen</h2>
        <p class="section__subtitle">
          Antworten auf die wichtigsten Fragen zu unseren Leistungen
        </p>
      </header>

      <div class="faq-list">
        {faqSchema.mainEntity.map((faq: { name: string; acceptedAnswer: { text: string } }, index: number) => (
          <details class="faq-item reveal" style={`--delay: ${index * 0.05}s`}>
            <summary class="faq-question">
              {faq.name}
              <svg class="faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="faq-answer">
              <p>{faq.acceptedAnswer.text}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section" aria-labelledby="cta-title">
    <div class="container">
      <div class="cta-content reveal">
        <h2 class="cta-title" id="cta-title">
          Bereit für Ihren Traumgarten?
        </h2>
        <p class="cta-text">
          Kontaktieren Sie uns für eine kostenlose und unverbindliche Beratung.
          Wir freuen uns auf Ihr Projekt!
        </p>
        <div class="cta-buttons">
          <a href="/kontakt/" class="btn btn--primary btn--large">
            Kostenloses Angebot anfordern
          </a>
          <a href="tel:+491782747470" class="btn btn--outline btn--large" style="border-color: white; color: white;">
            +49 178 2747470
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Trust Bar */
  .trust-bar {
    background: var(--color-gray-50);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-gray-200);
  }

  .trust-bar__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6) var(--space-10);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-gray-700);
    font-weight: 500;
    font-size: var(--text-sm);
  }

  .trust-item svg {
    color: var(--color-primary);
  }

  /* Services Grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service-card {
    background: white;
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-md);
    transition: all var(--transition-base);
    transition-delay: var(--delay, 0s);
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  .service-card__icon {
    width: 5rem;
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-5);
  }

  .service-card__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .service-card__text {
    color: var(--color-gray-600);
    margin-bottom: var(--space-4);
    line-height: 1.7;
  }

  .service-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-weight: 600;
    color: var(--color-primary);
    font-size: var(--text-sm);
  }

  .service-card__link:hover {
    gap: var(--space-2);
  }

  .section__cta {
    text-align: center;
  }

  /* About Section */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .about-title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-6);
  }

  .text-accent {
    color: var(--color-primary);
  }

  .about-text {
    color: var(--color-gray-600);
    font-size: var(--text-lg);
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }

  .about-features {
    list-style: none;
    margin: var(--space-6) 0;
    padding: 0;
  }

  .about-feature {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    color: var(--color-gray-700);
  }

  .about-feature svg {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .about-image {
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }

  .about-image img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  /* Testimonials */
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  @media (min-width: 768px) {
    .testimonials-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .testimonial-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    transition-delay: var(--delay, 0s);
  }

  .testimonial-card__rating {
    display: flex;
    gap: var(--space-1);
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  .testimonial-card__text {
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--text-base);
    line-height: 1.7;
    margin-bottom: var(--space-4);
    font-style: italic;
  }

  .testimonial-card__author {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .testimonial-card__name {
    color: white;
    font-weight: 600;
  }

  .testimonial-card__location {
    color: rgba(255, 255, 255, 0.7);
    font-size: var(--text-sm);
  }

  /* Service Areas */
  .areas-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .area-tag {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background: var(--color-gray-100);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-gray-700);
    transition: all var(--transition-fast);
  }

  .area-tag:hover {
    background: var(--color-primary);
    color: white;
  }

  /* FAQ Section */
  .faq-list {
    max-width: var(--container-md);
    margin: 0 auto;
  }

  .faq-item {
    background: white;
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-3);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition-delay: var(--delay, 0s);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-5) var(--space-6);
    cursor: pointer;
    font-weight: 600;
    color: var(--color-gray-900);
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    color: var(--color-primary);
  }

  .faq-icon {
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 var(--space-6) var(--space-5);
    color: var(--color-gray-600);
    line-height: 1.7;
  }

  /* CTA Section */
  .cta-section {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    padding: var(--space-20) 0;
    text-align: center;
  }

  .cta-content {
    max-width: var(--container-sm);
    margin: 0 auto;
  }

  .cta-title {
    color: white;
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }

  .cta-text {
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--text-lg);
    margin-bottom: var(--space-8);
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  /* Reveal Animation */
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s ease-out;
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .service-card,
    .testimonial-card,
    .faq-item {
      transition-delay: 0s;
    }
  }
</style>

<script>
  // Scroll Reveal Animation
  function initScrollReveal() {
    const reveals = document.querySelectorAll('.reveal');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    });

    reveals.forEach(reveal => observer.observe(reveal));
  }

  // Initialize on DOM ready
  document.addEventListener('DOMContentLoaded', initScrollReveal);

  // Re-initialize after View Transitions (if using Astro View Transitions)
  document.addEventListener('astro:page-load', initScrollReveal);
</script>
