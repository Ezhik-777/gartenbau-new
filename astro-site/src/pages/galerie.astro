---
/**
 * galerie.astro - Project Gallery Page
 * Showcase of completed landscaping projects
 * SEO optimized with ImageGallery Schema
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';

// Gallery Schema for SEO
const gallerySchema = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": "Gartenbau Z.M. Projektgalerie",
  "description": "Galerie unserer realisierten Gartenprojekte: Gartengestaltung, Terrassenbau, Pflasterarbeiten und Natursteinarbeiten in Stuttgart und Umgebung.",
  "url": "https://gartenbauzm.de/galerie/",
  "provider": {
    "@type": "LandscapingBusiness",
    "name": "Gartenbau Z.M.",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Lerchenrain 9",
      "addressLocality": "Remseck am Neckar",
      "postalCode": "71686",
      "addressCountry": "DE"
    }
  }
};
---

<BaseLayout
  title="Galerie - Unsere Gartenprojekte | Gartenbau Z.M."
  description="Entdecken Sie über 180 realisierte Gartenprojekte: Gartengestaltung, Terrassenbau, Pflasterarbeiten und mehr in Stuttgart, Ludwigsburg und Umgebung. Lassen Sie sich inspirieren!"
  breadcrumbs={[{ name: 'Galerie', url: '/galerie/' }]}
>
  <!-- Gallery Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(gallerySchema)} />

  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <div class="header-badge" data-reveal>
        <span class="badge-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
        </span>
        <span>180+ Projekte</span>
      </div>
      <h1 data-reveal>Unsere Projektgalerie</h1>
      <p class="page-lead" data-reveal>
        Lassen Sie sich von unseren realisierten Gartenprojekten inspirieren.
        Jeder Garten erzählt seine eigene Geschichte - entdecken Sie die Vielfalt
        unserer Arbeit.
      </p>
    </div>
  </section>

  <!-- Gallery Info -->
  <section class="gallery-info section-sm">
    <div class="container">
      <div class="info-cards">
        <div class="info-card" data-reveal>
          <div class="info-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="M9 12l2 2 4-4"/>
            </svg>
          </div>
          <h2>Gartengestaltung</h2>
          <p>Komplette Neuanlagen und Umgestaltungen</p>
        </div>

        <div class="info-card" data-reveal>
          <div class="info-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="6" width="20" height="4" rx="1"/>
              <path d="M4 10v8"/>
              <path d="M20 10v8"/>
            </svg>
          </div>
          <h2>Terrassenbau</h2>
          <p>Holz, WPC und Naturstein Terrassen</p>
        </div>

        <div class="info-card" data-reveal>
          <div class="info-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7"/>
              <rect x="14" y="3" width="7" height="7"/>
              <rect x="14" y="14" width="7" height="7"/>
              <rect x="3" y="14" width="7" height="7"/>
            </svg>
          </div>
          <h2>Pflasterarbeiten</h2>
          <p>Einfahrten, Wege und Hofeinfahrten</p>
        </div>

        <div class="info-card" data-reveal>
          <div class="info-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12,2 22,8.5 22,15.5 12,22 2,15.5 2,8.5"/>
            </svg>
          </div>
          <h2>Natursteinarbeiten</h2>
          <p>Mauern, Treppen und Einfassungen</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="gallery-section section">
    <div class="container">
      <div class="gallery-intro" data-reveal>
        <p>
          <strong>Hinweis:</strong> Klicken Sie auf ein Bild, um es in voller Größe anzusehen.
          Nutzen Sie die Pfeiltasten oder Wischgesten zur Navigation.
        </p>
      </div>
      <Gallery />
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section section">
    <div class="container">
      <div class="cta-content" data-reveal>
        <h2>Ihr Projekt könnte das nächste sein!</h2>
        <p>
          Haben Sie auch ein Gartenprojekt im Sinn? Lassen Sie uns gemeinsam
          Ihren Traumgarten verwirklichen. Kontaktieren Sie uns für eine kostenlose Beratung.
        </p>
        <div class="cta-buttons">
          <a href="/kontakt/" class="btn btn-light btn-lg">
            Jetzt Beratungstermin vereinbaren
          </a>
          <a href="tel:+491782747470" class="btn btn-outline-light btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            +49 178 2747470
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Page Header */
  .page-header {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: white;
    padding: calc(var(--space-24) + 4rem) 0 var(--space-16);
    text-align: center;
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-6);
  }

  .badge-icon {
    display: flex;
  }

  .page-header h1 {
    color: white;
    font-size: var(--text-5xl);
    font-weight: 800;
    margin-bottom: var(--space-6);
  }

  .page-lead {
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--text-xl);
    max-width: var(--container-md);
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Gallery Info Section */
  .section-sm {
    padding: var(--space-12) 0;
  }

  .info-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .info-card {
    background: white;
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    text-align: center;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .info-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  .info-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: white;
    border-radius: var(--radius-lg);
  }

  .info-card h2 {
    font-size: var(--text-lg);
    color: var(--color-gray-900);
    margin-bottom: var(--space-2);
  }

  .info-card p {
    color: var(--color-gray-600);
    font-size: var(--text-sm);
    margin: 0;
  }

  /* Gallery Section */
  .gallery-section {
    background-color: var(--color-gray-50);
  }

  .gallery-intro {
    text-align: center;
    margin-bottom: var(--space-8);
    padding: var(--space-4);
    background: white;
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--color-primary);
  }

  .gallery-intro p {
    color: var(--color-gray-600);
    margin: 0;
  }

  /* CTA Section */
  .cta-section {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: white;
  }

  .cta-content {
    text-align: center;
    max-width: var(--container-md);
    margin: 0 auto;
  }

  .cta-content h2 {
    color: white;
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }

  .cta-content p {
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--text-xl);
    margin-bottom: var(--space-8);
    line-height: 1.7;
  }

  .cta-buttons {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    font-weight: 600;
    font-size: var(--text-base);
    line-height: 1;
    text-decoration: none;
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
    border: 2px solid transparent;
  }

  .btn-lg {
    padding: var(--space-5) var(--space-8);
    font-size: var(--text-lg);
  }

  .btn-light {
    background-color: white;
    color: var(--color-primary);
    border-color: white;
  }

  .btn-light:hover {
    background-color: var(--color-gray-100);
    transform: translateY(-2px);
  }

  .btn-outline-light {
    background-color: transparent;
    color: white;
    border-color: rgba(255, 255, 255, 0.5);
  }

  .btn-outline-light:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: white;
    transform: translateY(-2px);
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Animations */
  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  [data-reveal].revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .info-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .page-header {
      padding: calc(var(--space-20) + 4rem) 0 var(--space-12);
    }

    .page-header h1 {
      font-size: var(--text-4xl);
    }

    .page-lead {
      font-size: var(--text-lg);
    }

    .info-cards {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .cta-content h2 {
      font-size: var(--text-3xl);
    }

    .cta-buttons {
      flex-direction: column;
    }

    .btn-lg {
      width: 100%;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .info-card {
      transition: none;
    }

    .info-card:hover {
      transform: none;
    }
  }
</style>

<script>
  // Scroll reveal animation
  document.addEventListener('DOMContentLoaded', () => {
    const revealElements = document.querySelectorAll('[data-reveal]');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.classList.add('revealed');
          }, index * 100);
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    });

    revealElements.forEach(el => observer.observe(el));
  });
</script>
