---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BeforeAfterSlider from '../components/gallery/BeforeAfterSlider';
---

<MainLayout
  title="Before/After Showcase - Gartenbau Z.M."
  description="Sehen Sie unsere Gartentransformationen im Vorher-Nachher-Vergleich"
>
  <Header />

  <main style="padding: var(--space-20) 0; min-height: 100vh;">
    <section class="container">
      <div class="section-header" style="text-align: center; margin-bottom: var(--space-16);">
        <h1 style="font-size: var(--text-5xl); margin-bottom: var(--space-4); color: var(--color-neutral-900);">
          Unsere Transformationen
        </h1>
        <p style="font-size: var(--text-xl); color: var(--color-neutral-700); max-width: 700px; margin: 0 auto;">
          Entdecken Sie, wie wir Gärten und Außenbereiche verwandeln
        </p>
      </div>

      <div class="showcase-grid" style="display: grid; gap: var(--space-16); max-width: 1200px; margin: 0 auto;">
        <div data-aos="fade-up">
          <BeforeAfterSlider
            client:visible
            beforeImage="/img/image_15.webp"
            afterImage="/img/image_45.webp"
            beforeAlt="Garten vor der Sanierung"
            afterAlt="Garten nach der professionellen Gestaltung"
            title="Garten Komplettsanierung Stuttgart"
          />
        </div>

        <div data-aos="fade-up" data-aos-delay="100">
          <BeforeAfterSlider
            client:visible
            beforeImage="/img/image_30.webp"
            afterImage="/img/image_60.webp"
            beforeAlt="Terrassenbereich vor dem Bau"
            afterAlt="Fertige Terrasse mit Naturstein"
            title="Terrassenbau mit Naturstein"
          />
        </div>

        <div data-aos="fade-up" data-aos-delay="200">
          <BeforeAfterSlider
            client:visible
            beforeImage="/img/image_80.webp"
            afterImage="/img/image_120.webp"
            beforeAlt="Einfahrt vor Pflasterarbeiten"
            afterAlt="Neue gepflasterte Einfahrt"
            title="Pflasterarbeiten Einfahrt"
          />
        </div>

        <div data-aos="fade-up" data-aos-delay="300">
          <BeforeAfterSlider
            client:visible
            beforeImage="/img/image_100.webp"
            afterImage="/img/image_140.webp"
            beforeAlt="Garten ohne Sichtschutz"
            afterAlt="Installierter Sichtschutz"
            title="Sichtschutz Installation"
          />
        </div>

        <div data-aos="fade-up" data-aos-delay="400">
          <BeforeAfterSlider
            client:visible
            beforeImage="/img/image_20.webp"
            afterImage="/img/image_90.webp"
            beforeAlt="Gartenweg vor Natursteinarbeiten"
            afterAlt="Fertiger Gartenweg mit Naturstein"
            title="Natursteinarbeiten Gartenweg"
          />
        </div>
      </div>

      <div style="text-align: center; margin-top: var(--space-16);">
        <a
          href="/gallery"
          class="cta-button"
          style="
            display: inline-block;
            background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-600));
            color: white;
            padding: var(--space-4) var(--space-8);
            border-radius: var(--radius-lg);
            font-size: var(--text-lg);
            font-weight: 600;
            text-decoration: none;
            box-shadow: var(--shadow-lg);
            transition: all var(--transition-base);
          "
        >
          Alle Projekte ansehen →
        </a>
      </div>
    </section>
  </main>

  <Footer />
</MainLayout>

<style>
  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-xl), 0 0 20px rgba(34, 197, 94, 0.3);
  }

  @media (max-width: 768px) {
    .section-header h1 {
      font-size: var(--text-4xl) !important;
    }

    .section-header p {
      font-size: var(--text-lg) !important;
    }
  }
</style>
