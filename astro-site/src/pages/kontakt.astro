---
/**
 * kontakt.astro - Contact Page
 * Contact form, information, and location map
 * WCAG 2.1 AA compliant forms
 */

import BaseLayout from '../layouts/BaseLayout.astro';

// Contact Schema for SEO
const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Kontakt - Gartenbau Z.M.",
  "description": "Kontaktieren Sie Gartenbau Z.M. für professionelle Gartengestaltung in Stuttgart & Umgebung.",
  "url": "https://gartenbauzm.de/kontakt/",
  "mainEntity": {
    "@type": "LandscapingBusiness",
    "name": "Gartenbau Z.M.",
    "telephone": "+491782747470",
    "email": "info.gartenbauzm@gmx.de",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Lerchenrain 9",
      "addressLocality": "Remseck am Neckar",
      "postalCode": "71686",
      "addressCountry": "DE"
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "07:00",
        "closes": "18:00"
      },
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": "Saturday",
        "opens": "08:00",
        "closes": "14:00"
      }
    ]
  }
};
---

<BaseLayout
  title="Kontakt | Gartenbau Z.M. - Kostenlose Beratung anfordern"
  description="Kontaktieren Sie Gartenbau Z.M. für professionelle Gartengestaltung in Stuttgart & Umgebung. Kostenlose Erstberatung, schnelle Antwort, kompetente Fachberatung."
  breadcrumbs={[{ name: 'Kontakt', url: '/kontakt/' }]}
>
  <!-- Contact Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />

  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <div class="header-badge" data-reveal>
        <span class="badge-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72"/>
          </svg>
        </span>
        <span>Wir freuen uns auf Sie</span>
      </div>
      <h1 data-reveal>Kontaktieren Sie uns</h1>
      <p class="page-lead" data-reveal>
        Haben Sie Fragen zu unseren Leistungen oder möchten Sie ein unverbindliches
        Angebot erhalten? Wir sind für Sie da!
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="contact-section section">
    <div class="container">
      <div class="contact-grid">
        <!-- Contact Info -->
        <div class="contact-info" data-reveal>
          <h2>Ihre Kontaktmöglichkeiten</h2>
          <p class="info-description">
            Rufen Sie uns an, schreiben Sie eine E-Mail oder nutzen Sie unser
            Kontaktformular. Wir melden uns schnellstmöglich bei Ihnen zurück.
          </p>

          <div class="info-cards">
            <a href="tel:+491782747470" class="info-card">
              <div class="info-icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </div>
              <div class="info-content">
                <h3>Telefon</h3>
                <p>+49 178 2747470</p>
              </div>
            </a>

            <a href="mailto:info.gartenbauzm@gmx.de" class="info-card">
              <div class="info-icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div class="info-content">
                <h3>E-Mail</h3>
                <p>info.gartenbauzm@gmx.de</p>
              </div>
            </a>

            <a href="https://wa.me/491782747470" target="_blank" rel="noopener noreferrer" class="info-card info-card--whatsapp">
              <div class="info-icon info-icon--whatsapp" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24.000l6.304-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
              </div>
              <div class="info-content">
                <h3>WhatsApp</h3>
                <p>Direkt chatten</p>
              </div>
            </a>
          </div>

          <!-- Address & Hours -->
          <div class="address-card">
            <h3>Adresse & Öffnungszeiten</h3>
            <address>
              <div class="address-row">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
                <span>Lerchenrain 9<br>71686 Remseck am Neckar</span>
              </div>
            </address>
            <div class="hours-grid">
              <div class="hours-row">
                <span class="hours-day">Mo - Fr:</span>
                <span class="hours-time">07:00 - 18:00</span>
              </div>
              <div class="hours-row">
                <span class="hours-day">Samstag:</span>
                <span class="hours-time">08:00 - 14:00</span>
              </div>
              <div class="hours-row">
                <span class="hours-day">Sonntag:</span>
                <span class="hours-time">Geschlossen</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="contact-form-wrapper" data-reveal>
          <h2>Schreiben Sie uns</h2>
          <p class="form-intro">Füllen Sie das Formular aus und wir melden uns innerhalb von 24 Stunden bei Ihnen.</p>

          <form
            action="https://formspree.io/f/xoqznyqb"
            method="POST"
            class="contact-form"
            id="contact-form"
            novalidate
          >
            <div class="form-group">
              <label for="name">
                Name <span class="required" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                aria-required="true"
                autocomplete="name"
                placeholder="Ihr vollständiger Name"
              />
              <span class="error-message" role="alert" aria-live="polite"></span>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="email">
                  E-Mail <span class="required" aria-hidden="true">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  aria-required="true"
                  autocomplete="email"
                  placeholder="ihre@email.de"
                />
                <span class="error-message" role="alert" aria-live="polite"></span>
              </div>

              <div class="form-group">
                <label for="phone">Telefon</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  autocomplete="tel"
                  placeholder="+49 xxx xxxxxxx"
                />
              </div>
            </div>

            <div class="form-group">
              <label for="service">Gewünschte Leistung</label>
              <select id="service" name="service">
                <option value="">Bitte wählen...</option>
                <option value="gartengestaltung">Gartengestaltung</option>
                <option value="terrassenbau">Terrassenbau</option>
                <option value="pflasterarbeiten">Pflasterarbeiten</option>
                <option value="natursteinarbeiten">Natursteinarbeiten</option>
                <option value="gartenpflege">Gartenpflege</option>
                <option value="zaunbau">Zaunbau</option>
                <option value="sonstiges">Sonstiges</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">
                Ihre Nachricht <span class="required" aria-hidden="true">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                aria-required="true"
                placeholder="Beschreiben Sie Ihr Projekt oder stellen Sie Ihre Frage..."
              ></textarea>
              <span class="error-message" role="alert" aria-live="polite"></span>
            </div>

            <div class="form-group form-group--checkbox">
              <input
                type="checkbox"
                id="privacy"
                name="privacy"
                required
                aria-required="true"
              />
              <label for="privacy">
                Ich habe die <a href="/datenschutz/" target="_blank" rel="noopener noreferrer">Datenschutzerklärung</a>
                zur Kenntnis genommen und akzeptiert. <span class="required" aria-hidden="true">*</span>
              </label>
              <span class="error-message" role="alert" aria-live="polite"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg btn-full">
              <span class="btn-text">Nachricht senden</span>
              <span class="btn-loading" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10" stroke-dasharray="31.4" stroke-dashoffset="10"/>
                </svg>
              </span>
            </button>

            <div class="form-status" id="form-status" role="status" aria-live="polite"></div>

            <p class="form-hint">
              <span class="required" aria-hidden="true">*</span> Pflichtfelder
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="map-section" aria-label="Standort auf Google Maps">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2622.8!2d9.273!3d48.8988!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4799d0c3a2f5c5e7%3A0x0!2sLerchenrain%209%2C%2071686%20Remseck%20am%20Neckar!5e0!3m2!1sde!2sde"
      width="100%"
      height="450"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Gartenbau Z.M. Standort - Lerchenrain 9, 71686 Remseck am Neckar"
    ></iframe>
  </section>
</BaseLayout>

<style>
  /* Page Header */
  .page-header {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: white;
    padding: calc(var(--space-24) + 4rem) 0 var(--space-16);
    text-align: center;
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-6);
  }

  .badge-icon {
    display: flex;
  }

  .page-header h1 {
    color: white;
    font-size: var(--text-5xl);
    font-weight: 800;
    margin-bottom: var(--space-6);
  }

  .page-lead {
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--text-xl);
    max-width: var(--container-md);
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Contact Section */
  .contact-section {
    background: var(--color-gray-50);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .contact-info h2,
  .contact-form-wrapper h2 {
    font-size: var(--text-2xl);
    color: var(--color-gray-900);
    margin-bottom: var(--space-4);
  }

  .info-description {
    color: var(--color-gray-600);
    line-height: 1.7;
    margin-bottom: var(--space-6);
  }

  /* Info Cards */
  .info-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .info-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    background: white;
    border-radius: var(--radius-lg);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
  }

  .info-card:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow-md);
  }

  .info-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .info-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary);
    color: white;
    border-radius: var(--radius-lg);
  }

  .info-icon--whatsapp {
    background: #25D366;
  }

  .info-content h3 {
    font-size: var(--text-base);
    color: var(--color-gray-900);
    margin-bottom: 2px;
  }

  .info-content p {
    color: var(--color-gray-600);
    margin: 0;
    font-size: var(--text-sm);
  }

  /* Address Card */
  .address-card {
    background: white;
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
  }

  .address-card h3 {
    font-size: var(--text-lg);
    color: var(--color-gray-900);
    margin-bottom: var(--space-4);
  }

  .address-card address {
    font-style: normal;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-gray-200);
  }

  .address-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    color: var(--color-gray-700);
  }

  .address-row svg {
    flex-shrink: 0;
    color: var(--color-primary);
    margin-top: 2px;
  }

  .hours-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .hours-row {
    display: flex;
    justify-content: space-between;
    color: var(--color-gray-700);
    font-size: var(--text-sm);
  }

  .hours-day {
    font-weight: 600;
  }

  /* Contact Form */
  .contact-form-wrapper {
    background: white;
    padding: var(--space-8);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-lg);
  }

  .form-intro {
    color: var(--color-gray-600);
    margin-bottom: var(--space-6);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .form-group label {
    font-weight: 600;
    color: var(--color-gray-800);
    font-size: var(--text-sm);
  }

  .required {
    color: var(--color-error);
  }

  .form-group input,
  .form-group textarea,
  .form-group select {
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--color-gray-300);
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: var(--text-base);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    background: white;
  }

  .form-group input:focus,
  .form-group textarea:focus,
  .form-group select:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(46, 125, 50, 0.1);
  }

  .form-group input:invalid:not(:placeholder-shown),
  .form-group textarea:invalid:not(:placeholder-shown) {
    border-color: var(--color-error);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-group--checkbox {
    flex-direction: row;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .form-group--checkbox input {
    width: 20px;
    height: 20px;
    margin-top: 2px;
    flex-shrink: 0;
    cursor: pointer;
  }

  .form-group--checkbox label {
    font-weight: 400;
    color: var(--color-gray-700);
    font-size: var(--text-sm);
    line-height: 1.5;
    cursor: pointer;
  }

  .form-group--checkbox label a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .error-message {
    color: var(--color-error);
    font-size: var(--text-sm);
    display: none;
  }

  .error-message:not(:empty) {
    display: block;
  }

  /* Submit Button */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    font-weight: 600;
    font-size: var(--text-base);
    line-height: 1;
    text-decoration: none;
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
    border: none;
    cursor: pointer;
  }

  .btn-lg {
    padding: var(--space-5) var(--space-8);
    font-size: var(--text-lg);
  }

  .btn-full {
    width: 100%;
  }

  .btn-primary {
    background-color: var(--color-primary);
    color: white;
  }

  .btn-primary:hover {
    background-color: var(--color-primary-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .btn-primary:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .btn-primary:disabled {
    background-color: var(--color-gray-400);
    cursor: not-allowed;
    transform: none;
  }

  .btn-loading {
    display: none;
  }

  .btn-loading svg {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .btn.loading .btn-text {
    display: none;
  }

  .btn.loading .btn-loading {
    display: flex;
  }

  /* Form Status */
  .form-status {
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    text-align: center;
    font-weight: 600;
    display: none;
  }

  .form-status:not(:empty) {
    display: block;
  }

  .form-status.success {
    background: #d1fae5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  .form-status.error {
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }

  .form-status.pending {
    background: var(--color-gray-100);
    color: var(--color-gray-700);
  }

  .form-hint {
    font-size: var(--text-sm);
    color: var(--color-gray-500);
    text-align: center;
    margin: 0;
  }

  /* Map Section */
  .map-section {
    height: 450px;
    background: var(--color-gray-200);
  }

  .map-section iframe {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Animations */
  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  [data-reveal].revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
  }

  @media (max-width: 768px) {
    .page-header {
      padding: calc(var(--space-20) + 4rem) 0 var(--space-12);
    }

    .page-header h1 {
      font-size: var(--text-4xl);
    }

    .page-lead {
      font-size: var(--text-lg);
    }

    .contact-form-wrapper {
      padding: var(--space-6);
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .map-section {
      height: 350px;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .info-card {
      transition: none;
    }

    .info-card:hover {
      transform: none;
    }

    .btn-loading svg {
      animation: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Scroll reveal
    const revealElements = document.querySelectorAll('[data-reveal]');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    });
    revealElements.forEach(el => observer.observe(el));

    // Form handling
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const status = document.getElementById('form-status');
    const submitBtn = form?.querySelector('button[type="submit"]');

    if (form && status && submitBtn) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Clear previous status
        status.textContent = '';
        status.className = 'form-status';

        // Validate form
        const name = form.querySelector('#name') as HTMLInputElement;
        const email = form.querySelector('#email') as HTMLInputElement;
        const message = form.querySelector('#message') as HTMLTextAreaElement;
        const privacy = form.querySelector('#privacy') as HTMLInputElement;

        let isValid = true;

        if (!name.value.trim()) {
          setError(name, 'Bitte geben Sie Ihren Namen ein');
          isValid = false;
        } else {
          clearError(name);
        }

        if (!email.value.trim() || !email.validity.valid) {
          setError(email, 'Bitte geben Sie eine gültige E-Mail-Adresse ein');
          isValid = false;
        } else {
          clearError(email);
        }

        if (!message.value.trim()) {
          setError(message, 'Bitte geben Sie eine Nachricht ein');
          isValid = false;
        } else {
          clearError(message);
        }

        if (!privacy.checked) {
          const privacyError = privacy.parentElement?.querySelector('.error-message');
          if (privacyError) {
            privacyError.textContent = 'Bitte akzeptieren Sie die Datenschutzerklärung';
          }
          isValid = false;
        } else {
          const privacyError = privacy.parentElement?.querySelector('.error-message');
          if (privacyError) {
            privacyError.textContent = '';
          }
        }

        if (!isValid) return;

        // Submit form
        submitBtn.classList.add('loading');
        (submitBtn as HTMLButtonElement).disabled = true;
        status.textContent = 'Nachricht wird gesendet...';
        status.className = 'form-status pending';

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: {
              'Accept': 'application/json'
            }
          });

          if (response.ok) {
            status.textContent = 'Vielen Dank! Ihre Nachricht wurde erfolgreich gesendet. Wir melden uns schnellstmöglich bei Ihnen.';
            status.className = 'form-status success';
            form.reset();
          } else {
            throw new Error('Form submission failed');
          }
        } catch (error) {
          status.textContent = 'Es ist ein Fehler aufgetreten. Bitte versuchen Sie es später erneut oder kontaktieren Sie uns telefonisch.';
          status.className = 'form-status error';
        } finally {
          submitBtn.classList.remove('loading');
          (submitBtn as HTMLButtonElement).disabled = false;
        }
      });
    }

    function setError(input: HTMLInputElement | HTMLTextAreaElement, message: string) {
      const errorEl = input.parentElement?.querySelector('.error-message');
      if (errorEl) {
        errorEl.textContent = message;
      }
      input.setAttribute('aria-invalid', 'true');
    }

    function clearError(input: HTMLInputElement | HTMLTextAreaElement) {
      const errorEl = input.parentElement?.querySelector('.error-message');
      if (errorEl) {
        errorEl.textContent = '';
      }
      input.removeAttribute('aria-invalid');
    }
  });
</script>
