й---
/**
 * ueber-uns.astro - About Us Page (Über uns)
 * Company information, values, and team showcase
 * SEO optimized for local search
 */

import BaseLayout from '../layouts/BaseLayout.astro';

// Company values
const values = [
  {
    title: 'Qualität',
    description: 'Wir verwenden nur hochwertige Materialien und arbeiten mit größter Sorgfalt, um langlebige Ergebnisse zu erzielen.',
    icon: 'quality'
  },
  {
    title: 'Zuverlässigkeit',
    description: 'Termingerechte Ausführung und transparente Kommunikation sind für uns selbstverständlich.',
    icon: 'reliability'
  },
  {
    title: 'Nachhaltigkeit',
    description: 'Wir achten auf umweltfreundliche Materialien und nachhaltige Gartenlösungen.',
    icon: 'sustainability'
  },
  {
    title: 'Kundennähe',
    description: 'Ihre Zufriedenheit steht bei uns an erster Stelle. Wir beraten Sie individuell und persönlich.',
    icon: 'customer'
  }
];

// Milestones
const milestones = [
  { year: '2015', title: 'Gründung', description: 'Gründung von Gartenbau Z.M. in Remseck am Neckar' },
  { year: '2017', title: '100 Projekte', description: 'Über 100 erfolgreich realisierte Gartenprojekte' },
  { year: '2020', title: 'Teamwachstum', description: 'Erweiterung des Teams für größere Projekte' },
  { year: '2023', title: '500+ Projekte', description: 'Meilenstein: Über 500 zufriedene Kunden' },
  { year: 'Heute', title: 'Ihr Partner', description: 'Führender Gartenbaupartner in der Region Stuttgart' }
];

// Service areas
const serviceAreas = [
  'Stuttgart', 'Ludwigsburg', 'Remseck am Neckar', 'Fellbach', 'Kornwestheim',
  'Waiblingen', 'Esslingen', 'Backnang', 'Schorndorf', 'Winnenden'
];
---

<BaseLayout
  title="Über uns | Gartenbau Z.M. - Ihr Partner für Gartengestaltung"
  description="Lernen Sie Gartenbau Z.M. kennen: Über 500 realisierte Projekte, jahrelange Erfahrung und ein leidenschaftliches Team für Ihre Gartenträume in Stuttgart & Umgebung."
  breadcrumbs={[{ name: 'Über uns', url: '/ueber-uns/' }]}
>
  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <div class="header-badge" data-reveal>
        <span class="badge-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </span>
        <span>Seit 2015 für Sie da</span>
      </div>
      <h1 data-reveal>Über Gartenbau Z.M.</h1>
      <p class="page-lead" data-reveal>
        Mit Leidenschaft, Fachwissen und über 500 realisierten Projekten gestalten wir
        Ihre grüne Oase in der Region Stuttgart.
      </p>
    </div>
  </section>

  <!-- About Intro -->
  <section class="about-intro section">
    <div class="container">
      <div class="intro-grid">
        <div class="intro-content" data-reveal>
          <span class="section-badge">Unsere Geschichte</span>
          <h2>Vom Traum zur Realität</h2>
          <p>
            Was 2015 als Vision eines leidenschaftlichen Gärtners begann, ist heute ein
            etabliertes Unternehmen für Garten- und Landschaftsbau in der Region Stuttgart.
            Gartenbau Z.M. wurde mit einem klaren Ziel gegründet: Hochwertige Gartengestaltung
            mit persönlicher Beratung und fairen Preisen zu verbinden.
          </p>
          <p>
            Unter der Leitung von Zarko Marinovic haben wir inzwischen über 500 Projekte
            erfolgreich realisiert - von kleinen Hausgärten bis hin zu anspruchsvollen
            Gewerbeprojekten. Jedes Projekt ist für uns eine neue Herausforderung und
            Chance, unsere Expertise unter Beweis zu stellen.
          </p>
          <p>
            Unser Erfolgsrezept? Die Kombination aus handwerklicher Perfektion, kreativer
            Gartenplanung und einem Team, das für seine Arbeit brennt.
          </p>
          <div class="intro-image">
            <img 
              src="/images/gallery/gal-10.png" 
              alt="Gartenbau Z.M. Team bei der Arbeit" 
              width="600" 
              height="400"
              loading="lazy"
              class="rounded-xl shadow-lg"
            />
          </div>
        </div>

        <div class="intro-stats" data-reveal>
          <div class="stat-card">
            <div class="stat-number" data-count="500">500+</div>
            <div class="stat-label">Realisierte Projekte</div>
          </div>
          <div class="stat-card">
            <div class="stat-number" data-count="10">10+</div>
            <div class="stat-label">Jahre Erfahrung</div>
          </div>
          <div class="stat-card">
            <div class="stat-number" data-count="100">100%</div>
            <div class="stat-label">Kundenzufriedenheit</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">4.9</div>
            <div class="stat-label">Google Bewertung</div>
            <div class="stat-stars" aria-label="4.9 von 5 Sternen">
              {Array.from({ length: 5 }).map(() => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="values-section section">
    <div class="container">
      <div class="section-header text-center" data-reveal>
        <span class="section-badge">Was uns ausmacht</span>
        <h2 class="section-title">Unsere Werte</h2>
        <p class="section-subtitle">
          Diese Prinzipien leiten unser Handeln und bilden das Fundament unserer Arbeit
        </p>
      </div>

      <div class="values-grid">
        {values.map((value, index) => (
          <div class="value-card" data-reveal style={`--delay: ${index * 100}ms`}>
            <div class="value-icon" aria-hidden="true">
              {value.icon === 'quality' && (
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              )}
              {value.icon === 'reliability' && (
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
              )}
              {value.icon === 'sustainability' && (
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 22c5.523 0 10-4.477 10-10 0-4.478-2.943-8.268-7-9.542v2.56A8 8 0 1 1 4.998 12H2c0 5.523 4.477 10 10 10z"/>
                  <path d="M15 2.458A10 10 0 0 0 2 12h3a7 7 0 0 1 7-7V2"/>
                  <path d="M15 3v6l4 2"/>
                </svg>
              )}
              {value.icon === 'customer' && (
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              )}
            </div>
            <h3>{value.title}</h3>
            <p>{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Timeline Section -->
  <section class="timeline-section section">
    <div class="container">
      <div class="section-header text-center" data-reveal>
        <span class="section-badge">Unser Weg</span>
        <h2 class="section-title">Meilensteine</h2>
      </div>

      <div class="timeline">
        {milestones.map((milestone, index) => (
          <div class={`timeline-item ${index % 2 === 1 ? 'timeline-item--right' : ''}`} data-reveal>
            <div class="timeline-marker" aria-hidden="true" />
            <div class="timeline-content">
              <span class="timeline-year">{milestone.year}</span>
              <h3>{milestone.title}</h3>
              <p>{milestone.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Service Area Section -->
  <section class="area-section section">
    <div class="container">
      <div class="area-grid">
        <div class="area-content" data-reveal>
          <span class="section-badge">Unser Einzugsgebiet</span>
          <h2>Wir sind für Sie da</h2>
          <p>
            Von unserem Standort in Remseck am Neckar aus bedienen wir die gesamte
            Region Stuttgart und Umgebung. Ob Ludwigsburg, Fellbach, Waiblingen oder
            Esslingen - wir kommen zu Ihnen und verwandeln Ihren Außenbereich in eine
            grüne Wohlfühloase.
          </p>
          <div class="area-tags">
            {serviceAreas.map(area => (
              <span class="area-tag">{area}</span>
            ))}
          </div>
        </div>

        <div class="area-map" data-reveal>
          <div class="map-card">
            <div class="map-icon" aria-hidden="true">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <h3>Unser Standort</h3>
            <address>
              <p><strong>Gartenbau Z.M.</strong></p>
              <p>Lerchenrain 9</p>
              <p>71686 Remseck am Neckar</p>
            </address>
            <a
              href="https://maps.google.com/?q=Lerchenrain+9+71686+Remseck+am+Neckar"
              target="_blank"
              rel="noopener noreferrer"
              class="map-link"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              In Google Maps öffnen
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section section">
    <div class="container">
      <div class="cta-content" data-reveal>
        <h2>Lernen Sie uns kennen!</h2>
        <p>
          Haben Sie ein Gartenprojekt im Sinn? Wir freuen uns darauf, Sie persönlich
          kennenzulernen und Ihre Ideen zu besprechen.
        </p>
        <div class="cta-buttons">
          <a href="/kontakt/" class="btn btn-light btn-lg">
            Kontakt aufnehmen
          </a>
          <a href="/galerie/" class="btn btn-outline-light btn-lg">
            Unsere Projekte ansehen
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Page Header */
  .page-header {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: white;
    padding: calc(var(--space-24) + 4rem) 0 var(--space-16);
    text-align: center;
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-6);
  }

  .badge-icon {
    display: flex;
  }

  .page-header h1 {
    color: white;
    font-size: var(--text-5xl);
    font-weight: 800;
    margin-bottom: var(--space-6);
  }

  .page-lead {
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--text-xl);
    max-width: var(--container-md);
    margin: 0 auto;
    line-height: 1.7;
  }

  /* About Intro */
  .about-intro {
    background: white;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: var(--space-16);
    align-items: start;
  }

  .intro-content h2 {
    font-size: var(--text-3xl);
    color: var(--color-gray-900);
    margin-bottom: var(--space-6);
    margin-top: var(--space-4);
  }

  .intro-content p {
    color: var(--color-gray-700);
    font-size: var(--text-lg);
    line-height: 1.8;
    margin-bottom: var(--space-4);
  }

  .intro-image {
    margin-top: var(--space-8);
  }

  .intro-image img {
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    width: 100%;
    height: auto;
    display: block;
    transition: transform var(--transition-base);
  }

  .intro-image img:hover {
    transform: scale(1.02);
  }

  .intro-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .stat-card {
    background: var(--color-gray-50);
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    text-align: center;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: var(--space-2);
  }

  .stat-label {
    color: var(--color-gray-600);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .stat-stars {
    display: flex;
    justify-content: center;
    gap: 2px;
    margin-top: var(--space-2);
    color: #fbbf24;
  }

  /* Values Section */
  .values-section {
    background: var(--color-gray-50);
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .value-card {
    background: white;
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    text-align: center;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .value-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  .value-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: white;
    border-radius: var(--radius-xl);
  }

  .value-card h3 {
    font-size: var(--text-xl);
    color: var(--color-gray-900);
    margin-bottom: var(--space-3);
  }

  .value-card p {
    color: var(--color-gray-600);
    line-height: 1.7;
    margin: 0;
  }

  /* Timeline Section */
  .timeline-section {
    background: white;
  }

  .timeline {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-8) 0;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-gray-200);
    transform: translateX(-50%);
  }

  .timeline-item {
    position: relative;
    width: 50%;
    padding-right: var(--space-12);
    padding-bottom: var(--space-10);
  }

  .timeline-item--right {
    margin-left: 50%;
    padding-right: 0;
    padding-left: var(--space-12);
  }

  .timeline-marker {
    position: absolute;
    right: -8px;
    top: 0;
    width: 16px;
    height: 16px;
    background: var(--color-primary);
    border: 3px solid white;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md);
  }

  .timeline-item--right .timeline-marker {
    right: auto;
    left: -8px;
  }

  .timeline-content {
    background: var(--color-gray-50);
    padding: var(--space-6);
    border-radius: var(--radius-xl);
  }

  .timeline-year {
    display: inline-block;
    background: var(--color-primary);
    color: white;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }

  .timeline-content h3 {
    font-size: var(--text-lg);
    color: var(--color-gray-900);
    margin-bottom: var(--space-2);
  }

  .timeline-content p {
    color: var(--color-gray-600);
    margin: 0;
    line-height: 1.6;
  }

  /* Area Section */
  .area-section {
    background: var(--color-gray-50);
  }

  .area-grid {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: var(--space-12);
    align-items: center;
  }

  .area-content h2 {
    font-size: var(--text-3xl);
    color: var(--color-gray-900);
    margin-bottom: var(--space-4);
    margin-top: var(--space-4);
  }

  .area-content p {
    color: var(--color-gray-700);
    font-size: var(--text-lg);
    line-height: 1.8;
    margin-bottom: var(--space-6);
  }

  .area-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .area-tag {
    background: white;
    color: var(--color-gray-700);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    box-shadow: var(--shadow-sm);
  }

  .map-card {
    background: white;
    padding: var(--space-8);
    border-radius: var(--radius-2xl);
    text-align: center;
    box-shadow: var(--shadow-lg);
  }

  .map-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: white;
    border-radius: var(--radius-2xl);
  }

  .map-card h3 {
    font-size: var(--text-xl);
    color: var(--color-gray-900);
    margin-bottom: var(--space-4);
  }

  .map-card address {
    font-style: normal;
    color: var(--color-gray-600);
    margin-bottom: var(--space-6);
  }

  .map-card address p {
    margin: 0;
    line-height: 1.6;
  }

  .map-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
    transition: color var(--transition-fast);
  }

  .map-link:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  /* CTA Section */
  .cta-section {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: white;
  }

  .cta-content {
    text-align: center;
    max-width: var(--container-md);
    margin: 0 auto;
  }

  .cta-content h2 {
    color: white;
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }

  .cta-content p {
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--text-xl);
    margin-bottom: var(--space-8);
    line-height: 1.7;
  }

  .cta-buttons {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    font-weight: 600;
    font-size: var(--text-base);
    line-height: 1;
    text-decoration: none;
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
    border: 2px solid transparent;
  }

  .btn-lg {
    padding: var(--space-5) var(--space-8);
    font-size: var(--text-lg);
  }

  .btn-light {
    background-color: white;
    color: var(--color-primary);
    border-color: white;
  }

  .btn-light:hover {
    background-color: var(--color-gray-100);
    transform: translateY(-2px);
  }

  .btn-outline-light {
    background-color: transparent;
    color: white;
    border-color: rgba(255, 255, 255, 0.5);
  }

  .btn-outline-light:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: white;
    transform: translateY(-2px);
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Utility classes */
  .section-badge {
    display: inline-block;
    background: rgba(46, 125, 50, 0.1);
    color: var(--color-primary);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .section-header {
    margin-bottom: var(--space-12);
  }

  .section-title {
    font-size: var(--text-4xl);
    color: var(--color-gray-900);
    margin-top: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .section-subtitle {
    color: var(--color-gray-600);
    font-size: var(--text-xl);
    max-width: 600px;
    margin: 0 auto;
  }

  .text-center {
    text-align: center;
  }

  /* Animations */
  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    transition-delay: var(--delay, 0ms);
  }

  [data-reveal].revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .intro-grid,
    .area-grid {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .page-header {
      padding: calc(var(--space-20) + 4rem) 0 var(--space-12);
    }

    .page-header h1 {
      font-size: var(--text-4xl);
    }

    .page-lead {
      font-size: var(--text-lg);
    }

    .intro-stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .values-grid {
      grid-template-columns: 1fr;
    }

    .timeline::before {
      left: 0;
    }

    .timeline-item,
    .timeline-item--right {
      width: 100%;
      margin-left: 0;
      padding-left: var(--space-10);
      padding-right: 0;
    }

    .timeline-marker,
    .timeline-item--right .timeline-marker {
      left: -8px;
