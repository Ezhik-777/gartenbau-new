---
/**
 * 404.astro - Custom 404 Error Page
 * German-language 404 page with helpful navigation
 */

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Seite nicht gefunden | Gartenbau Z.M."
  description="Die angeforderte Seite wurde nicht gefunden. Kehren Sie zur Startseite zurück oder kontaktieren Sie uns."
  noindex={true}
>
  <section class="error-page">
    <div class="container">
      <div class="error-content">
        <div class="error-icon" aria-hidden="true">
          <svg width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 8v4"/>
            <circle cx="12" cy="16" r="0.5" fill="currentColor"/>
          </svg>
        </div>

        <h1>
          <span class="error-code">404</span>
          Seite nicht gefunden
        </h1>

        <p class="error-description">
          Entschuldigung, die von Ihnen gesuchte Seite existiert nicht oder wurde verschoben.
          Möglicherweise haben Sie einen veralteten Link verwendet oder die Adresse falsch eingegeben.
        </p>

        <div class="error-actions">
          <a href="/" class="btn btn-primary btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            Zur Startseite
          </a>
          <a href="/kontakt/" class="btn btn-outline btn-lg">
            Kontakt aufnehmen
          </a>
        </div>

        <div class="quick-links">
          <h2>Vielleicht suchen Sie:</h2>
          <nav aria-label="Hilfreiche Links">
            <ul>
              <li>
                <a href="/leistungen/">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M9 18l6-6-6-6"/>
                  </svg>
                  Unsere Leistungen
                </a>
              </li>
              <li>
                <a href="/galerie/">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M9 18l6-6-6-6"/>
                  </svg>
                  Projektgalerie
                </a>
              </li>
              <li>
                <a href="/ueber-uns/">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M9 18l6-6-6-6"/>
                  </svg>
                  Über uns
                </a>
              </li>
              <li>
                <a href="/kontakt/">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M9 18l6-6-6-6"/>
                  </svg>
                  Kontakt
                </a>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-page {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--space-24) + 4rem) 0 var(--space-16);
    background: linear-gradient(180deg, var(--color-gray-50) 0%, white 100%);
  }

  .error-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .error-icon {
    color: var(--color-gray-300);
    margin-bottom: var(--space-6);
  }

  .error-code {
    display: block;
    font-family: var(--font-display);
    font-size: 8rem;
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: var(--text-3xl);
    color: var(--color-gray-900);
    margin-bottom: var(--space-6);
  }

  .error-description {
    font-size: var(--text-lg);
    color: var(--color-gray-600);
    line-height: 1.8;
    margin-bottom: var(--space-8);
  }

  .error-actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-12);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    font-weight: 600;
    font-size: var(--text-base);
    line-height: 1;
    text-decoration: none;
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
    border: 2px solid transparent;
  }

  .btn-lg {
    padding: var(--space-5) var(--space-8);
    font-size: var(--text-lg);
  }

  .btn-primary {
    background-color: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  .btn-primary:hover {
    background-color: var(--color-primary-dark);
    border-color: var(--color-primary-dark);
    transform: translateY(-2px);
  }

  .btn-outline {
    background-color: transparent;
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .btn-outline:hover {
    background-color: var(--color-primary);
    color: white;
    transform: translateY(-2px);
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .quick-links {
    background: white;
    padding: var(--space-8);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-lg);
  }

  .quick-links h2 {
    font-size: var(--text-lg);
    color: var(--color-gray-900);
    margin-bottom: var(--space-4);
  }

  .quick-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .quick-links a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    color: var(--color-gray-700);
    text-decoration: none;
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
  }

  .quick-links a:hover {
    background: var(--color-gray-50);
    color: var(--color-primary);
  }

  .quick-links a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .error-code {
      font-size: 5rem;
    }

    h1 {
      font-size: var(--text-2xl);
    }

    .error-actions {
      flex-direction: column;
    }

    .btn-lg {
      width: 100%;
    }

    .quick-links ul {
      grid-template-columns: 1fr;
    }
  }
</style>
