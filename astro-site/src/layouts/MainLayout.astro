---
import '../styles/global.css';
import 'aos/dist/aos.css';
import SEO from '../components/SEO.astro';
import GoogleAnalytics from '../components/analytics/GoogleAnalytics.astro';
import ServiceWorkerRegistration from '../components/ServiceWorkerRegistration.astro';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const { title, description, canonical, ogImage, ogType, noindex } = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, user-scalable=yes">

  <!-- SEO Component with Schema.org -->
  <SEO
    title={title}
    description={description}
    canonical={canonical}
    ogImage={ogImage}
    ogType={ogType}
    noindex={noindex}
  />

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#459d72">
  <link rel="icon" type="image/webp" sizes="32x32" href="/img/logo.webp">

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Google Analytics 4 -->
  <GoogleAnalytics />

  <!-- View Transitions for smooth navigation -->
  <ViewTransitions />

  <!-- Service Worker Registration -->
  <ServiceWorkerRegistration />
</head>

<body>
  <slot />
</body>

<script>
  import AOS from 'aos';

  // Initialize AOS on page load
  document.addEventListener('DOMContentLoaded', () => {
    AOS.init({
      duration: 800,
      easing: 'ease-out-cubic',
      once: true,
      offset: 100,
      disable: window.matchMedia('(prefers-reduced-motion: reduce)').matches
    });
  });

  // Re-initialize AOS after view transitions (Astro's page navigation)
  document.addEventListener('astro:page-load', () => {
    AOS.refresh();
  });
</script>
</html>
