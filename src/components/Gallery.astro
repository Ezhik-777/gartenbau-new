---
// Gallery.astro - Photo gallery with lazy loading island
import GalleryGrid from './GalleryGrid';

// Generate all 180 image data
const images = Array.from({ length: 180 }, (_, i) => {
  const id = i + 1;

  // Categorize images based on ID ranges
  let category = 'garden';
  let alt = '';
  let title = '';

  if (id >= 1 && id <= 60) {
    category = 'garden';
    alt = `Gartengestaltung Projekt ${id} - Gartenbau Z.M. in Remseck und Stuttgart`;
    title = `Gartengestaltung #${id}`;
  } else if (id >= 61 && id <= 105) {
    category = 'stone';
    alt = `Natursteinarbeiten Projekt ${id} - Hochwertige Steinarbeiten in der Region Stuttgart`;
    title = `Natursteinarbeiten #${id}`;
  } else if (id >= 106 && id <= 140) {
    category = 'terrace';
    alt = `Terrassenbau Projekt ${id} - Moderner Terrassenbau in Ludwigsburg und Waiblingen`;
    title = `Terrassenbau #${id}`;
  } else if (id >= 141 && id <= 165) {
    category = 'paving';
    alt = `Pflasterarbeiten Projekt ${id} - Professionelle Pflasterarbeiten in Stuttgart`;
    title = `Pflasterarbeiten #${id}`;
  } else {
    category = 'privacy';
    alt = `Sichtschutz Projekt ${id} - Sichtschutz und Zaunbau in Remseck`;
    title = `Sichtschutz #${id}`;
  }

  return {
    id,
    src: `/img/image_${id}.webp`,
    alt,
    category,
    title,
    width: 800,
    height: 600
  };
});
---

<div class="w-full">
  <!-- Section Header -->
  <div class="text-center mb-12">
    <h2 class="font-heading text-3xl md:text-4xl text-forest mb-3">Unsere Projekte</h2>
    <p class="text-text-muted text-lg max-w-xl mx-auto leading-relaxed">
      Entdecken Sie über 180 erfolgreich abgeschlossene Gartenprojekte in Stuttgart und der Region
    </p>
  </div>

  <!-- Filter buttons -->
  <div class="flex flex-wrap gap-3 mb-10 justify-center">
    <button class="filter-btn active px-5 py-2.5 text-sm font-semibold rounded-full cursor-pointer transition-all whitespace-nowrap bg-forest text-white" data-filter="all">
      Alle Projekte (180)
    </button>
    <button class="filter-btn px-5 py-2.5 text-sm font-semibold rounded-full cursor-pointer transition-all whitespace-nowrap bg-ivory-warm text-forest border border-sand hover:bg-sand-light" data-filter="garden">
      Gartengestaltung (60)
    </button>
    <button class="filter-btn px-5 py-2.5 text-sm font-semibold rounded-full cursor-pointer transition-all whitespace-nowrap bg-ivory-warm text-forest border border-sand hover:bg-sand-light" data-filter="stone">
      Natursteinarbeiten (45)
    </button>
    <button class="filter-btn px-5 py-2.5 text-sm font-semibold rounded-full cursor-pointer transition-all whitespace-nowrap bg-ivory-warm text-forest border border-sand hover:bg-sand-light" data-filter="terrace">
      Terrassenbau (35)
    </button>
    <button class="filter-btn px-5 py-2.5 text-sm font-semibold rounded-full cursor-pointer transition-all whitespace-nowrap bg-ivory-warm text-forest border border-sand hover:bg-sand-light" data-filter="paving">
      Pflasterarbeiten (25)
    </button>
    <button class="filter-btn px-5 py-2.5 text-sm font-semibold rounded-full cursor-pointer transition-all whitespace-nowrap bg-ivory-warm text-forest border border-sand hover:bg-sand-light" data-filter="privacy">
      Sichtschutz (15)
    </button>
  </div>

  <!-- Gallery Grid - React Island for virtual scrolling & lightbox -->
  <GalleryGrid client:visible images={images} />
</div>

<style>
  /* Filter button active state toggling (JS adds/removes .active) */
  .filter-btn.active {
    background-color: var(--color-forest) !important;
    color: white !important;
    border-color: var(--color-forest) !important;
  }
</style>
