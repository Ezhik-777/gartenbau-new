---
// BlogCard.astro v8 — «Werkplan» blog card (Projektblatt-Muster: Spec-Strip + Footer-Link)
interface Props {
  title: string;
  description: string;
  heroImage: string;
  date: Date;
  tags: string[];
  href: string;
}

const { title, description, heroImage, date, tags, href } = Astro.props;

// Format date in German: "DD. MMMM YYYY"
const germanMonths = [
  'Januar', 'Februar', 'März', 'April', 'Mai', 'Juni',
  'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember',
];
const formattedDate = `${date.getDate()}. ${germanMonths[date.getMonth()]} ${date.getFullYear()}`;

// Estimate reading time from description length (rough proxy)
const readingTime = Math.max(Math.ceil(description.length / 200), 1);
---

<a
  href={href}
  class="flex flex-col group h-full bg-white rounded-lg overflow-hidden border border-line transition-all duration-200 hover:border-ink/20 hover:-translate-y-1 hover:shadow-xl hover:shadow-ink/8"
>
  <!-- Image -->
  <div class="aspect-[16/10] overflow-hidden">
    <img
      src={heroImage}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
      loading="lazy"
    />
  </div>

  <!-- Spec strip: date + tag -->
  <div class="flex items-center justify-between gap-3 font-mono text-[0.65rem] uppercase tracking-[0.13em] text-bark border-b border-line px-5 py-2.5">
    <time datetime={date.toISOString().split('T')[0]}>
      {formattedDate}
    </time>
    {tags.length > 0 && <span>{tags[0]}</span>}
  </div>

  <!-- Content -->
  <div class="flex flex-col flex-1 p-5">
    <h3 class="font-display font-bold text-lg text-ink leading-snug" style="font-stretch: 110%;">
      {title}
    </h3>

    <p class="text-bark text-sm leading-relaxed line-clamp-2 mt-2 flex-1">
      {description}
    </p>

    <span class="inline-flex items-center gap-1.5 text-moss text-sm font-semibold mt-4">
      Beitrag lesen
      <span class="inline-block transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
    </span>
  </div>
</a>
