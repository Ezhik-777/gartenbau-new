---
// TrustBar.astro v8.0 — dark facts band, static mono figures
import { business, services } from '../data/business';

const facts = [
  { value: `${business.rating.value} ★`, label: `Google · ${business.rating.count} Rezensionen` },
  { value: `${services.length}`, label: 'Leistungen aus einer Hand' },
  { value: '1', label: 'Ansprechpartner' },
  { value: '0 €', label: 'Erstberatung vor Ort' },
];
---

<section class="bg-pine text-white" aria-label="Gartenbau Z.M. in Zahlen">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 md:py-12">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-8">
      {facts.map(({ value, label }, i) => (
        <div class="reveal flex flex-col gap-1.5" style={`transition-delay: ${i * 70}ms`}>
          <span class="font-display font-extrabold text-3xl md:text-4xl text-marker" style="font-stretch: 115%;">
            {value}
          </span>
          <span class="font-mono text-[0.7rem] uppercase tracking-[0.15em] text-white/60">
            {label}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
