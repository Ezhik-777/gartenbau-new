---
// TrustBar.astro — Stats bar below hero (organic luxury)
---

<section class="bg-ivory-warm py-8 md:py-12" aria-label="Unsere Leistungen in Zahlen">
  <div class="mx-auto max-w-7xl px-4">
    <div class="reveal flex flex-col items-center gap-6 md:flex-row md:justify-center md:gap-16">
      <!-- Stat 1 -->
      <div class="flex flex-col items-center text-center">
        <span class="font-heading text-3xl md:text-4xl text-forest">10+</span>
        <span class="font-body text-sm text-text-muted uppercase tracking-wider mt-1">Jahre Erfahrung</span>
      </div>

      <!-- Divider -->
      <div class="hidden md:block w-px h-12 bg-sand" aria-hidden="true"></div>

      <!-- Stat 2 -->
      <div class="flex flex-col items-center text-center">
        <span class="font-heading text-3xl md:text-4xl text-forest">180+</span>
        <span class="font-body text-sm text-text-muted uppercase tracking-wider mt-1">Projekte</span>
      </div>

      <!-- Divider -->
      <div class="hidden md:block w-px h-12 bg-sand" aria-hidden="true"></div>

      <!-- Stat 3 -->
      <div class="flex flex-col items-center text-center">
        <span class="font-heading text-3xl md:text-4xl text-forest">5.0 ★</span>
        <span class="font-body text-sm text-text-muted uppercase tracking-wider mt-1">Google Bewertung</span>
      </div>
    </div>
  </div>
</section>
