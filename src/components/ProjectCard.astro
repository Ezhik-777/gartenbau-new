---
// ProjectCard.astro — Werkplan «Projektblatt»
interface Props {
  title: string;
  description: string;
  category: string;
  heroImage: string;
  location: string;
  href: string;
  duration?: string;
}

const { title, description, category, heroImage, location, href, duration } = Astro.props;

const categoryLabels: Record<string, string> = {
  gartengestaltung: 'Gartengestaltung',
  naturstein: 'Naturstein',
  terrasse: 'Terrassenbau',
  pflaster: 'Pflasterarbeiten',
  sichtschutz: 'Sichtschutz',
};

const categoryLabel = categoryLabels[category] ?? category;
---

<a
  href={href}
  class="group block bg-white rounded-lg border border-line overflow-hidden transition-all duration-200 hover:border-ink/20 hover:-translate-y-1 hover:shadow-xl hover:shadow-ink/8"
>
  <!-- Foto -->
  <div class="relative aspect-[4/3] overflow-hidden">
    <img
      src={heroImage.replace('/img/', '/img/optimized/').replace('.webp', '-sm.webp')}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
      loading="lazy"
      width="800"
      height="600"
    />
  </div>

  <!-- Spec strip -->
  <div class="flex items-center justify-between gap-3 font-mono text-[0.65rem] uppercase tracking-[0.13em] text-bark border-b border-line px-5 py-2.5">
    <span>{categoryLabel}</span>
    <span>{location}{duration ? ` · ${duration}` : ''}</span>
  </div>

  <!-- Inhalt -->
  <div class="p-5">
    <h3 class="font-display font-bold text-lg text-ink leading-snug" style="font-stretch: 110%;">{title}</h3>
    <p class="text-bark text-sm leading-relaxed mt-2 line-clamp-2">{description}</p>
    <span class="inline-flex items-center gap-1.5 text-moss text-sm font-semibold mt-4">
      Projekt ansehen
      <span class="inline-block transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
    </span>
  </div>
</a>
