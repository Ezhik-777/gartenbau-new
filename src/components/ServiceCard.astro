---
// ServiceCard.astro — Organic luxury service card with SVG icon support
interface Props {
  icon: string;
  title: string;
  description: string;
  href?: string;
}

const { icon, title, description, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  {...(href ? { href } : {})}
  class:list={[
    'group flex flex-col bg-white rounded-2xl p-6 md:p-8 border border-transparent transition-all duration-300 ease-out',
    'hover:border-sand hover:-translate-y-1 hover:shadow-lg hover:shadow-forest/5',
    { 'cursor-pointer no-underline': href },
  ]}
>
  {/* Icon */}
  <div class="flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-forest-light/10 to-forest-light/5 transition-colors duration-300 group-hover:from-terracotta/15 group-hover:to-terracotta/5">
    <Fragment set:html={icon} />
  </div>

  {/* Title */}
  <h3 class="font-heading text-xl text-forest mt-4">{title}</h3>

  {/* Description */}
  <p class="text-text-muted text-sm leading-relaxed mt-2 flex-1">{description}</p>

  {/* Link hint */}
  {href && (
    <span class="inline-flex items-center gap-1 text-terracotta text-sm font-medium mt-4">
      Mehr erfahren
      <span class="inline-block transition-transform duration-300 ease-out group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
    </span>
  )}
</Tag>
