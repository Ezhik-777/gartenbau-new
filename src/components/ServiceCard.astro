---
// ServiceCard.astro v8.0 — «Werkplan»: white card, hairline border, marker hover bar
interface Props {
  icon: string;
  title: string;
  description: string;
  href?: string;
  code?: string;
}

const { icon, title, description, href, code } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  {...(href ? { href } : {})}
  class:list={[
    'group relative flex flex-col bg-white rounded-lg p-6 md:p-7 border border-line overflow-hidden transition-all duration-200 ease-out',
    'hover:border-ink/20 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-ink/5',
    { 'cursor-pointer no-underline': href },
  ]}
>
  {/* Marker hover bar */}
  <span class="absolute left-0 top-0 bottom-0 w-[3px] bg-marker scale-y-0 origin-top transition-transform duration-300 group-hover:scale-y-100" aria-hidden="true"></span>

  <div class="flex items-start justify-between gap-4">
    {/* Icon */}
    <div class="flex h-11 w-11 items-center justify-center rounded-md bg-stone text-pine">
      <Fragment set:html={icon} />
    </div>
    {code && (
      <span class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-bark/70">{code}</span>
    )}
  </div>

  {/* Title */}
  <h3 class="font-display font-bold text-lg text-ink mt-4" style="font-stretch: 110%;">{title}</h3>

  {/* Description */}
  <p class="text-bark text-sm leading-relaxed mt-2 flex-1">{description}</p>

  {/* Link hint */}
  {href && (
    <span class="inline-flex items-center gap-1.5 text-moss text-sm font-semibold mt-4">
      Mehr erfahren
      <span class="inline-block transition-transform duration-200 ease-out group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
    </span>
  )}
</Tag>
