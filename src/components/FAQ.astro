---
// FAQ.astro v8.0 — «Werkplan»: stone ground, mono plus markers
import FAQSchema from './FAQSchema.astro';

const faqs = [
  {
    question: 'Welche Leistungen bieten Sie an?',
    answer: 'Wir bieten professionelle Gartengestaltung, hochwertige Natursteinarbeiten, Terrassenbau, Pflasterarbeiten, Landschaftsbau, Rollrasen-Verlegung, Sichtschutz-Installation und zuverlässigen Hausmeisterservice. Alle Arbeiten führen wir mit höchstem Qualitätsanspruch aus.',
  },
  {
    question: 'In welchen Regionen sind Sie tätig?',
    answer: 'Unser Hauptarbeitsgebiet umfasst Ludwigsburg, Stuttgart, Remseck am Neckar, Waiblingen, Fellbach, Kornwestheim, Esslingen, Leonberg, Böblingen, Sindelfingen und die gesamte Umgebung. Für größere Projekte sind wir auch darüber hinaus in der Region tätig.',
  },
  {
    question: 'Wie läuft eine Beratung ab?',
    answer: 'Wir beginnen mit einer kostenlosen Erstberatung vor Ort. Dabei nehmen wir den Bestand auf, besprechen Ihre Ideen und Wünsche, erstellen ein individuelles Konzept und unterbreiten Ihnen ein detailliertes Angebot. Nach Ihrer Freigabe starten wir mit der Umsetzung.',
  },
  {
    question: 'Wie lange dauert ein typisches Projekt?',
    answer: 'Die Projektdauer variiert je nach Umfang: Kleinere Arbeiten dauern wenige Tage, mittlere Projekte wie Terrassenbau 1-2 Wochen. Komplette Gartenumgestaltungen können 2-4 Wochen in Anspruch nehmen. Bei der Erstberatung geben wir Ihnen eine genaue Zeitplanung.',
  },
  {
    question: 'Bieten Sie eine kostenlose Erstberatung an?',
    answer: 'Ja, selbstverständlich! Unsere Erstberatung ist unverbindlich und kostenlos. Wir kommen zu Ihnen vor Ort, besichtigen Ihr Grundstück und besprechen gemeinsam Ihre Vorstellungen. Kontaktieren Sie uns einfach telefonisch, per WhatsApp oder über unser Kontaktformular.',
  },
  {
    question: 'Welche Materialien verwenden Sie?',
    answer: 'Wir arbeiten mit hochwertigen Materialien: Naturstein (Granit, Sandstein, Muschelkalk), Betonstein, Holz, WPC und Gabionen. Die Materialauswahl erfolgt individuell nach Ihren Wünschen und der vorgesehenen Verwendung. Wir beraten Sie gerne zu den besten Optionen.',
  },
  {
    question: 'Übernehmen Sie auch kleine Projekte?',
    answer: 'Ja, wir übernehmen Projekte jeder Größe — von einzelnen Maßnahmen wie einer Mauer oder einem Beet bis hin zur kompletten Gartengestaltung. Jedes Projekt erhält bei uns die gleiche Sorgfalt und Aufmerksamkeit.',
  },
  {
    question: 'Wie kann ich Sie am besten erreichen?',
    answer: 'Sie erreichen uns auf mehreren Wegen: Telefonisch unter +49 178 2747470, per WhatsApp, per E-Mail oder über unser Kontaktformular auf dieser Website. Wir melden uns in der Regel innerhalb weniger Stunden bei Ihnen zurück.',
  },
  {
    question: 'Gibt es eine Garantie auf Ihre Arbeit?',
    answer: 'Ja, wir gewähren auf alle unsere Arbeiten eine Garantie nach gesetzlichen Vorgaben und stehen darüber hinaus für die Qualität unserer Leistungen ein. Ihre Zufriedenheit hat für uns höchste Priorität.',
  },
  {
    question: 'Was kostet ein Projekt?',
    answer: 'Die Kosten sind individuell und hängen vom Umfang, den Materialien und den örtlichen Gegebenheiten ab. Wir erstellen Ihnen gerne einen kostenlosen, detaillierten Kostenvoranschlag nach der Erstberatung vor Ort — transparent und unverbindlich.',
  },
];
---

<section id="FAQ" class="py-20 md:py-28 bg-stone">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="reveal">
      <p class="eyebrow">FAQ</p>
      <h2 class="font-display font-extrabold uppercase text-3xl md:text-4xl text-ink mt-5" style="font-stretch: 118%;">
        Häufige Fragen
      </h2>
      <p class="text-bark mt-4">
        Antworten zu Ablauf, Kosten und Materialien
      </p>
    </div>

    <div class="mt-12 reveal">
      {faqs.map((faq) => (
        <details class="faq-item border-b border-line group">
          <summary class="font-semibold text-ink text-[1.05rem] py-5 cursor-pointer flex items-center justify-between gap-4 list-none [&::-webkit-details-marker]:hidden">
            <span>{faq.question}</span>
            <span class="faq-icon flex-shrink-0 flex items-center justify-center w-7 h-7 rounded-md border border-line font-mono text-lg leading-none text-moss select-none" aria-hidden="true">+</span>
          </summary>
          <div class="faq-content">
            <div>
              <p class="text-bark leading-relaxed pb-5 pr-2">
                {faq.answer}
              </p>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>

  <FAQSchema />
</section>

<style>
  details .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease-out;
  }

  details[open] .faq-content {
    grid-template-rows: 1fr;
  }

  details .faq-content > div {
    overflow: hidden;
  }

  details summary .faq-icon {
    transition: transform 0.3s ease-out, background-color 0.3s ease-out;
  }

  details[open] summary .faq-icon {
    transform: rotate(45deg);
    background-color: var(--color-marker);
    border-color: var(--color-marker);
    color: var(--color-ink);
  }
</style>
