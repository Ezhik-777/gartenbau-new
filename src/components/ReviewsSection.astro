---
// ReviewsSection.astro v8.0 — dark pine section, marker stars, mono names

const reviews = [
  {
    text: 'Herr M. und sein Team haben unseren Garten komplett umgestaltet. Von der Planung bis zur Ausführung war alles perfekt. Absolute Empfehlung!',
    name: 'Thomas K.',
    time: 'vor 2 Monaten',
  },
  {
    text: 'Wir sind begeistert von unserer neuen Terrasse! Professionelle Arbeit, pünktlich und sauber. Preis-Leistung stimmt.',
    name: 'Sabine W.',
    time: 'vor 3 Monaten',
  },
  {
    text: 'Schnelle und zuverlässige Arbeit bei unserer Einfahrt. Das Pflaster sieht fantastisch aus. Gerne wieder!',
    name: 'Michael R.',
    time: 'vor 1 Monat',
  },
  {
    text: 'Tolle Natursteinmauer und neue Bepflanzung. Herr M. hat super beraten und alles war top organisiert.',
    name: 'Andrea B.',
    time: 'vor 4 Monaten',
  },
];

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Gartenbau Z.M.',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    reviewCount: '47',
    bestRating: '5',
  },
};
---

<section id="Bewertungen" class="py-20 md:py-28 bg-pine text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <div class="reveal">
      <p class="eyebrow eyebrow-light">Referenzen</p>
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mt-5">
        <h2 class="font-display font-extrabold uppercase text-3xl md:text-4xl text-white" style="font-stretch: 118%;">
          Was Kunden sagen
        </h2>
        <p class="font-mono text-[0.75rem] uppercase tracking-[0.15em] text-white/60">
          5,0 ★ &ensp;·&ensp; 47 Bewertungen auf Google
        </p>
      </div>
    </div>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-5">
      {reviews.map((review, i) => (
        <figure
          class="reveal flex flex-col bg-pine-light/60 border border-white/10 rounded-lg p-6"
          style={`transition-delay: ${i * 70}ms`}
        >
          <div class="flex gap-1 text-marker" role="img" aria-label="5 von 5 Sternen">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <blockquote class="text-white/85 leading-relaxed text-[0.95rem] mt-3 flex-1">
            &bdquo;{review.text}&ldquo;
          </blockquote>

          <figcaption class="flex items-baseline justify-between gap-4 mt-5">
            <span class="font-mono text-[0.8rem] text-white">{review.name}</span>
            <span class="font-mono text-[0.7rem] uppercase tracking-[0.1em] text-white/40">{review.time}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="mt-10 reveal">
      <a
        href="https://g.page/r/CZk_BZnPcSqHEB0/review"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 font-medium text-marker transition-colors duration-200 hover:text-white group"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z" />
        </svg>
        Alle Bewertungen auf Google ansehen
        <span class="inline-block transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
</section>
