---
// Hero.astro v7.0 — Enhanced hero with Ken Burns, text reveals, floating botanicals
---

<!-- Preload hero image for LCP performance -->
<link rel="preload" as="image" href="/img/hero-garden.webp" slot="head" />

<section
  class="hero relative min-h-screen flex items-center justify-center overflow-hidden"
  aria-label="Willkommen bei Gartenbau Z.M."
>
  <!-- Ken Burns background image -->
  <div class="hero-bg absolute inset-0" aria-hidden="true"></div>

  <!-- Dark overlay gradient -->
  <div class="absolute inset-0 bg-gradient-to-t from-forest/80 via-forest/40 to-forest/20 z-10"></div>

  <!-- Content -->
  <div class="relative z-20 text-center px-4 sm:px-6 max-w-3xl mx-auto">
    <!-- Eyebrow -->
    <p class="hero-reveal font-body uppercase tracking-widest text-sand text-sm mb-6" style="animation-delay: 0.3s">
      Seit über 10 Jahren
    </p>

    <!-- Main headline -->
    <h1 class="hero-reveal font-heading text-4xl md:text-5xl lg:text-7xl text-white leading-tight" style="animation-delay: 0.6s">
      Ihr Garten.<br>Unsere Leidenschaft.
    </h1>

    <!-- Subtitle -->
    <p class="hero-reveal font-body text-lg md:text-xl text-ivory/80 max-w-xl mx-auto mt-6" style="animation-delay: 0.9s">
      Professioneller Gartenbau und Landschaftsbau in Stuttgart &amp; Region
    </p>

    <!-- CTA button -->
    <div class="hero-reveal mt-8" style="animation-delay: 1.2s">
      <a
        href="/#kontakt"
        class="btn-shimmer inline-block w-full sm:w-auto bg-terracotta hover:bg-terracotta-dark text-white rounded-full px-8 py-4 text-lg font-medium transition-all duration-300 hover:shadow-lg hover:shadow-terracotta/30"
      >
        Kostenlose Beratung
      </a>
    </div>

    <!-- Secondary link -->
    <div class="hero-reveal mt-4" style="animation-delay: 1.4s">
      <a
        href="/projekte"
        class="inline-flex items-center gap-1 text-sand hover:text-white text-sm transition-colors duration-200"
      >
        Unsere Projekte ansehen
        <span class="inline-block transition-transform duration-300 hover:translate-x-1" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>

  <!-- Scroll indicator (line + dot) -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-3" aria-hidden="true">
    <span class="text-xs text-ivory/60 uppercase tracking-widest font-body">Entdecken</span>
    <div class="scroll-line relative w-px h-8 bg-ivory/20 rounded-full overflow-hidden">
      <div class="scroll-dot absolute top-0 left-0 w-full h-3 bg-ivory/70 rounded-full"></div>
    </div>
  </div>
</section>

<style>
  /* Ken Burns background */
  .hero-bg {
    background-image: url('/img/hero-garden.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    animation: kenBurns 20s ease-in-out infinite alternate;
    will-change: transform;
  }

  @keyframes kenBurns {
    0% {
      transform: scale(1);
    }
    100% {
      transform: scale(1.08);
    }
  }

  /* Fallback: keep the original parallax style on desktop for scroll effect */
  .hero {
    background: none;
  }

  /* iOS / mobile: simpler animation */
  @supports (-webkit-touch-callout: none) {
    .hero-bg {
      animation-duration: 25s;
    }
  }

  /* ========== Orchestrated text reveal ========== */
  .hero-reveal {
    opacity: 0;
    transform: translateY(20px);
    animation: heroFadeUp 0.8s ease-out forwards;
  }

  @keyframes heroFadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ========== Scroll indicator (line + dot) ========== */
  .scroll-dot {
    animation: scrollDot 2s ease-in-out infinite;
  }

  @keyframes scrollDot {
    0% {
      top: 0;
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      top: calc(100% - 12px);
      opacity: 0;
    }
  }

  /* ========== Reduced motion ========== */
  @media (prefers-reduced-motion: reduce) {
    .hero-bg {
      animation: none;
      transform: scale(1);
    }
    .hero-reveal {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .hero-float,
    .hero-float-reverse,
    .hero-float-slow {
      animation: none;
    }
    .scroll-dot {
      animation: none;
    }
  }
</style>
