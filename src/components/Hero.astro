---
// Hero.astro v8.0 — «Werkplan»: split layout, expanded caps, marker highlight,
// real project photo with survey corner marks
---

<section
  class="relative bg-paper overflow-hidden"
  aria-label="Willkommen bei Gartenbau Z.M."
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-28 lg:pt-36 pb-14 lg:pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">

      <!-- Left: headline -->
      <div class="lg:col-span-7">
        <h1 class="eyebrow hero-reveal" style="animation-delay: 0.05s">
          Garten- und Landschaftsbau in Remseck, Ludwigsburg &amp; Stuttgart
        </h1>

        <p
          class="hero-reveal font-display font-extrabold uppercase text-ink text-[2.6rem] leading-[1.02] sm:text-6xl lg:text-7xl mt-6"
          style="font-stretch: 118%; letter-spacing: -0.015em; animation-delay: 0.15s"
        >
          Gärten,<br>
          die <mark class="mark-marker mark-marker-animate">bleiben.</mark>
        </p>

        <p class="hero-reveal text-bark text-lg md:text-xl leading-relaxed max-w-xl mt-6" style="animation-delay: 0.3s">
          Terrassen, Naturstein, Pflaster und Rollrasen — geplant und gebaut
          vom Familienbetrieb aus Remseck. Ein Ansprechpartner, ein schriftliches
          Angebot, saubere Übergabe.
        </p>

        <div class="hero-reveal flex flex-col sm:flex-row gap-3 mt-9" style="animation-delay: 0.45s">
          <a href="/#kontakt" class="btn btn-primary">
            Kostenlose Beratung anfragen
          </a>
          <a href="/projekte/" class="btn btn-outline text-ink">
            Projekte ansehen
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- Service areas -->
        <div class="hero-reveal mt-12" style="animation-delay: 0.6s">
          <div class="dim-line"></div>
          <p class="font-mono text-[0.72rem] uppercase tracking-[0.16em] text-bark mt-4">
            Ludwigsburg&ensp;·&ensp;Stuttgart&ensp;·&ensp;Remseck&ensp;·&ensp;Waiblingen&ensp;·&ensp;Fellbach&ensp;·&ensp;Kornwestheim
          </p>
        </div>
      </div>

      <!-- Right: project photo -->
      <div class="lg:col-span-5">
        <figure class="hero-reveal photo-frame" style="animation-delay: 0.35s">
          <img
            src="/img/hero-rasenweg.webp"
            srcset="/img/optimized/hero-rasenweg-sm.webp 640w, /img/hero-rasenweg.webp 1200w"
            sizes="(min-width: 1024px) 40vw, 100vw"
            alt="Fertig angelegter Garten mit Rollrasen, Plattenweg und Sichtschutz — Projekt von Gartenbau Z.M."
            class="w-full aspect-[10/11] object-cover rounded-lg border border-line"
            loading="eager"
            fetchpriority="high"
            width="1200"
            height="1256"
          />
          <figcaption class="flex items-center justify-between font-mono text-[0.7rem] uppercase tracking-[0.14em] text-bark mt-4 px-0.5">
            <span>Rollrasen &amp; Wege</span>
            <span>Privatgarten</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>
