---
// Header.astro v7.0 — Enhanced with transparent→frosted transition, active page, mobile blur
const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent border-b border-transparent"
  data-astro-persist
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">

      <!-- Logo -->
      <a
        href="/"
        class="header-logo font-heading text-lg sm:text-xl tracking-wide hover:tracking-wider transition-all duration-300 hover:opacity-80"
        aria-label="GARTENBAU Z.M. - Zurück zur Startseite"
      >
        GARTENBAU Z.M.
      </a>

      <!-- Desktop Navigation (lg+) -->
      <nav
        class="hidden lg:flex items-center gap-8"
        role="navigation"
        aria-label="Hauptnavigation"
      >
        {[
          { href: '/leistungen', label: 'Leistungen' },
          { href: '/projekte', label: 'Projekte' },
          { href: '/galerie', label: 'Galerie' },
          { href: '/#ueber-uns', label: 'Über uns' },
          { href: '/blog', label: 'Blog' },
          { href: '/#kontakt', label: 'Kontakt' },
        ].map(({ href, label }) => {
          const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href.replace('/#', '/')));
          return (
            <a
              href={href}
              class:list={[
                'nav-link font-body text-sm uppercase tracking-widest transition-colors duration-200 relative group',
                isActive ? 'text-terracotta' : 'text-forest',
              ]}
            >
              {label}
              <span class:list={[
                'absolute -bottom-1 left-0 h-0.5 bg-terracotta transition-all duration-300',
                isActive ? 'w-full' : 'w-0 group-hover:w-full',
              ]}></span>
              {isActive && (
                <span class="absolute -bottom-2.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-terracotta" aria-hidden="true"></span>
              )}
            </a>
          );
        })}
      </nav>

      <!-- Desktop Phone CTA -->
      <a
        href="tel:+491782747470"
        class="hidden lg:inline-flex items-center gap-2 bg-terracotta text-white rounded-full px-6 py-2 text-sm font-medium hover:bg-terracotta-dark transition-all duration-200 hover:shadow-lg hover:shadow-terracotta/30"
        aria-label="Anrufen: +49 178 2747470"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        +49 178 2747470
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="menu-toggle"
        class="lg:hidden relative w-8 h-6 flex flex-col justify-between"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menü öffnen"
      >
        <span class="burger-line block w-full h-0.5 bg-forest rounded-full origin-center transition-all duration-300"></span>
        <span class="burger-line block w-full h-0.5 bg-forest rounded-full origin-center transition-all duration-300"></span>
        <span class="burger-line block w-full h-0.5 bg-forest rounded-full origin-center transition-all duration-300"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 flex flex-col items-center justify-center opacity-0 pointer-events-none transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-label="Mobile Navigation"
>
  <!-- Backdrop with blur -->
  <div class="mobile-backdrop absolute inset-0 bg-forest/95 backdrop-blur-md"></div>

  <!-- Close Button -->
  <button
    id="menu-close"
    class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center text-white/80 hover:text-white transition-colors duration-200 z-10"
    aria-label="Menü schließen"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>

  <!-- Mobile Nav Links -->
  <nav role="navigation" aria-label="Mobile Navigation" class="relative z-10">
    <ul class="flex flex-col items-center gap-6">
      <li>
        <a href="/leistungen" class="mobile-link font-heading text-2xl text-white/90 hover:text-white transition-colors duration-200 opacity-0 translate-y-4">
          Leistungen
        </a>
      </li>
      <li>
        <a href="/projekte" class="mobile-link font-heading text-2xl text-white/90 hover:text-white transition-colors duration-200 opacity-0 translate-y-4">
          Projekte
        </a>
      </li>
      <li>
        <a href="/galerie" class="mobile-link font-heading text-2xl text-white/90 hover:text-white transition-colors duration-200 opacity-0 translate-y-4">
          Galerie
        </a>
      </li>
      <li>
        <a href="/#ueber-uns" class="mobile-link font-heading text-2xl text-white/90 hover:text-white transition-colors duration-200 opacity-0 translate-y-4">
          Über uns
        </a>
      </li>
      <li>
        <a href="/blog" class="mobile-link font-heading text-2xl text-white/90 hover:text-white transition-colors duration-200 opacity-0 translate-y-4">
          Blog
        </a>
      </li>
      <li>
        <a href="/#kontakt" class="mobile-link font-heading text-2xl text-white/90 hover:text-white transition-colors duration-200 opacity-0 translate-y-4">
          Kontakt
        </a>
      </li>
    </ul>
  </nav>

  <!-- Phone CTA at bottom -->
  <a
    href="tel:+491782747470"
    class="mobile-link absolute bottom-12 inline-flex items-center gap-3 text-sand text-lg hover:text-white transition-colors duration-200 opacity-0 translate-y-4 z-10"
    aria-label="Anrufen: +49 178 2747470"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>
    +49 178 2747470
  </a>
</div>

<style>
  /* Hamburger → X animation */
  #menu-toggle[aria-expanded="true"] .burger-line:nth-child(1) {
    transform: translateY(10px) rotate(45deg);
  }
  #menu-toggle[aria-expanded="true"] .burger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #menu-toggle[aria-expanded="true"] .burger-line:nth-child(3) {
    transform: translateY(-10px) rotate(-45deg);
  }

  /* Mobile menu open state */
  #mobile-menu.open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Staggered fade-in for mobile links */
  #mobile-menu.open .mobile-link {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
  }
  #mobile-menu.open li:nth-child(1) .mobile-link { transition-delay: 0.05s; }
  #mobile-menu.open li:nth-child(2) .mobile-link { transition-delay: 0.10s; }
  #mobile-menu.open li:nth-child(3) .mobile-link { transition-delay: 0.15s; }
  #mobile-menu.open li:nth-child(4) .mobile-link { transition-delay: 0.20s; }
  #mobile-menu.open li:nth-child(5) .mobile-link { transition-delay: 0.25s; }
  #mobile-menu.open li:nth-child(6) .mobile-link { transition-delay: 0.30s; }
  /* Phone CTA at bottom gets the last delay */
  #mobile-menu.open > a.mobile-link { transition-delay: 0.38s; }

  /* Desktop nav hover color */
  .nav-link:hover {
    color: var(--color-terracotta);
  }

  /* Header at top — white text on hero */
  #site-header:not(.scrolled) .header-logo {
    color: white;
  }
  #site-header:not(.scrolled) .nav-link {
    color: rgba(255, 255, 255, 0.9);
  }
  #site-header:not(.scrolled) .nav-link:hover {
    color: white;
  }
  #site-header:not(.scrolled) .nav-link span {
    background-color: white;
  }
  #site-header:not(.scrolled) .burger-line {
    background-color: white;
  }

  /* Header scrolled state — frosted glass */
  #site-header.scrolled {
    background-color: rgba(250, 248, 245, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: rgba(212, 197, 169, 0.4);
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.06), 0 1px 2px -1px rgb(0 0 0 / 0.06);
  }
  #site-header.scrolled .header-logo {
    color: var(--color-forest);
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>

<script>
  function initHeader() {
    const headerEl = document.getElementById('site-header');
    const menuToggleEl = document.getElementById('menu-toggle');
    const menuClose = document.getElementById('menu-close');
    const mobileMenuEl = document.getElementById('mobile-menu');

    if (!headerEl || !menuToggleEl || !mobileMenuEl) return;

    const header = headerEl;
    const menuToggle = menuToggleEl;
    const mobileMenu = mobileMenuEl;
    const mobileLinks = mobileMenu.querySelectorAll('a');

    // --- Scroll: transparent → frosted glass ---
    let ticking = false;

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          if (window.scrollY > 50) {
            header.classList.add('scrolled');
          } else {
            header.classList.remove('scrolled');
          }
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    // Run once on load in case the page is already scrolled
    onScroll();

    // --- Mobile menu toggle ---
    function openMenu() {
      menuToggle.setAttribute('aria-expanded', 'true');
      menuToggle.setAttribute('aria-label', 'Menü schließen');
      mobileMenu.classList.add('open');
      mobileMenu.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      menuToggle.setAttribute('aria-expanded', 'false');
      menuToggle.setAttribute('aria-label', 'Menü öffnen');
      mobileMenu.classList.remove('open');
      mobileMenu.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function toggleMenu() {
      const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    menuToggle.addEventListener('click', toggleMenu);
    menuClose?.addEventListener('click', closeMenu);

    // Close on mobile link click
    mobileLinks?.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileMenu.classList.contains('open')) {
        closeMenu();
        menuToggle.focus();
      }
    });

    // Smooth scroll for anchor links on the same page
    document.querySelectorAll('#site-header a[href*="#"], #mobile-menu a[href*="#"]').forEach((anchor) => {
      anchor.addEventListener('click', function (e: Event) {
        const target = e.currentTarget as HTMLAnchorElement;
        const href = target.getAttribute('href');
        if (!href || href === '#') return;

        // Extract the hash part (e.g., "/#kontakt" -> "#kontakt")
        const hashIndex = href.indexOf('#');
        if (hashIndex === -1) return;
        const hash = href.substring(hashIndex);

        // Only smooth scroll if we're already on the homepage
        const pathBeforeHash = href.substring(0, hashIndex);
        const isHomepage = window.location.pathname === '/' || window.location.pathname === '';
        const linksToHomepage = pathBeforeHash === '/' || pathBeforeHash === '';

        if (isHomepage && linksToHomepage) {
          const el = document.querySelector(hash);
          if (el) {
            e.preventDefault();
            el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
        // If not on homepage, let the browser navigate to /#section normally
      });
    });
  }

  // Initialize on first load and on Astro view-transition page loads
  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
