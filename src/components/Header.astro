---
// Header.astro v8.0 — «Werkplan»: paper bar, mono nav, marker accents
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/leistungen/', label: 'Leistungen' },
  { href: '/projekte/', label: 'Projekte' },
  { href: '/galerie/', label: 'Galerie' },
  { href: '/einsatzgebiet/', label: 'Einsatzgebiet' },
  { href: '/#ueber-uns', label: 'Über uns' },
  { href: '/blog/', label: 'Blog' },
  { href: '/#kontakt', label: 'Kontakt' },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 bg-paper/92 backdrop-blur-md border-b border-line transition-shadow duration-300"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-[76px]">

      <!-- Logo -->
      <a
        href="/"
        class="flex items-center gap-2.5 group"
        aria-label="GARTENBAU Z.M. — Zurück zur Startseite"
      >
        <span class="block w-2.5 h-2.5 bg-marker transition-transform duration-300 group-hover:rotate-90" aria-hidden="true"></span>
        <span class="font-display font-extrabold text-ink text-base sm:text-lg tracking-tight uppercase" style="font-stretch: 118%;">
          Gartenbau&nbsp;Z.M.
        </span>
      </a>

      <!-- Desktop Navigation (lg+) -->
      <nav
        class="hidden lg:flex items-center gap-7"
        role="navigation"
        aria-label="Hauptnavigation"
      >
        {navItems.map(({ href, label }) => {
          const isActive = currentPath === href || (href !== '/' && !href.includes('#') && currentPath.startsWith(href));
          return (
            <a
              href={href}
              class:list={[
                'relative font-mono text-[0.78rem] uppercase tracking-[0.14em] py-1 transition-colors duration-200',
                isActive ? 'text-ink' : 'text-bark hover:text-ink',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {label}
              <span class:list={[
                'absolute -bottom-0.5 left-0 h-[2px] bg-marker transition-all duration-300',
                isActive ? 'w-full' : 'w-0 group-hover:w-full',
              ]}></span>
            </a>
          );
        })}
      </nav>

      <!-- Desktop Phone CTA -->
      <a
        href="tel:+491782747470"
        class="btn btn-primary btn-sm hidden lg:inline-flex"
        aria-label="Anrufen: +49 178 2747470"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        +49 178 2747470
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="menu-toggle"
        class="lg:hidden relative w-8 h-6 flex flex-col justify-between"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menü öffnen"
      >
        <span class="burger-line block w-full h-0.5 bg-ink origin-center transition-all duration-300"></span>
        <span class="burger-line block w-full h-0.5 bg-ink origin-center transition-all duration-300"></span>
        <span class="burger-line block w-full h-0.5 bg-ink origin-center transition-all duration-300"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 flex flex-col justify-between opacity-0 pointer-events-none transition-opacity duration-300 bg-pine"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-label="Mobile Navigation"
>
  <!-- Close Button -->
  <button
    id="menu-close"
    class="absolute top-4 right-4 w-11 h-11 flex items-center justify-center text-white/80 hover:text-white transition-colors duration-200 z-10"
    aria-label="Menü schließen"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>

  <!-- Mobile Nav Links -->
  <nav role="navigation" aria-label="Mobile Navigation" class="relative z-10 px-8 pt-28">
    <ul class="flex flex-col gap-1">
      {navItems.map(({ href, label }, i) => (
        <li>
          <a
            href={href}
            class="mobile-link group flex items-baseline gap-4 py-3 opacity-0 translate-y-4"
            style={`transition-delay: ${0.05 + i * 0.05}s`}
          >
            <span class="font-mono text-marker text-xs" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-display font-bold uppercase text-2xl text-white/90 group-hover:text-white transition-colors duration-200" style="font-stretch: 115%;">
              {label}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Bottom: phone + hours -->
  <div class="relative z-10 px-8 pb-10 space-y-4">
    <div class="dim-line dim-line-light"></div>
    <a
      href="tel:+491782747470"
      class="mobile-link inline-flex items-center gap-3 font-mono text-sm text-white/80 hover:text-marker transition-colors duration-200 opacity-0 translate-y-4"
      style="transition-delay: 0.4s"
      aria-label="Anrufen: +49 178 2747470"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      +49 178 2747470
    </a>
    <p class="mobile-link font-mono text-xs text-white/50 uppercase tracking-[0.14em] opacity-0 translate-y-4" style="transition-delay: 0.45s">
      Mo–Fr 08–18 Uhr · Sa 09–14 Uhr
    </p>
  </div>
</div>

<style>
  /* Hamburger → X animation */
  #menu-toggle[aria-expanded="true"] .burger-line:nth-child(1) {
    transform: translateY(10px) rotate(45deg);
  }
  #menu-toggle[aria-expanded="true"] .burger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #menu-toggle[aria-expanded="true"] .burger-line:nth-child(3) {
    transform: translateY(-10px) rotate(-45deg);
  }

  /* Mobile menu open state */
  #mobile-menu.open {
    opacity: 1;
    pointer-events: auto;
  }
  #mobile-menu.open .mobile-link {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out, color 0.2s;
  }

  /* Subtle shadow once scrolled */
  #site-header.scrolled {
    box-shadow: 0 1px 3px 0 rgb(20 32 26 / 0.06), 0 4px 12px -4px rgb(20 32 26 / 0.06);
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>

<script>
  function initHeader() {
    const headerEl = document.getElementById('site-header');
    const menuToggleEl = document.getElementById('menu-toggle');
    const menuClose = document.getElementById('menu-close');
    const mobileMenuEl = document.getElementById('mobile-menu');

    if (!headerEl || !menuToggleEl || !mobileMenuEl) return;

    const header = headerEl;
    const menuToggle = menuToggleEl;
    const mobileMenu = mobileMenuEl;
    const mobileLinks = mobileMenu.querySelectorAll('a');

    // --- Scroll: add shadow ---
    let ticking = false;

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          if (window.scrollY > 8) {
            header.classList.add('scrolled');
          } else {
            header.classList.remove('scrolled');
          }
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // --- Mobile menu toggle ---
    function openMenu() {
      menuToggle.setAttribute('aria-expanded', 'true');
      menuToggle.setAttribute('aria-label', 'Menü schließen');
      mobileMenu.classList.add('open');
      mobileMenu.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      menuToggle.setAttribute('aria-expanded', 'false');
      menuToggle.setAttribute('aria-label', 'Menü öffnen');
      mobileMenu.classList.remove('open');
      mobileMenu.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function toggleMenu() {
      const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    menuToggle.addEventListener('click', toggleMenu);
    menuClose?.addEventListener('click', closeMenu);

    mobileLinks?.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileMenu.classList.contains('open')) {
        closeMenu();
        menuToggle.focus();
      }
    });

    // Smooth scroll for same-page anchor links
    document.querySelectorAll('#site-header a[href*="#"], #mobile-menu a[href*="#"]').forEach((anchor) => {
      anchor.addEventListener('click', function (e: Event) {
        const target = e.currentTarget as HTMLAnchorElement;
        const href = target.getAttribute('href');
        if (!href || href === '#') return;

        const hashIndex = href.indexOf('#');
        if (hashIndex === -1) return;
        const hash = href.substring(hashIndex);

        const pathBeforeHash = href.substring(0, hashIndex);
        const isHomepage = window.location.pathname === '/' || window.location.pathname === '';
        const linksToHomepage = pathBeforeHash === '/' || pathBeforeHash === '';

        if (isHomepage && linksToHomepage) {
          const el = document.querySelector(hash);
          if (el) {
            e.preventDefault();
            el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
