---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { serviceArea } from '../../data/business';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Terrassenbau",
  "description": "Professioneller Terrassenbau in Ludwigsburg, Stuttgart & Region. Holz, WPC & Naturstein-Terrassen. Planung & Umsetzung aus einer Hand.",
  "provider": { "@id": "https://gartenbauzm.de/#business" },
  "areaServed": serviceArea
};

const faqs = [
  { question: "Welches Material eignet sich am besten für eine Terrasse?", answer: "Die Materialwahl hängt von Ihren Anforderungen ab. Naturstein wie Granit oder Travertin ist extrem langlebig und pflegeleicht. WPC (Wood-Plastic-Composite) bietet eine Holzoptik ohne den Pflegeaufwand von Echtholz. Echtholz wie Bangkirai oder Lärche überzeugt durch natürliche Wärme und Haptik, benötigt jedoch regelmäßige Pflege. Wir beraten Sie gerne zu den Vor- und Nachteilen." },
  { question: "Was kostet eine neue Terrasse pro Quadratmeter?", answer: "Der Preis hängt von Fläche, Material, Unterbau und Zugänglichkeit des Grundstücks ab. Pauschalpreise wären deshalb unseriös: Nach dem kostenlosen Aufmaß vor Ort erhalten Sie ein schriftliches Angebot mit allen Positionen." },
  { question: "Wie wird die Entwässerung der Terrasse sichergestellt?", answer: "Eine fachgerechte Entwässerung ist entscheidend für die Langlebigkeit Ihrer Terrasse. Wir legen ein Gefälle von mindestens zwei Prozent vom Haus weg an und installieren bei Bedarf Entwässerungsrinnen oder Drainagesysteme. So wird Staunässe vermieden und die Bausubstanz Ihres Hauses geschützt." },
  { question: "Wie lange dauert der Bau einer Terrasse?", answer: "Eine Standard-Terrasse von 20 bis 30 Quadratmetern realisieren wir in der Regel innerhalb von drei bis fünf Arbeitstagen, inklusive Erdarbeiten und Unterbau. Größere Projekte mit aufwendigem Unterbau oder Hanglagen können bis zu zwei Wochen dauern. Den genauen Zeitplan stimmen wir vorab mit Ihnen ab." },
  { question: "Kann eine bestehende Terrasse erneuert werden, ohne alles abzureißen?", answer: "In vielen Fällen ja. Wenn der bestehende Unterbau noch intakt ist, können wir einen neuen Belag darauf verlegen. Wir prüfen zunächst den Zustand des Untergrunds und beraten Sie, ob eine Sanierung ausreicht oder ein Neuaufbau sinnvoller ist. Das spart oft Zeit und Kosten." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
  }))
};

const checklist = [
  'Planung und Beratung vor Ort',
  'Naturstein-Terrassen (Granit, Travertin, Schiefer)',
  'WPC- und Holzterrassen mit Unterkonstruktion',
  'Frostsicherer Unterbau mit Drainage',
  'Stufen und Höhenausgleich bei Hanglagen',
  'Vorbereitung für Terrassenbeleuchtung',
  'Einfassungen und Übergangsgestaltung',
  'Sanierung und Erneuerung bestehender Terrassen',
];
---

<MainLayout
  title="Terrassenbau Ludwigsburg, Stuttgart & Region | Gartenbau Z.M."
  description="Professioneller Terrassenbau in Ludwigsburg, Stuttgart & Region. Holz, WPC & Naturstein-Terrassen. Planung & Umsetzung aus einer Hand."
  ogImage="/img/image_143.webp"
>
  <Header />

  <!-- Hero -->
  <section class="bg-pine text-white pt-32 pb-14 md:pt-40 md:pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 font-mono text-[0.72rem] uppercase tracking-[0.14em] text-white/50">
          <li><a href="/" class="hover:text-marker transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/leistungen/" class="hover:text-marker transition-colors">Leistungen</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-white/80">Terrassenbau</li>
        </ol>
      </nav>
      <p class="eyebrow eyebrow-light">Leistung · LV 03</p>
      <h1 class="font-display font-extrabold uppercase text-white text-4xl md:text-5xl lg:text-6xl mt-5" style="font-stretch: 118%;">Terrassenbau</h1>
      <p class="text-white/70 text-lg md:text-xl mt-5 max-w-2xl">Professioneller Terrassenbau mit Holz, WPC und Naturstein — Ihre perfekte Outdoor-Wohnfläche in Stuttgart und Umgebung.</p>
    </div>
  </section>

  <main id="main-content">
    <!-- Service description -->
    <section class="py-20 md:py-28 bg-paper">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <p class="eyebrow">Im Detail</p>
          <h2 class="font-display font-extrabold uppercase text-3xl md:text-4xl text-ink mt-5" style="font-stretch: 118%;">Ihre Terrasse — das Wohnzimmer im Freien</h2>
        </div>
        <p class="mt-6 text-bark leading-relaxed">
          Eine gut geplante Terrasse erweitert Ihren Wohnraum nach draußen und schafft einen Ort zum Entspannen, Grillen und Zusammenkommen. Bei Gartenbau Z.M. planen und bauen wir Terrassen in Ludwigsburg, Stuttgart, Waiblingen, Kornwestheim und der gesamten Region, die funktional und ästhetisch überzeugen. Von der Materialauswahl über den fachgerechten Unterbau bis zur finalen Gestaltung — alles aus einer Hand.
        </p>

        <h3 class="font-display font-bold text-xl md:text-2xl text-ink mt-12" style="font-stretch: 110%;">Materialvielfalt für jeden Geschmack</h3>
        <p class="mt-4 text-bark leading-relaxed">
          Die Wahl des richtigen Terrassenbelags ist entscheidend für Optik, Haptik und Pflegeaufwand. Wir verarbeiten Natursteinplatten aus Granit, Travertin oder Schiefer für zeitlose Eleganz. WPC-Dielen bieten die warme Optik von Holz bei minimaler Pflege und hoher Witterungsbeständigkeit. Für alle, die echtes Holz bevorzugen, arbeiten wir mit langlebigen Harthölzern wie Bangkirai und thermisch modifizierter Esche. Auch Betonstein in moderner Großformatoptik gehört zu unserem Repertoire.
        </p>

        <h3 class="font-display font-bold text-xl md:text-2xl text-ink mt-12" style="font-stretch: 110%;">Fachgerechter Unterbau und Entwässerung</h3>
        <p class="mt-4 text-bark leading-relaxed">
          Der Unterbau entscheidet über die Langlebigkeit Ihrer Terrasse. Wir erstellen eine frostsichere Tragschicht mit korrektem Gefälle, damit Regenwasser zuverlässig abgeleitet wird. Bei angrenzenden Gebäudewänden installieren wir Abdichtungen und Drainagen, um Feuchtigkeitsschäden zu vermeiden. Für erhöhte Terrassen setzen wir stabile Unterkonstruktionen aus Aluminium oder verzinktem Stahl ein, die auch nach Jahren keine Setzungen zeigen.
        </p>

        <h3 class="font-display font-bold text-xl md:text-2xl text-ink mt-12" style="font-stretch: 110%;">Beleuchtung und Gestaltungsdetails</h3>
        <p class="mt-4 text-bark leading-relaxed">
          Eine Terrasse wird erst durch die richtigen Details zum echten Wohlfühlort. Wir integrieren auf Wunsch LED-Einbauleuchten in Stufen und Bodenbelag, installieren stimmungsvolle Pollerleuchten oder planen Stromanschlüsse für Ihre Außenküche. Stufen, Einfassungen und Übergänge zum Garten gestalten wir passend zum Gesamtkonzept — ob mit Naturstein, Cortenstahl oder bepflanzten Randbereichen. Unser Ziel ist eine Terrasse, die sich nahtlos in Ihren Garten in Ludwigsburg, Fellbach oder Stuttgart einfügt.
        </p>
      </div>
    </section>

    <!-- Checklist -->
    <section class="py-20 md:py-28 bg-stone">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <p class="eyebrow">Leistungsumfang</p>
          <h2 class="font-display font-extrabold uppercase text-3xl md:text-4xl text-ink mt-5" style="font-stretch: 118%;">Was wir bieten</h2>
        </div>
        <ul class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {checklist.map((item) => (
            <li class="flex items-start gap-3"><span class="flex items-center justify-center w-5 h-5 mt-0.5 bg-marker rounded-sm font-mono text-[0.7rem] text-ink shrink-0" aria-hidden="true">&#10003;</span><span class="text-ink">{item}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Gallery -->
    <section class="py-20 md:py-28 bg-paper">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <p class="eyebrow">Referenzen</p>
          <h2 class="font-display font-extrabold uppercase text-3xl md:text-4xl text-ink mt-5" style="font-stretch: 118%;">Beispiele unserer Arbeit</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
          <img src="/img/optimized/image_143-sm.webp" alt="Terrasse aus großformatigen grauen Platten am Haus" class="rounded-lg border border-line w-full h-64 object-cover" loading="lazy" />
          <img src="/img/optimized/image_21-sm.webp" alt="Terrasse aus großformatigen Platten mit Übergang zum Gartenweg" class="rounded-lg border border-line w-full h-64 object-cover" loading="lazy" />
          <img src="/img/optimized/image_139-sm.webp" alt="Terrasse mit Natursteinplatten entlang der Hauswand" class="rounded-lg border border-line w-full h-64 object-cover" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-20 md:py-28 bg-stone">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <p class="eyebrow justify-center">FAQ</p>
          <h2 class="font-display font-extrabold uppercase text-3xl md:text-4xl text-ink text-center mt-5" style="font-stretch: 118%;">Häufige Fragen</h2>
        </div>
        <div class="mt-12">
          {faqs.map((faq) => (
            <details class="border-b border-line group">
              <summary class="font-semibold text-ink text-[1.05rem] py-5 cursor-pointer flex items-center justify-between gap-4 list-none [&::-webkit-details-marker]:hidden">
                <span>{faq.question}</span>
                <span class="faq-icon flex-shrink-0 flex items-center justify-center w-7 h-7 rounded-md border border-line font-mono text-lg leading-none text-moss select-none" aria-hidden="true">+</span>
              </summary>
              <div class="faq-content"><div><p class="text-bark leading-relaxed pb-5">{faq.answer}</p></div></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 md:py-28 bg-pine text-white">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 text-center">
        <p class="eyebrow eyebrow-light justify-center">Kontakt</p>
        <h2 class="font-display font-extrabold uppercase text-white text-3xl md:text-4xl mt-5" style="font-stretch: 118%;">Projekt besprechen?</h2>
        <p class="text-white/70 mt-4 text-lg">Kostenlose Erstberatung — vor Ort und unverbindlich.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-8">
          <a href="/#kontakt" class="btn btn-primary">Kostenlose Beratung anfragen</a>
          <a href="tel:+491782747470" class="btn btn-outline text-white">+49 178 2747470</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</MainLayout>

<style>
  details .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease-out;
  }
  details[open] .faq-content {
    grid-template-rows: 1fr;
  }
  details .faq-content > div {
    overflow: hidden;
  }
  details summary .faq-icon {
    transition: transform 0.3s ease-out, background-color 0.3s ease-out;
  }
  details[open] summary .faq-icon {
    transform: rotate(45deg);
    background-color: var(--color-marker);
    border-color: var(--color-marker);
    color: var(--color-ink);
  }
</style>
