---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://gartenbauzm.de/" },
    { "@type": "ListItem", "position": 2, "name": "Leistungen", "item": "https://gartenbauzm.de/leistungen/" },
    { "@type": "ListItem", "position": 3, "name": "Terrassenbau", "item": "https://gartenbauzm.de/leistungen/terrassenbau/" }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Terrassenbau",
  "description": "Professioneller Terrassenbau in Ludwigsburg, Stuttgart & Region. Holz, WPC & Naturstein-Terrassen. Planung & Umsetzung aus einer Hand.",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Gartenbau Z.M.",
    "address": { "@type": "PostalAddress", "addressLocality": "Remseck am Neckar", "addressRegion": "Baden-Württemberg", "addressCountry": "DE" },
    "telephone": "+491782747470",
    "url": "https://gartenbauzm.de"
  },
  "areaServed": ["Ludwigsburg", "Stuttgart", "Remseck am Neckar", "Waiblingen", "Fellbach", "Kornwestheim", "Esslingen", "Leonberg", "Böblingen", "Sindelfingen", "Bietigheim-Bissingen", "Korntal-Münchingen"]
};

const faqs = [
  { question: "Welches Material eignet sich am besten für eine Terrasse?", answer: "Die Materialwahl hängt von Ihren Anforderungen ab. Naturstein wie Granit oder Travertin ist extrem langlebig und pflegeleicht. WPC (Wood-Plastic-Composite) bietet eine Holzoptik ohne den Pflegeaufwand von Echtholz. Echtholz wie Bangkirai oder Lärche überzeugt durch natürliche Wärme und Haptik, benötigt jedoch regelmäßige Pflege. Wir beraten Sie gerne zu den Vor- und Nachteilen." },
  { question: "Was kostet eine neue Terrasse pro Quadratmeter?", answer: "Die Kosten variieren je nach Material und Unterbau. Eine Betonstein-Terrasse beginnt bei ca. 80 Euro pro Quadratmeter, WPC-Terrassen ab ca. 120 Euro und Naturstein-Terrassen ab ca. 150 Euro pro Quadratmeter, jeweils inklusive Unterbau und Verlegung. Ein individuelles Angebot erstellen wir nach der kostenlosen Vor-Ort-Beratung." },
  { question: "Wie wird die Entwässerung der Terrasse sichergestellt?", answer: "Eine fachgerechte Entwässerung ist entscheidend für die Langlebigkeit Ihrer Terrasse. Wir legen ein Gefälle von mindestens zwei Prozent vom Haus weg an und installieren bei Bedarf Entwässerungsrinnen oder Drainagesysteme. So wird Staunässe vermieden und die Bausubstanz Ihres Hauses geschützt." },
  { question: "Wie lange dauert der Bau einer Terrasse?", answer: "Eine Standard-Terrasse von 20 bis 30 Quadratmetern realisieren wir in der Regel innerhalb von drei bis fünf Arbeitstagen, inklusive Erdarbeiten und Unterbau. Größere Projekte mit aufwendigem Unterbau oder Hanglagen können bis zu zwei Wochen dauern. Den genauen Zeitplan stimmen wir vorab mit Ihnen ab." },
  { question: "Kann eine bestehende Terrasse erneuert werden, ohne alles abzureißen?", answer: "In vielen Fällen ja. Wenn der bestehende Unterbau noch intakt ist, können wir einen neuen Belag darauf verlegen. Wir prüfen zunächst den Zustand des Untergrunds und beraten Sie, ob eine Sanierung ausreicht oder ein Neuaufbau sinnvoller ist. Das spart oft Zeit und Kosten." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
  }))
};
---

<MainLayout
  title="Terrassenbau Ludwigsburg, Stuttgart & Region | Gartenbau Z.M."
  description="Professioneller Terrassenbau in Ludwigsburg, Stuttgart & Region. Holz, WPC & Naturstein-Terrassen. Planung & Umsetzung aus einer Hand."
  ogImage="/img/image_110.webp"
>
  <Header />

  <!-- Hero -->
  <section class="bg-forest text-white pt-28 pb-20 md:pt-36 md:pb-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-ivory/60">
          <li><a href="/" class="hover:text-ivory transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/leistungen" class="hover:text-ivory transition-colors">Leistungen</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ivory">Terrassenbau</li>
        </ol>
      </nav>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl">Terrassenbau</h1>
      <p class="text-ivory/80 text-lg md:text-xl mt-4 max-w-2xl">Professioneller Terrassenbau mit Holz, WPC und Naturstein — Ihre perfekte Outdoor-Wohnfläche in Stuttgart und Umgebung.</p>
    </div>
  </section>

  <main id="main-content">
    <!-- Service description -->
    <section class="py-20 md:py-28 bg-ivory">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <h2 class="font-heading text-3xl md:text-4xl text-forest">Ihre Terrasse — das Wohnzimmer im Freien</h2>
        <p class="mt-6 text-text leading-relaxed">
          Eine gut geplante Terrasse erweitert Ihren Wohnraum nach draußen und schafft einen Ort zum Entspannen, Grillen und Zusammenkommen. Bei Gartenbau Z.M. planen und bauen wir Terrassen in Ludwigsburg, Stuttgart, Waiblingen, Kornwestheim und der gesamten Region, die funktional und ästhetisch überzeugen. Von der Materialauswahl über den fachgerechten Unterbau bis zur finalen Gestaltung — alles aus einer Hand.
        </p>

        <h3 class="font-heading text-2xl text-forest mt-10">Materialvielfalt für jeden Geschmack</h3>
        <p class="mt-4 text-text leading-relaxed">
          Die Wahl des richtigen Terrassenbelags ist entscheidend für Optik, Haptik und Pflegeaufwand. Wir verarbeiten Natursteinplatten aus Granit, Travertin oder Schiefer für zeitlose Eleganz. WPC-Dielen bieten die warme Optik von Holz bei minimaler Pflege und hoher Witterungsbeständigkeit. Für alle, die echtes Holz bevorzugen, arbeiten wir mit langlebigen Harthölzern wie Bangkirai und thermisch modifizierter Esche. Auch Betonstein in moderner Großformatoptik gehört zu unserem Repertoire.
        </p>

        <h3 class="font-heading text-2xl text-forest mt-10">Fachgerechter Unterbau und Entwässerung</h3>
        <p class="mt-4 text-text leading-relaxed">
          Der Unterbau entscheidet über die Langlebigkeit Ihrer Terrasse. Wir erstellen eine frostsichere Tragschicht mit korrektem Gefälle, damit Regenwasser zuverlässig abgeleitet wird. Bei angrenzenden Gebäudewänden installieren wir Abdichtungen und Drainagen, um Feuchtigkeitsschäden zu vermeiden. Für erhöhte Terrassen setzen wir stabile Unterkonstruktionen aus Aluminium oder verzinktem Stahl ein, die auch nach Jahren keine Setzungen zeigen.
        </p>

        <h3 class="font-heading text-2xl text-forest mt-10">Beleuchtung und Gestaltungsdetails</h3>
        <p class="mt-4 text-text leading-relaxed">
          Eine Terrasse wird erst durch die richtigen Details zum echten Wohlfühlort. Wir integrieren auf Wunsch LED-Einbauleuchten in Stufen und Bodenbelag, installieren stimmungsvolle Pollerleuchten oder planen Stromanschlüsse für Ihre Außenküche. Stufen, Einfassungen und Übergänge zum Garten gestalten wir passend zum Gesamtkonzept — ob mit Naturstein, Cortenstahl oder bepflanzten Randbereichen. Unser Ziel ist eine Terrasse, die sich nahtlos in Ihren Garten in Ludwigsburg, Fellbach oder Stuttgart einfügt.
        </p>
      </div>
    </section>

    <!-- Checklist -->
    <section class="py-20 md:py-28 bg-ivory-warm">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <h2 class="font-heading text-3xl md:text-4xl text-forest text-center">Was wir bieten</h2>
        <ul class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <li class="flex items-start gap-3"><span class="text-terracotta mt-1" aria-hidden="true">&#10003;</span><span class="text-text">Planung und Beratung vor Ort</span></li>
          <li class="flex items-start gap-3"><span class="text-terracotta mt-1" aria-hidden="true">&#10003;</span><span class="text-text">Naturstein-Terrassen (Granit, Travertin, Schiefer)</span></li>
          <li class="flex items-start gap-3"><span class="text-terracotta mt-1" aria-hidden="true">&#10003;</span><span class="text-text">WPC- und Holzterrassen mit Unterkonstruktion</span></li>
          <li class="flex items-start gap-3"><span class="text-terracotta mt-1" aria-hidden="true">&#10003;</span><span class="text-text">Frostsicherer Unterbau mit Drainage</span></li>
          <li class="flex items-start gap-3"><span class="text-terracotta mt-1" aria-hidden="true">&#10003;</span><span class="text-text">Stufen und Höhenausgleich bei Hanglagen</span></li>
          <li class="flex items-start gap-3"><span class="text-terracotta mt-1" aria-hidden="true">&#10003;</span><span class="text-text">Terrassenbeleuchtung und Elektroinstallation</span></li>
          <li class="flex items-start gap-3"><span class="text-terracotta mt-1" aria-hidden="true">&#10003;</span><span class="text-text">Einfassungen und Übergangsgestaltung</span></li>
          <li class="flex items-start gap-3"><span class="text-terracotta mt-1" aria-hidden="true">&#10003;</span><span class="text-text">Sanierung und Erneuerung bestehender Terrassen</span></li>
        </ul>
      </div>
    </section>

    <!-- Gallery -->
    <section class="py-20 md:py-28 bg-ivory">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="font-heading text-3xl md:text-4xl text-forest text-center">Beispiele unserer Arbeit</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
          <img src="/img/image_110.webp" alt="Moderne Naturstein-Terrasse mit Großformatplatten in Stuttgart" class="rounded-2xl w-full h-64 object-cover" loading="lazy" />
          <img src="/img/image_111.webp" alt="WPC-Terrasse mit integrierter Beleuchtung in Ludwigsburg" class="rounded-2xl w-full h-64 object-cover" loading="lazy" />
          <img src="/img/image_115.webp" alt="Terrassenbau mit Stufen und Einfassung im Hanggrundstück" class="rounded-2xl w-full h-64 object-cover" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-20 md:py-28 bg-ivory-warm">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <h2 class="font-heading text-3xl md:text-4xl text-forest text-center mb-10">Häufige Fragen</h2>
        {faqs.map((faq) => (
          <details class="border-b border-sand/50 group">
            <summary class="font-heading text-lg text-forest py-5 cursor-pointer flex items-center justify-between list-none [&::-webkit-details-marker]:hidden">
              <span>{faq.question}</span>
              <span class="faq-icon ml-4 flex-shrink-0 text-2xl leading-none text-terracotta select-none" aria-hidden="true">+</span>
            </summary>
            <div class="faq-content"><p class="font-body text-text-muted leading-relaxed pb-5">{faq.answer}</p></div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 md:py-28 bg-forest text-white text-center">
      <div class="mx-auto max-w-3xl px-4">
        <h2 class="font-heading text-3xl md:text-4xl">Projekt besprechen?</h2>
        <p class="text-ivory/80 mt-4 text-lg">Kontaktieren Sie uns für eine kostenlose Erstberatung.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
          <a href="/#kontakt" class="bg-terracotta hover:bg-terracotta-dark text-white rounded-full px-8 py-3 font-medium transition-colors">Kontakt aufnehmen</a>
          <a href="tel:+491782747470" class="border border-ivory/30 hover:border-ivory text-ivory rounded-full px-8 py-3 font-medium transition-colors">+49 178 2747470</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</MainLayout>

<style>
  details .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease-out;
  }
  details[open] .faq-content {
    grid-template-rows: 1fr;
  }
  details .faq-content > p {
    overflow: hidden;
  }
  details summary .faq-icon {
    transition: transform 0.3s ease-out;
  }
  details[open] summary .faq-icon {
    transform: rotate(45deg);
  }
</style>
