---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { serviceArea } from '../../data/business';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Sichtschutz Garten",
  "description": "Sichtschutz für Ihren Garten in Ludwigsburg, Stuttgart & Region. Zäune, Hecken, Gabionen & Sichtschutzwände. Individuelle Lösungen für Ihre Privatsphäre.",
  "provider": { "@id": "https://gartenbauzm.de/#business" },
  "areaServed": serviceArea
};

const faqs = [
  { question: "Welche Sichtschutz-Optionen gibt es für meinen Garten?", answer: "Es gibt zahlreiche Möglichkeiten: Holzzäune (Rhombus, Lamellen oder Lattenzaun), WPC-Sichtschutzelemente, Gabionen mit Stein- oder Glasfüllung, immergrüne Hecken (z. B. Thuja, Kirschlorbeer, Liguster), Sichtschutzwände aus Metall oder Cortenstahl sowie Kombinationen verschiedener Elemente. Wir beraten Sie vor Ort, welche Lösung zu Ihrem Garten, Budget und den örtlichen Vorschriften passt." },
  { question: "Wie hoch darf ein Sichtschutz in Baden-Württemberg sein?", answer: "In Baden-Württemberg ist ein Sichtschutz bis zu einer Höhe von 1,80 Meter in der Regel genehmigungsfrei — vorausgesetzt, die Grenzabstände werden eingehalten. Der Mindestabstand zum Nachbargrundstück beträgt bei Zäunen üblicherweise 0,50 Meter. Bei Hecken gelten je nach Pflanzhöhe Abstände von 0,50 bis 2,00 Meter. Wir kennen die lokalen Bestimmungen in Ludwigsburg, Stuttgart und Umgebung und beraten Sie rechtssicher." },
  { question: "Was kostet ein Sichtschutz im Garten?", answer: "Der Preis hängt von Fläche, Material, Unterbau und Zugänglichkeit des Grundstücks ab. Pauschalpreise wären deshalb unseriös: Nach dem kostenlosen Aufmaß vor Ort erhalten Sie ein schriftliches Angebot mit allen Positionen." },
  { question: "Wie lange hält ein Sichtschutz?", answer: "Die Haltbarkeit hängt vom Material ab. Druckimprägnierte Holzzäune halten 15-20 Jahre, Hartholz wie Lärche oder Douglasie 20-25 Jahre. WPC-Elemente sind nahezu wartungsfrei und halten 25-30 Jahre. Gabionen mit feuerverzinktem Draht halten problemlos 30 Jahre und mehr. Immergrüne Hecken sind bei richtiger Pflege quasi unbegrenzt haltbar und werden mit den Jahren immer dichter." },
  { question: "Kann man Sichtschutz auch im Winter aufbauen?", answer: "Ja, feste Sichtschutzelemente wie Zäune, Gabionen und WPC-Wände können ganzjährig montiert werden, sofern der Boden für die Fundamentarbeiten nicht tief gefroren ist. Lediglich die Pflanzung von Hecken sollte auf das Frühjahr oder den Herbst verschoben werden. Wir planen Ihr Projekt so, dass es termingerecht realisiert wird — auch in den Wintermonaten." }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
  }))
};

const checklist = [
  "Holzzäune (Lärche, Douglasie, Kiefer)",
  "WPC-Sichtschutzelemente und Verbundmaterial",
  "Gabionen mit Naturstein- oder Glasfüllung",
  "Immergrüne Heckenpflanzung",
  "Cortenstahl- und Metall-Sichtschutzwände",
  "Fundamente und Pfostenmontage",
  "Kombinationen aus verschiedenen Materialien",
  "Beratung zu Vorschriften und Grenzabständen",
];
---

<MainLayout
  title="Sichtschutz Garten Ludwigsburg, Stuttgart & Region | Gartenbau Z.M."
  description="Sichtschutz für Ihren Garten in Ludwigsburg, Stuttgart & Region. Zäune, Hecken, Gabionen & Sichtschutzwände. Individuelle Lösungen für Ihre Privatsphäre."
  ogImage="/img/image_113.webp"
>
  <Header />

  <!-- Hero -->
  <section class="bg-pine text-white pt-32 pb-14 md:pt-40 md:pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 font-mono text-[0.72rem] uppercase tracking-[0.14em] text-white/50">
          <li><a href="/" class="hover:text-marker transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/leistungen/" class="hover:text-marker transition-colors">Leistungen</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-white/80">Sichtschutz</li>
        </ol>
      </nav>
      <p class="eyebrow eyebrow-light">Leistung &middot; LV 07</p>
      <h1 class="font-display font-extrabold uppercase text-white text-4xl md:text-5xl lg:text-6xl mt-5" style="font-stretch: 118%;">Sichtschutz Garten</h1>
      <p class="text-white/70 text-lg md:text-xl mt-5 max-w-2xl">Individuelle Sichtschutzlösungen für mehr Privatsphäre in Ihrem Garten in Ludwigsburg, Stuttgart und der gesamten Region.</p>
    </div>
  </section>

  <main id="main-content">
    <!-- Service description -->
    <section class="py-20 md:py-28 bg-paper">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <p class="eyebrow">Leistung im Detail</p>
          <h2 class="font-display font-extrabold uppercase text-3xl md:text-4xl text-ink mt-5" style="font-stretch: 118%;">Sichtschutz nach Maß</h2>
        </div>
        <p class="mt-6 text-bark leading-relaxed">
          Ein gut geplanter Sichtschutz ist weit mehr als eine Abgrenzung zum Nachbargrundstück. Er schafft Privatsphäre, schützt vor Wind und Lärm und gibt Ihrem Garten eine klare Struktur. Gartenbau Z.M. plant und baut individuelle Sichtschutzlösungen in Ludwigsburg, Stuttgart, Kornwestheim, Waiblingen und Fellbach — passend zu Ihrem Gartenstil und Ihrem Budget.
        </p>

        <h3 class="font-display font-bold text-2xl text-ink mt-10" style="font-stretch: 110%;">Zäune und Sichtschutzwände</h3>
        <p class="mt-4 text-bark leading-relaxed">
          Ob klassischer Holzzaun, moderner WPC-Sichtschutz oder elegante Cortenstahl-Elemente — wir montieren Sichtschutzzäune in allen gängigen Materialien und Designs. Rhombusleisten aus Lärche oder Douglasie sorgen für ein natürliches Erscheinungsbild, während WPC-Elemente durch ihre Langlebigkeit und Wartungsfreiheit überzeugen. Alle Zäune werden mit massiven Pfosten auf Punkt- oder Streifenfundamenten verankert, sodass sie auch starkem Wind standhalten. In den Gärten unserer Kunden in Stuttgart und Ludwigsburg setzen wir seit Jahren auf bewährte Konstruktionen.
        </p>

        <h3 class="font-display font-bold text-2xl text-ink mt-10" style="font-stretch: 110%;">Gabionen und Steinwände</h3>
        <p class="mt-4 text-bark leading-relaxed">
          Gabionen sind eine hervorragende Wahl für langlebigen, modernen Sichtschutz. Die Drahtkörbe werden mit Naturstein, Basalt, Kalkstein oder Glasbruch befüllt und bieten einen robusten Sichtschutz mit architektonischem Charakter. In Kombination mit Holzelementen oder Bepflanzung entstehen einzigartige Gestaltungslösungen. Wir übernehmen Planung, Fundamentierung und Aufbau der Gabionen komplett — von Ludwigsburg über Waiblingen bis nach Fellbach.
        </p>

        <h3 class="font-display font-bold text-2xl text-ink mt-10" style="font-stretch: 110%;">Hecken und grüner Sichtschutz</h3>
        <p class="mt-4 text-bark leading-relaxed">
          Für Naturliebhaber ist eine immergrüne Hecke die schönste Form des Sichtschutzes. Wir pflanzen Thuja, Kirschlorbeer, Liguster, Eibe oder Hainbuche — je nach Standort, gewünschter Höhe und persönlichem Geschmack. Bei der Pflanzung achten wir auf die richtige Pflanztiefe, optimalen Pflanzabstand und eine gründliche Bodenvorbereitung. Gerne kombinieren wir Hecken mit Zaunabschnitten oder Gabionen zu einem abwechslungsreichen Sichtschutzkonzept, das Ihren Garten in Stuttgart und Umgebung optisch aufwertet.
        </p>
      </div>
    </section>

    <!-- Checklist -->
    <section class="py-20 md:py-28 bg-stone">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <p class="eyebrow">Leistungsumfang</p>
          <h2 class="font-display font-extrabold uppercase text-3xl md:text-4xl text-ink mt-5" style="font-stretch: 118%;">Was wir bieten</h2>
        </div>
        <ul class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {checklist.map((item) => (
            <li class="flex items-start gap-3 bg-white rounded-lg border border-line p-4 reveal">
              <span class="flex items-center justify-center w-5 h-5 mt-0.5 bg-marker rounded-sm font-mono text-[0.7rem] text-ink shrink-0" aria-hidden="true">&#10003;</span>
              <span class="text-ink">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Gallery -->
    <section class="py-20 md:py-28 bg-paper">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <p class="eyebrow">Referenzen</p>
          <h2 class="font-display font-extrabold uppercase text-3xl md:text-4xl text-ink mt-5" style="font-stretch: 118%;">Beispiele unserer Arbeit</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
          <img src="/img/optimized/image_113-sm.webp" alt="Sichtschutz aus Holzelementen im Fischgrätmuster an einem gepflasterten Sitzplatz" class="rounded-lg border border-line w-full h-64 object-cover reveal" loading="lazy" />
          <img src="/img/optimized/image_18-sm.webp" alt="Graue Sichtschutzelemente mit Koniferen entlang der Grundstücksgrenze" class="rounded-lg border border-line w-full h-64 object-cover reveal" loading="lazy" style="transition-delay: 80ms" />
          <img src="/img/optimized/image_117-sm.webp" alt="Holz-Sichtschutz als Abschluss einer Pflasterfläche" class="rounded-lg border border-line w-full h-64 object-cover reveal" loading="lazy" style="transition-delay: 160ms" />
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-20 md:py-28 bg-stone">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <p class="eyebrow">FAQ</p>
          <h2 class="font-display font-extrabold uppercase text-3xl md:text-4xl text-ink mt-5" style="font-stretch: 118%;">Häufige Fragen</h2>
        </div>
        <div class="mt-10 reveal">
          {faqs.map((faq) => (
            <details class="border-b border-line group">
              <summary class="font-semibold text-ink text-[1.05rem] py-5 cursor-pointer flex items-center justify-between gap-4 list-none [&::-webkit-details-marker]:hidden">
                <span>{faq.question}</span>
                <span class="faq-icon flex-shrink-0 flex items-center justify-center w-7 h-7 rounded-md border border-line font-mono text-lg leading-none text-moss select-none" aria-hidden="true">+</span>
              </summary>
              <div class="faq-content"><div><p class="text-bark leading-relaxed pb-5">{faq.answer}</p></div></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 md:py-28 bg-pine text-white">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 text-center">
        <p class="eyebrow eyebrow-light justify-center">Kontakt</p>
        <h2 class="font-display font-extrabold uppercase text-white text-3xl md:text-4xl mt-5" style="font-stretch: 118%;">Projekt besprechen?</h2>
        <p class="text-white/70 mt-4 text-lg">Kostenlose Erstberatung — vor Ort und unverbindlich.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-8">
          <a href="/#kontakt" class="btn btn-primary">Kostenlose Beratung anfragen</a>
          <a href="tel:+491782747470" class="btn btn-outline text-white">+49 178 2747470</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</MainLayout>

<style>
  details .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease-out;
  }
  details[open] .faq-content {
    grid-template-rows: 1fr;
  }
  details .faq-content > div {
    overflow: hidden;
  }
  details summary .faq-icon {
    transition: transform 0.3s ease-out, background-color 0.3s ease-out;
  }
  details[open] summary .faq-icon {
    transform: rotate(45deg);
    background-color: var(--color-marker);
    border-color: var(--color-marker);
    color: var(--color-ink);
  }
</style>
