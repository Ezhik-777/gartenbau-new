---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GalleryGrid from '../components/GalleryGrid';
// Generate all 180 image data with proper categorization and titles
const generatedImages = Array.from({ length: 180 }, (_, i) => {
  const id = i + 1;

  // Categorize images based on ID ranges with realistic distribution
  let category = 'garden';
  let alt = '';
  let title = '';

  if (id >= 1 && id <= 60) {
    // Garden landscaping projects (1-60)
    category = 'garden';
    const subcategories = [
      'Komplette Gartengestaltung',
      'Neuanlage Garten',
      'Gartenumbau',
      'Bepflanzung',
      'Gartenplanung'
    ];
    const subcategory = subcategories[Math.floor((id - 1) / 12) % subcategories.length];
    alt = `${subcategory} Projekt ${id} - Professioneller Gartenbau in Ludwigsburg und Stuttgart`;
    title = `${subcategory} #${id}`;
  } else if (id >= 61 && id <= 105) {
    // Natural stone work (61-105)
    category = 'stone';
    const subcategories = [
      'Natursteinmauer',
      'Betonsteinarbeiten',
      'Gabionen',
      'Steintreppen',
      'Steineinfassungen'
    ];
    const subcategory = subcategories[Math.floor((id - 61) / 9) % subcategories.length];
    alt = `${subcategory} Projekt ${id} - Hochwertige Natursteinarbeiten in der Region Stuttgart`;
    title = `${subcategory} #${id}`;
  } else if (id >= 106 && id <= 140) {
    // Terrace construction (106-140)
    category = 'terrace';
    const subcategories = [
      'Holzterrasse',
      'WPC Terrasse',
      'Steinterrasse',
      'Dachterrasse',
      'Terrassenüberdachung'
    ];
    const subcategory = subcategories[Math.floor((id - 106) / 7) % subcategories.length];
    alt = `${subcategory} Projekt ${id} - Moderner Terrassenbau in Ludwigsburg und Waiblingen`;
    title = `${subcategory} #${id}`;
  } else if (id >= 141 && id <= 165) {
    // Paving work (141-165)
    category = 'paving';
    const subcategories = [
      'Einfahrt pflastern',
      'Gartenwege',
      'Hofpflasterung',
      'Parkplatz',
      'Gehwegplatten'
    ];
    const subcategory = subcategories[Math.floor((id - 141) / 5) % subcategories.length];
    alt = `${subcategory} Projekt ${id} - Professionelle Pflasterarbeiten in Stuttgart`;
    title = `${subcategory} #${id}`;
  } else {
    // Privacy screens / fencing (166-180)
    category = 'privacy';
    const subcategories = [
      'Sichtschutz Holz',
      'Sichtschutzzaun',
      'Gabionen Sichtschutz',
      'Bambuszaun',
      'Zaunbau'
    ];
    const subcategory = subcategories[Math.floor((id - 166) / 3) % subcategories.length];
    alt = `${subcategory} Projekt ${id} - Sichtschutz und Zaunbau in Ludwigsburg und Region`;
    title = `${subcategory} #${id}`;
  }

  return {
    id,
    src: `/img/image_${id}.webp`,
    alt,
    category,
    title,
    width: 800,
    height: 600
  };
});

// Neue reale Baustellen- und Projektfotos (id 181–187)
const newImages = [
  { id: 181, src: '/img/baustelle-einfahrt.webp', category: 'paving', title: 'Einfahrt — Unterbau & Verdichtung', alt: 'Vorbereitung einer Einfahrt: Schotter-Tragschicht mit Rüttelplatte verdichtet', width: 1200, height: 1600 },
  { id: 182, src: '/img/baustelle-verdichtung.webp', category: 'paving', title: 'Tragschicht verdichten', alt: 'Verdichtung der Tragschicht mit der Rüttelplatte', width: 1200, height: 1600 },
  { id: 183, src: '/img/baustelle-randsteine.webp', category: 'privacy', title: 'Zaunbau — Fundament & Randsteine', alt: 'Zaunpfosten gesetzt, Randsteine in Beton — Vorbereitung Sichtschutz', width: 1200, height: 1600 },
  { id: 184, src: '/img/projekt-hangterrassen.webp', category: 'stone', title: 'Hangterrassierung mit Palisaden', alt: 'Terrassierter Hang mit dunklen Palisaden und Treppe', width: 946, height: 1170 },
  { id: 185, src: '/img/projekt-l-steine.webp', category: 'stone', title: 'Stützmauer aus L-Steinen', alt: 'L-Steine als Stützmauer, Erdarbeiten mit Minibagger', width: 1600, height: 414 },
  { id: 186, src: '/img/projekt-rasen-fertig.webp', category: 'garden', title: 'Gartenpflege — Rasen & Sichtschutz', alt: 'Gepflegter Rasen mit Holz-Sichtschutz', width: 1200, height: 855 },
  { id: 187, src: '/img/projekt-garten-vorher.webp', category: 'garden', title: 'Gartenumbau — Ausgangszustand', alt: 'Garten vor der Umgestaltung — Ausgangszustand', width: 1200, height: 708 },
];

const images = [...generatedImages, ...newImages];

// Calculate category counts
const categoryCounts = {
  all: images.length,
  garden: images.filter(img => img.category === 'garden').length,
  stone: images.filter(img => img.category === 'stone').length,
  terrace: images.filter(img => img.category === 'terrace').length,
  paving: images.filter(img => img.category === 'paving').length,
  privacy: images.filter(img => img.category === 'privacy').length
};
---

<MainLayout
  title="Projekt Galerie - 185+ Gartenprojekte | Gartenbau Z.M. Ludwigsburg"
  description="Entdecken Sie über 185 erfolgreich abgeschlossene Gartenprojekte in Ludwigsburg, Stuttgart, Waiblingen & Region. Gartengestaltung, Naturstein, Terrassen, Pflaster & mehr."
  canonical="https://gartenbauzm.de/galerie"
  ogImage="/img/image_1.webp"
  ogType="website"
>
  <Header />

  <!-- Hero Banner -->
  <section class="bg-pine text-white pt-32 pb-14 md:pt-40 md:pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 font-mono text-[0.72rem] uppercase tracking-[0.14em] text-white/50">
          <li><a href="/" class="hover:text-marker transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-white/80">Galerie</li>
        </ol>
      </nav>
      <p class="eyebrow eyebrow-light">Referenzen</p>
      <h1 class="font-display font-extrabold uppercase text-white text-4xl md:text-5xl lg:text-6xl mt-5" style="font-stretch: 118%;">Galerie</h1>
      <p class="text-white/70 text-lg md:text-xl mt-5 max-w-2xl">
        185+ abgeschlossene Gartenprojekte in Stuttgart, Ludwigsburg & Region — echte Baustellen, echte Ergebnisse.
      </p>
    </div>
  </section>

  <!-- Main Gallery Content -->
  <main id="main-content" class="py-16 md:py-24 bg-paper">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Gallery Controls -->
      <div class="flex flex-col gap-6 mb-10">
        <!-- Filter Buttons -->
        <div class="flex flex-wrap gap-2.5 justify-center">
          <button class="filter-btn active px-4 py-2.5 font-mono uppercase text-[0.72rem] tracking-[0.12em] rounded-md cursor-pointer transition-all whitespace-nowrap bg-pine text-white border border-pine" data-filter="all">
            Alle Projekte ({categoryCounts.all})
          </button>
          <button class="filter-btn px-4 py-2.5 font-mono uppercase text-[0.72rem] tracking-[0.12em] rounded-md cursor-pointer transition-all whitespace-nowrap bg-white border border-line text-ink hover:border-ink/30" data-filter="garden">
            Gartengestaltung ({categoryCounts.garden})
          </button>
          <button class="filter-btn px-4 py-2.5 font-mono uppercase text-[0.72rem] tracking-[0.12em] rounded-md cursor-pointer transition-all whitespace-nowrap bg-white border border-line text-ink hover:border-ink/30" data-filter="stone">
            Natursteinarbeiten ({categoryCounts.stone})
          </button>
          <button class="filter-btn px-4 py-2.5 font-mono uppercase text-[0.72rem] tracking-[0.12em] rounded-md cursor-pointer transition-all whitespace-nowrap bg-white border border-line text-ink hover:border-ink/30" data-filter="terrace">
            Terrassenbau ({categoryCounts.terrace})
          </button>
          <button class="filter-btn px-4 py-2.5 font-mono uppercase text-[0.72rem] tracking-[0.12em] rounded-md cursor-pointer transition-all whitespace-nowrap bg-white border border-line text-ink hover:border-ink/30" data-filter="paving">
            Pflasterarbeiten ({categoryCounts.paving})
          </button>
          <button class="filter-btn px-4 py-2.5 font-mono uppercase text-[0.72rem] tracking-[0.12em] rounded-md cursor-pointer transition-all whitespace-nowrap bg-white border border-line text-ink hover:border-ink/30" data-filter="privacy">
            Sichtschutz ({categoryCounts.privacy})
          </button>
        </div>

        <!-- Sort Dropdown -->
        <div class="flex items-center justify-center gap-3">
          <label for="sort-select" class="font-mono uppercase text-[0.72rem] tracking-[0.12em] text-bark">Sortieren:</label>
          <select id="sort-select" class="px-3 py-2 text-sm border border-line rounded-md bg-white text-ink cursor-pointer transition-all hover:border-ink/30 focus:outline-none focus:border-moss focus:ring-2 focus:ring-moss/15" data-sort-select>
            <option value="newest">Neueste zuerst</option>
            <option value="oldest">Älteste zuerst</option>
            <option value="title-asc">Titel A-Z</option>
            <option value="title-desc">Titel Z-A</option>
          </select>
        </div>
      </div>

      <!-- Gallery Grid Component -->
      <GalleryGrid client:only="react" images={images} />
    </div>
  </main>

  <!-- CTA Section -->
  <section class="py-20 md:py-28 bg-pine text-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 text-center">
      <p class="eyebrow eyebrow-light justify-center">Kontakt</p>
      <h2 class="font-display font-extrabold uppercase text-white text-3xl md:text-4xl mt-5" style="font-stretch: 118%;">Projekt besprechen?</h2>
      <p class="text-white/70 mt-4 text-lg">Kostenlose Erstberatung — vor Ort und unverbindlich.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-8">
        <a href="/#kontakt" class="btn btn-primary">Kostenlose Beratung anfragen</a>
        <a href="tel:+491782747470" class="btn btn-outline text-white">+49 178 2747470</a>
      </div>
    </div>
  </section>

  <Footer />
</MainLayout>

<style>
  /* Filter button active state toggling (JS adds/removes .active) */
  .filter-btn.active {
    background-color: var(--color-pine) !important;
    color: white !important;
    border-color: var(--color-pine) !important;
  }
</style>

<script>
  // Sorting functionality for gallery - works with both initial load and View Transitions
  function initGallerySort() {
    const sortSelect = document.querySelector('[data-sort-select]') as HTMLSelectElement;

    if (sortSelect) {
      // Check if listener is already attached using data attribute
      if (sortSelect.dataset.sortInitialized) {
        return;
      }

      const handleSortChange = (e: Event) => {
        const sortValue = (e.target as HTMLSelectElement).value;

        // Dispatch custom event that GalleryGrid.tsx can listen to
        window.dispatchEvent(new CustomEvent('gallery-sort', {
          detail: { sortValue }
        }));
      };

      sortSelect.addEventListener('change', handleSortChange);
      sortSelect.dataset.sortInitialized = 'true';
    }
  }

  // Initialize on both DOMContentLoaded and astro:page-load (for View Transitions)
  document.addEventListener('DOMContentLoaded', initGallerySort);
  document.addEventListener('astro:page-load', initGallerySort);
</script>
