---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
  .filter((p) => p.id !== entry.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// Format date in German: "DD. MMMM YYYY"
const germanMonths = [
  'Januar', 'Februar', 'März', 'April', 'Mai', 'Juni',
  'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember',
];
const formattedDate = `${entry.data.date.getDate()}. ${germanMonths[entry.data.date.getMonth()]} ${entry.data.date.getFullYear()}`;

// Reading time from actual content word count (~200 words/min German)
const wordCount = entry.body ? entry.body.trim().split(/\s+/).length : 0;
const readingTime = Math.max(Math.ceil(wordCount / 200), 1);

const siteUrl = 'https://gartenbauzm.de';

// Schema.org BlogPosting JSON-LD
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": entry.data.title,
  "description": entry.data.description,
  "image": `${siteUrl}${entry.data.heroImage}`,
  "datePublished": entry.data.date.toISOString(),
  "dateModified": entry.data.date.toISOString(),
  "author": {
    "@type": "Organization",
    "name": "Gartenbau Z.M.",
    "url": siteUrl,
  },
  "publisher": {
    "@type": "Organization",
    "name": "Gartenbau Z.M.",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/img/logo.webp`,
    },
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `${siteUrl}/blog/${entry.id}`,
  },
  "keywords": entry.data.tags.join(', '),
};
---

<MainLayout
  title={`${entry.data.title} | Gartenbau Z.M.`}
  description={entry.data.description}
  ogImage={entry.data.heroImage}
  ogType="article"
>
  <Header />

  <!-- Hero -->
  <section class="bg-pine text-white pt-32 pb-14 md:pt-40 md:pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 font-mono text-[0.72rem] uppercase tracking-[0.14em] text-white/50">
          <li><a href="/" class="hover:text-marker transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/blog/" class="hover:text-marker transition-colors">Blog</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-white/80">Beitrag</li>
        </ol>
      </nav>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.72rem] uppercase tracking-[0.14em] text-white/50">
        <time datetime={entry.data.date.toISOString().split('T')[0]}>
          {formattedDate}
        </time>
        <span aria-hidden="true">/</span>
        <span>{readingTime} min Lesezeit</span>
      </div>
      <h1 class="font-display font-extrabold uppercase text-white text-3xl md:text-4xl lg:text-5xl mt-5 max-w-4xl" style="font-stretch: 118%;">
        {entry.data.title}
      </h1>
      {entry.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-6">
          {entry.data.tags.map((tag) => (
            <span class="border border-white/20 rounded-md px-2.5 py-1 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-white/70">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Main Content -->
  <main id="main-content" class="py-20 md:py-28 bg-paper">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">

      <!-- Hero Image -->
      <figure class="reveal">
        <img
          src={entry.data.heroImage}
          alt={entry.data.title}
          class="rounded-lg border border-line w-full aspect-[16/9] object-cover"
        />
        <figcaption class="flex items-center justify-between font-mono text-[0.7rem] uppercase tracking-[0.14em] text-bark mt-3">
          <span>Gartenbau Z.M.</span>
          <span>{formattedDate}</span>
        </figcaption>
      </figure>

      <!-- Description -->
      <p class="text-lg text-ink font-medium leading-relaxed mt-10 reveal" style="transition-delay: 100ms">
        {entry.data.description}
      </p>

      <!-- Markdown Content -->
      <div class="blog-content mt-4 reveal" style="transition-delay: 200ms">
        <Content />
      </div>
    </div>
  </main>

  <!-- Related Articles -->
  {related.length > 0 && (
    <section class="py-20 md:py-28 bg-stone">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <p class="eyebrow">Ratgeber</p>
          <h2 class="font-display font-extrabold uppercase text-3xl md:text-4xl text-ink mt-5" style="font-stretch: 118%;">
            Weitere Beiträge
          </h2>
          <p class="text-bark mt-4">Mehr Tipps und Fachwissen aus der Praxis</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
          {related.map((post, i) => (
            <div class="reveal" style={`transition-delay: ${i * 100}ms`}>
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                heroImage={post.data.heroImage}
                date={post.data.date}
                tags={post.data.tags}
                href={`/blog/${post.id}/`}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA-Band -->
  <section class="py-20 md:py-28 bg-pine text-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 text-center">
      <p class="eyebrow eyebrow-light justify-center">Kontakt</p>
      <h2 class="font-display font-extrabold uppercase text-white text-3xl md:text-4xl mt-5" style="font-stretch: 118%;">
        Projekt besprechen?
      </h2>
      <p class="text-white/70 mt-4 text-lg">Kostenlose Erstberatung — vor Ort und unverbindlich.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-8">
        <a href="/#kontakt" class="btn btn-primary">Kostenlose Beratung anfragen</a>
        <a href="tel:+491782747470" class="btn btn-outline text-white">+49 178 2747470</a>
      </div>
    </div>
  </section>

  <Footer />

  <!-- Schema.org BlogPosting -->
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
</MainLayout>

<style>
  /* Markdown content styling — Werkplan */
  .blog-content :global(h2) {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 110%;
    font-size: 1.5rem;
    line-height: 1.25;
    color: var(--color-ink);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .blog-content :global(h3) {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 110%;
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--color-ink);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }

  .blog-content :global(p) {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-bark);
    margin-top: 1rem;
  }

  .blog-content :global(ul),
  .blog-content :global(ol) {
    color: var(--color-bark);
    margin-top: 1rem;
    padding-left: 1.5rem;
  }

  .blog-content :global(ul) {
    list-style-type: disc;
  }

  .blog-content :global(ol) {
    list-style-type: decimal;
  }

  .blog-content :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.75;
  }

  .blog-content :global(li::marker) {
    color: var(--color-moss);
  }

  .blog-content :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }

  .blog-content :global(a) {
    color: var(--color-moss);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .blog-content :global(a:hover) {
    color: var(--color-pine);
  }

  .blog-content :global(blockquote) {
    border-left: 3px solid var(--color-marker);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-bark);
  }

  .blog-content :global(img) {
    border-radius: 0.5rem;
    border: 1px solid var(--color-line);
    max-width: 100%;
    margin: 1.5rem 0;
  }

  .blog-content :global(h2:first-child) {
    margin-top: 0;
  }
</style>
