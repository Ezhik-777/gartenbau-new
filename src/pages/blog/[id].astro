---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
  .filter((p) => p.id !== entry.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// Format date in German: "DD. MMMM YYYY"
const germanMonths = [
  'Januar', 'Februar', 'März', 'April', 'Mai', 'Juni',
  'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember',
];
const formattedDate = `${entry.data.date.getDate()}. ${germanMonths[entry.data.date.getMonth()]} ${entry.data.date.getFullYear()}`;

// Reading time from actual content word count (~200 words/min German)
const wordCount = entry.body ? entry.body.trim().split(/\s+/).length : 0;
const readingTime = Math.max(Math.ceil(wordCount / 200), 1);

const siteUrl = 'https://gartenbauzm.de';

// Schema.org BlogPosting JSON-LD
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": entry.data.title,
  "description": entry.data.description,
  "image": `${siteUrl}${entry.data.heroImage}`,
  "datePublished": entry.data.date.toISOString(),
  "dateModified": entry.data.date.toISOString(),
  "author": {
    "@type": "Organization",
    "name": "Gartenbau Z.M.",
    "url": siteUrl,
  },
  "publisher": {
    "@type": "Organization",
    "name": "Gartenbau Z.M.",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/img/logo.webp`,
    },
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `${siteUrl}/blog/${entry.id}`,
  },
  "keywords": entry.data.tags.join(', '),
};
---

<MainLayout
  title={`${entry.data.title} | Gartenbau Z.M.`}
  description={entry.data.description}
  ogImage={entry.data.heroImage}
  ogType="article"
>
  <Header />

  <!-- Hero Image -->
  <section class="relative pt-16 lg:pt-20">
    <div class="aspect-[21/9] overflow-hidden">
      <img
        src={entry.data.heroImage}
        alt={entry.data.title}
        class="w-full h-full object-cover"
      />
    </div>
    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-forest/80 via-forest/30 to-transparent flex items-end">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-8 md:pb-12 w-full">
        <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-white drop-shadow-lg">
          {entry.data.title}
        </h1>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <div class="bg-ivory-warm border-b border-sand/30">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4">
      <nav class="text-text-muted text-sm" aria-label="Breadcrumb">
        <a href="/" class="hover:text-terracotta transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href="/blog" class="hover:text-terracotta transition-colors">Blog</a>
        <span class="mx-2">/</span>
        <span class="text-forest font-medium">{entry.data.title}</span>
      </nav>
    </div>
  </div>

  <!-- Main Content -->
  <main id="main-content" class="py-16 md:py-24 bg-ivory">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

      <!-- Article Meta -->
      <div class="flex flex-wrap items-center gap-4 mb-8 reveal">
        <!-- Date -->
        <span class="flex items-center gap-1.5 text-text-muted text-sm">
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          <time datetime={entry.data.date.toISOString().split('T')[0]}>
            {formattedDate}
          </time>
        </span>

        <!-- Reading Time -->
        <span class="flex items-center gap-1.5 text-text-muted text-sm">
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          {readingTime} min Lesezeit
        </span>

        <!-- Tags -->
        {entry.data.tags.map((tag) => (
          <span class="bg-forest/10 text-forest text-xs font-medium px-3 py-1.5 rounded-full">
            {tag}
          </span>
        ))}
      </div>

      <!-- Description -->
      <p class="text-lg text-text-muted leading-relaxed mb-12 reveal" style="transition-delay: 100ms">
        {entry.data.description}
      </p>

      <!-- Markdown Content -->
      <div class="blog-content mb-16 reveal" style="transition-delay: 200ms">
        <Content />
      </div>
    </div>

    <!-- Related Articles -->
    {related.length > 0 && (
      <section class="mt-16 md:mt-24 border-t border-sand/30 pt-16 md:pt-24">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-12 reveal">
            <h2 class="font-heading text-3xl md:text-4xl text-forest">
              Weitere Beiträge
            </h2>
            <p class="text-text-muted mt-4">
              Entdecken Sie mehr Tipps und Fachwissen
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {related.map((post, i) => (
              <div class="reveal" style={`transition-delay: ${i * 100}ms`}>
                <BlogCard
                  title={post.data.title}
                  description={post.data.description}
                  heroImage={post.data.heroImage}
                  date={post.data.date}
                  tags={post.data.tags}
                  href={`/blog/${post.id}`}
                />
              </div>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />

  <!-- Schema.org BlogPosting -->
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
</MainLayout>

<style>
  /* Prose-like styling for markdown content without @tailwindcss/typography */
  .blog-content :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--color-forest);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .blog-content :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--color-forest);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .blog-content :global(p) {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .blog-content :global(ul),
  .blog-content :global(ol) {
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .blog-content :global(ul) {
    list-style-type: disc;
  }

  .blog-content :global(ol) {
    list-style-type: decimal;
  }

  .blog-content :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.75;
  }

  .blog-content :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .blog-content :global(a) {
    color: var(--color-terracotta);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .blog-content :global(a:hover) {
    color: var(--color-terracotta-dark);
  }

  .blog-content :global(blockquote) {
    border-left: 3px solid var(--color-sand);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .blog-content :global(h2:first-child) {
    margin-top: 0;
  }
</style>
