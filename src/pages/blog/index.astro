---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<MainLayout
  title="Blog | Gartenbau Z.M."
  description="Tipps, Inspirationen und Fachwissen rund um Garten- und Landschaftsbau. Aktuelle Beiträge von Gartenbau Z.M. aus Ludwigsburg, Stuttgart und Region."
>
  <Header />

  <!-- Hero -->
  <section class="bg-pine text-white pt-32 pb-14 md:pt-40 md:pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 font-mono text-[0.72rem] uppercase tracking-[0.14em] text-white/50">
          <li><a href="/" class="hover:text-marker transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-white/80">Blog</li>
        </ol>
      </nav>
      <p class="eyebrow eyebrow-light">Ratgeber</p>
      <h1 class="font-display font-extrabold uppercase text-white text-4xl md:text-5xl lg:text-6xl mt-5" style="font-stretch: 118%;">
        Blog
      </h1>
      <p class="text-white/70 text-lg md:text-xl mt-5 max-w-2xl">
        Tipps, Fachwissen und Inspirationen rund um Garten- und Landschaftsbau — direkt von unseren Experten.
      </p>
    </div>
  </section>

  <!-- Blog Listing -->
  <main id="main-content" class="py-20 md:py-28 bg-paper">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sorted.map((post, i) => (
          <div class="reveal" style={`transition-delay: ${(i % 3) * 100}ms`}>
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              heroImage={post.data.heroImage}
              date={post.data.date}
              tags={post.data.tags}
              href={`/blog/${post.id}`}
            />
          </div>
        ))}
      </div>
    </div>
  </main>

  <!-- CTA-Band -->
  <section class="py-20 md:py-28 bg-pine text-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 text-center">
      <p class="eyebrow eyebrow-light justify-center">Kontakt</p>
      <h2 class="font-display font-extrabold uppercase text-white text-3xl md:text-4xl mt-5" style="font-stretch: 118%;">
        Projekt besprechen?
      </h2>
      <p class="text-white/70 mt-4 text-lg">Kostenlose Erstberatung — vor Ort und unverbindlich.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-8">
        <a href="/#kontakt" class="btn btn-primary">Kostenlose Beratung anfragen</a>
        <a href="tel:+491782747470" class="btn btn-outline text-white">+49 178 2747470</a>
      </div>
    </div>
  </section>

  <Footer />
</MainLayout>
