---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import BeforeAfterSlider from '../../components/gallery/BeforeAfterSlider';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allProjects = await getCollection('projects');
const related = allProjects.filter((p) => p.id !== entry.id).slice(0, 3);

const categoryLabels: Record<string, string> = {
  gartengestaltung: 'Gartengestaltung',
  naturstein: 'Naturstein',
  terrasse: 'Terrassenbau',
  pflaster: 'Pflasterarbeiten',
  sichtschutz: 'Sichtschutz',
};

const categoryLabel = categoryLabels[entry.data.category] ?? entry.data.category;
---

<MainLayout
  title={`${entry.data.title} | Gartenbau Z.M.`}
  description={entry.data.description}
  ogImage={entry.data.heroImage}
>
  <Header />

  <!-- Hero -->
  <section class="bg-pine text-white pt-32 pb-14 md:pt-40 md:pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex flex-wrap items-center gap-2 font-mono text-[0.72rem] uppercase tracking-[0.14em] text-white/50">
          <li><a href="/" class="hover:text-marker transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/projekte" class="hover:text-marker transition-colors">Projekte</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-white/80">{entry.data.title}</li>
        </ol>
      </nav>
      <p class="eyebrow eyebrow-light">{categoryLabel}</p>
      <h1 class="font-display font-extrabold uppercase text-white text-4xl md:text-5xl lg:text-6xl mt-5" style="font-stretch: 118%;">
        {entry.data.title}
      </h1>
      <p class="text-white/70 text-lg md:text-xl mt-5 max-w-2xl">
        {entry.data.description}
      </p>

      <!-- Spec strip: Projektfakten -->
      <dl class="flex flex-wrap gap-x-10 gap-y-3 font-mono text-[0.72rem] uppercase tracking-[0.14em] border-t border-white/10 mt-10 pt-6">
        <div class="flex items-baseline gap-2">
          <dt class="text-white/50">Ort</dt>
          <dd class="text-white">{entry.data.location}</dd>
        </div>
        {entry.data.duration && (
          <div class="flex items-baseline gap-2">
            <dt class="text-white/50">Dauer</dt>
            <dd class="text-white">{entry.data.duration}</dd>
          </div>
        )}
        <div class="flex items-baseline gap-2">
          <dt class="text-white/50">Kategorie</dt>
          <dd class="text-white">{categoryLabel}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Main Content -->
  <main id="main-content" class="py-20 md:py-28 bg-paper">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

      <!-- Hero-Foto -->
      <figure class="reveal">
        <img
          src={entry.data.heroImage}
          alt={entry.data.title}
          class="rounded-lg border border-line w-full aspect-[16/9] object-cover"
          width="1200"
          height="675"
        />
        <figcaption class="flex items-center justify-between font-mono text-[0.7rem] uppercase tracking-[0.14em] text-bark mt-3">
          <span>{categoryLabel}</span>
          <span>{entry.data.location}</span>
        </figcaption>
      </figure>

      <!-- Markdown Content -->
      <div class="project-content mt-12 reveal" style="transition-delay: 100ms">
        <Content />
      </div>

      <!-- Before/After Sliders -->
      {entry.data.beforeAfter && entry.data.beforeAfter.length > 0 && (
        <section class="mt-16 reveal">
          <h2 class="font-display font-extrabold uppercase text-2xl md:text-3xl text-ink mb-8" style="font-stretch: 118%;">
            Vorher &amp; Nachher
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {entry.data.beforeAfter.map((ba: { before: string; after: string }, i: number) => (
              <div class="rounded-lg border border-line overflow-hidden">
                <BeforeAfterSlider
                  client:visible
                  beforeImage={ba.before}
                  afterImage={ba.after}
                  beforeAlt={`${entry.data.title} — Vorher ${i + 1}`}
                  afterAlt={`${entry.data.title} — Nachher ${i + 1}`}
                />
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Image Gallery -->
      {entry.data.images.length > 0 && (
        <section class="mt-16 reveal">
          <h2 class="font-display font-extrabold uppercase text-2xl md:text-3xl text-ink mb-8" style="font-stretch: 118%;">
            Projektbilder
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            {entry.data.images.map((img: string, i: number) => (
              <div class="rounded-lg border border-line overflow-hidden aspect-[4/3]">
                <img
                  src={img}
                  alt={`${entry.data.title} — Bild ${i + 1}`}
                  class="w-full h-full object-cover hover:scale-[1.03] transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  </main>

  <!-- Related Projects -->
  {related.length > 0 && (
    <section class="py-20 md:py-28 bg-stone">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <p class="eyebrow">Projekte</p>
          <h2 class="font-display font-extrabold uppercase text-3xl md:text-4xl text-ink mt-5" style="font-stretch: 118%;">
            Weitere Projekte
          </h2>
          <p class="text-bark mt-4">Entdecken Sie mehr unserer Arbeiten.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
          {related.map((project, i) => (
            <div class="reveal" style={`transition-delay: ${i * 80}ms`}>
              <ProjectCard
                title={project.data.title}
                description={project.data.description}
                category={project.data.category}
                heroImage={project.data.heroImage}
                location={project.data.location}
                duration={project.data.duration}
                href={`/projekte/${project.id}`}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA-Band -->
  <section class="py-20 md:py-28 bg-pine text-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 text-center">
      <p class="eyebrow eyebrow-light justify-center">Kontakt</p>
      <h2 class="font-display font-extrabold uppercase text-white text-3xl md:text-4xl mt-5" style="font-stretch: 118%;">Ähnliches Projekt geplant?</h2>
      <p class="text-white/70 mt-4 text-lg">Kostenlose Erstberatung — vor Ort und unverbindlich.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-8">
        <a href="/#kontakt" class="btn btn-primary">Kostenlose Beratung anfragen</a>
        <a href="tel:+491782747470" class="btn btn-outline text-white">+49 178 2747470</a>
      </div>
    </div>
  </section>

  <Footer />
</MainLayout>

<style>
  /* Prose-Styling für Markdown-Inhalte (Werkplan) */
  .project-content :global(h2) {
    font-family: var(--font-display);
    font-weight: 750;
    font-stretch: 118%;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--color-ink);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .project-content :global(h3) {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 110%;
    font-size: 1.2rem;
    line-height: 1.3;
    color: var(--color-ink);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .project-content :global(p) {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-bark);
    margin-bottom: 1.25rem;
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    color: var(--color-bark);
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .project-content :global(ul) {
    list-style-type: square;
  }

  .project-content :global(ol) {
    list-style-type: decimal;
  }

  .project-content :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.75;
  }

  .project-content :global(li::marker) {
    color: var(--color-marker-dark);
  }

  .project-content :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }

  .project-content :global(a) {
    color: var(--color-moss);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .project-content :global(a:hover) {
    color: var(--color-pine);
  }

  .project-content :global(blockquote) {
    border-left: 3px solid var(--color-marker);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: var(--color-bark);
  }

  .project-content :global(img) {
    border-radius: 0.5rem;
    border: 1px solid var(--color-line);
    max-width: 100%;
  }

  .project-content :global(h2:first-child) {
    margin-top: 0;
  }
</style>
