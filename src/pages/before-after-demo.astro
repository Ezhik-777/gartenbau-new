---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BeforeAfterSlider from '../components/gallery/BeforeAfterSlider';
---

<MainLayout
  title="Before/After Showcase - Gartenbau Z.M."
  description="Sehen Sie unsere Gartentransformationen im Vorher-Nachher-Vergleich"
  noindex={true}
>
  <Header />

  <!-- Hero -->
  <section class="bg-pine text-white pt-32 pb-14 md:pt-40 md:pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 font-mono text-[0.72rem] uppercase tracking-[0.14em] text-white/50">
          <li><a href="/" class="hover:text-marker transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-white/80">Vorher / Nachher</li>
        </ol>
      </nav>
      <p class="eyebrow eyebrow-light">Referenzen</p>
      <h1 class="font-display font-extrabold uppercase text-white text-4xl md:text-5xl lg:text-6xl mt-5" style="font-stretch: 118%;">Unsere Transformationen</h1>
      <p class="text-white/70 text-lg md:text-xl mt-5 max-w-2xl">Entdecken Sie, wie wir Gärten und Außenbereiche verwandeln.</p>
    </div>
  </section>

  <main id="main-content" class="py-20 md:py-28 bg-paper">
    <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-16 max-w-[1200px] mx-auto">
        <div class="reveal">
          <BeforeAfterSlider
            client:visible
            beforeImage="/img/image_15.webp"
            afterImage="/img/image_45.webp"
            beforeAlt="Garten vor der Sanierung"
            afterAlt="Garten nach der professionellen Gestaltung"
            title="Garten Komplettsanierung Stuttgart"
          />
        </div>

        <div class="reveal">
          <BeforeAfterSlider
            client:visible
            beforeImage="/img/image_30.webp"
            afterImage="/img/image_60.webp"
            beforeAlt="Terrassenbereich vor dem Bau"
            afterAlt="Fertige Terrasse mit Naturstein"
            title="Terrassenbau mit Naturstein"
          />
        </div>

        <div class="reveal">
          <BeforeAfterSlider
            client:visible
            beforeImage="/img/image_80.webp"
            afterImage="/img/image_120.webp"
            beforeAlt="Einfahrt vor Pflasterarbeiten"
            afterAlt="Neue gepflasterte Einfahrt"
            title="Pflasterarbeiten Einfahrt"
          />
        </div>

        <div class="reveal">
          <BeforeAfterSlider
            client:visible
            beforeImage="/img/image_100.webp"
            afterImage="/img/image_140.webp"
            beforeAlt="Garten ohne Sichtschutz"
            afterAlt="Installierter Sichtschutz"
            title="Sichtschutz Installation"
          />
        </div>

        <div class="reveal">
          <BeforeAfterSlider
            client:visible
            beforeImage="/img/image_20.webp"
            afterImage="/img/image_90.webp"
            beforeAlt="Gartenweg vor Natursteinarbeiten"
            afterAlt="Fertiger Gartenweg mit Naturstein"
            title="Natursteinarbeiten Gartenweg"
          />
        </div>
      </div>

      <div class="text-center mt-16">
        <a href="/galerie" class="btn btn-dark">
          Alle Projekte ansehen &rarr;
        </a>
      </div>
    </section>
  </main>

  <Footer />
</MainLayout>
