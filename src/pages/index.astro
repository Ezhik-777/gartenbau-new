---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
import BeforeAfterSlider from '../components/gallery/BeforeAfterSlider';

const services = [
  { icon: '🌱', title: 'Gartengestaltung', description: 'Professionelle Gartenplanung und -gestaltung mit individueller Beratung.', href: '/leistungen/gartengestaltung' },
  { icon: '🪨', title: 'Natursteinarbeiten', description: 'Hochwertige Natur- und Betonsteinarbeiten für Mauern, Treppen und Einfassungen.', href: '/leistungen/natursteinarbeiten' },
  { icon: '🏗️', title: 'Terrassenbau', description: 'Moderne Terrassengestaltung mit hochwertigen Materialien.', href: '/leistungen/terrassenbau' },
  { icon: '🛤️', title: 'Wege & Zufahrten', description: 'Professionelle Pflasterarbeiten für Einfahrten und Gartenwege.', href: '/leistungen/pflasterarbeiten' },
  { icon: '🏡', title: 'Landschaftsbau', description: 'Kompletter Landschaftsbau von Erdarbeiten bis Bepflanzung.', href: '/leistungen/landschaftsbau' },
  { icon: '🌾', title: 'Rollrasen', description: 'Rollrasen-Verlegung für sofort nutzbaren, dichten Rasen.', href: '/leistungen/rollrasen' },
  { icon: '🧹', title: 'Hausmeisterservice', description: 'Regelmäßige Gartenpflege und Grundstücksbetreuung.', href: '/leistungen/hausmeisterservice' },
  { icon: '🌳', title: 'Sichtschutz', description: 'Sichtschutzzäune, Hecken und Gabionen für Ihre Privatsphäre.', href: '/leistungen/sichtschutz' },
];

const projects = [
  { image: '/img/image_10.webp', title: 'Gartengestaltung Stuttgart-Süd', category: 'Gartengestaltung', text: 'Komplette Neugestaltung eines 200m² Gartens mit Natursteinmauer und Bepflanzung.' },
  { image: '/img/image_15.webp', title: 'Terrassenbau Ludwigsburg', category: 'Terrassenbau', text: 'Moderne Terrassenanlage mit Granitplatten und integrierter LED-Beleuchtung.' },
  { image: '/img/image_20.webp', title: 'Einfahrt Remseck', category: 'Pflasterarbeiten', text: 'Pflasterarbeiten für eine großzügige Einfahrt mit Entwässerungssystem.' },
];
---

<MainLayout
  title="Gartenbau Ludwigsburg & Stuttgart | Landschaftsbau & Gartengestaltung"
  description="Professioneller Gartenbau in Ludwigsburg, Stuttgart, Waiblingen & Region. Gartengestaltung, Terrassen, Natursteinarbeiten. Kostenlose Beratung vor Ort."
>
  <!-- Header -->
  <Header />

  <!-- Hero -->
  <Hero />

  <!-- Trust Bar -->
  <TrustBar />

  <!-- Main Content -->
  <main id="main-content">

    <!-- ==================== Leistungen ==================== -->
    <section id="leistungen" class="py-20 md:py-28 bg-ivory">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center reveal">
          <h2 class="font-heading text-3xl md:text-4xl text-forest">
            Unsere Leistungen
          </h2>
          <p class="text-text-muted mt-4">
            Professioneller Gartenbau und Landschaftsbau in Stuttgart &amp; Region
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
          {services.map((service, i) => (
            <div class="reveal" style={`transition-delay: ${i * 100}ms`}>
              <ServiceCard
                icon={service.icon}
                title={service.title}
                description={service.description}
                href={service.href}
              />
            </div>
          ))}
        </div>

        <div class="text-center mt-12 reveal">
          <a
            href="/leistungen"
            class="inline-flex items-center gap-2 text-terracotta font-medium transition-colors duration-300 hover:text-terracotta-dark"
          >
            Alle Leistungen ansehen
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ==================== Projekte Preview ==================== -->
    <section class="py-20 md:py-28 bg-ivory-warm">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center reveal">
          <h2 class="font-heading text-3xl md:text-4xl text-forest">
            Unsere Projekte
          </h2>
          <p class="text-text-muted mt-4">
            Einblicke in unsere aktuellen Arbeiten
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
          {projects.map((project, i) => (
            <div class="bg-white rounded-2xl overflow-hidden reveal" style={`transition-delay: ${i * 100}ms`}>
              <div class="aspect-4/3 overflow-hidden">
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                  loading="lazy"
                />
              </div>
              <div class="p-6">
                <span class="inline-block bg-forest-light/10 text-forest text-xs font-medium px-3 py-1 rounded-full">
                  {project.category}
                </span>
                <h3 class="font-heading text-xl text-forest mt-3">{project.title}</h3>
                <p class="text-text-muted text-sm leading-relaxed mt-2">{project.text}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="text-center mt-12 reveal">
          <a
            href="/projekte"
            class="inline-flex items-center gap-2 text-terracotta font-medium transition-colors duration-300 hover:text-terracotta-dark"
          >
            Alle Projekte ansehen
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ==================== Vorher & Nachher ==================== -->
    <section class="py-20 md:py-28 bg-ivory">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center reveal">
          <h2 class="font-heading text-3xl md:text-4xl text-forest">
            Vorher &amp; Nachher
          </h2>
          <p class="text-text-muted mt-4">
            Sehen Sie die Verwandlung unserer Projekte
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
          <div class="rounded-2xl overflow-hidden shadow-md reveal">
            <BeforeAfterSlider
              client:visible
              beforeImage="/img/image_1.webp"
              afterImage="/img/image_2.webp"
              beforeAlt="Garten vor der Umgestaltung"
              afterAlt="Garten nach der Umgestaltung - Gartenbau Z.M."
              title="Garten Komplettsanierung Stuttgart"
            />
          </div>

          <div class="rounded-2xl overflow-hidden shadow-md reveal" style="transition-delay: 100ms">
            <BeforeAfterSlider
              client:visible
              beforeImage="/img/image_3.webp"
              afterImage="/img/image_4.webp"
              beforeAlt="Terrasse vorher"
              afterAlt="Terrasse nachher - professioneller Terrassenbau"
              title="Terrasse mit Naturstein Ludwigsburg"
            />
          </div>

          <div class="rounded-2xl overflow-hidden shadow-md reveal" style="transition-delay: 200ms">
            <BeforeAfterSlider
              client:visible
              beforeImage="/img/image_5.webp"
              afterImage="/img/image_6.webp"
              beforeAlt="Einfahrt vorher"
              afterAlt="Einfahrt nachher - Pflasterarbeiten"
              title="Einfahrt & Wege Remseck"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== Reviews ==================== -->
    <ReviewsSection />

    <!-- ==================== Über Uns ==================== -->
    <section id="ueber-uns" class="py-20 md:py-28 bg-ivory">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

          <!-- Left: Image -->
          <div class="rounded-2xl overflow-hidden shadow-lg reveal">
            <img
              src="/img/image_5.webp"
              alt="Gartenbau Z.M. Team bei der Arbeit"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>

          <!-- Right: Text -->
          <div class="reveal" style="transition-delay: 150ms">
            <span class="uppercase tracking-widest text-terracotta text-sm font-medium">
              Über uns
            </span>

            <h2 class="font-heading text-3xl md:text-4xl text-forest mt-4">
              Ihr Partner für professionellen Gartenbau
            </h2>

            <p class="text-text-muted leading-relaxed mt-6">
              Gartenbau Z.M. ist Ihr Familienbetrieb für hochwertige Garten- und
              Landschaftsbauarbeiten in Ludwigsburg, Stuttgart, Waiblingen
              und der gesamten Region. Mit Leidenschaft und handwerklichem Können
              verwandeln wir Ihre Außenbereiche in grüne Wohlfühloasen.
            </p>

            <p class="text-text-muted leading-relaxed mt-4">
              Von der ersten Idee bis zur fertigen Umsetzung begleiten wir Sie
              persönlich durch jedes Projekt. Unsere lokale Verwurzelung und
              jahrelange Erfahrung garantieren Ihnen erstklassige Ergebnisse
              mit einem Ansprechpartner, der immer erreichbar ist.
            </p>

            <p class="text-text-muted leading-relaxed mt-4">
              Wir stehen für transparente Kommunikation, faire Preise und
              termingerechte Fertigstellung. Jedes Projekt, ob klein oder groß,
              erhält bei uns die gleiche Sorgfalt und Aufmerksamkeit.
            </p>

            <!-- Bullet features -->
            <ul class="mt-8 space-y-3">
              <li class="flex items-center gap-3 text-forest font-medium">
                <span class="text-terracotta" aria-hidden="true">&#10003;</span>
                Über 10 Jahre Erfahrung
              </li>
              <li class="flex items-center gap-3 text-forest font-medium">
                <span class="text-terracotta" aria-hidden="true">&#10003;</span>
                Kostenlose Erstberatung
              </li>
              <li class="flex items-center gap-3 text-forest font-medium">
                <span class="text-terracotta" aria-hidden="true">&#10003;</span>
                Faire Festpreise
              </li>
              <li class="flex items-center gap-3 text-forest font-medium">
                <span class="text-terracotta" aria-hidden="true">&#10003;</span>
                Termingarantie
              </li>
            </ul>

            <!-- CTA -->
            <a
              href="/#kontakt"
              class="inline-flex items-center gap-2 text-terracotta font-medium mt-8 transition-colors duration-300 hover:text-terracotta-dark"
            >
              Jetzt beraten lassen
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== FAQ ==================== -->
    <FAQ />

    <!-- ==================== Kontakt ==================== -->
    <ContactForm />

  </main>

  <!-- Footer -->
  <Footer />
</MainLayout>
