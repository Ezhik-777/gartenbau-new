---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';

const services = [
  { code: 'LV 01', title: 'Gartengestaltung', description: 'Planung und Neuanlage — vom Konzept bis zur Bepflanzung.', href: '/leistungen/gartengestaltung' },
  { code: 'LV 02', title: 'Natursteinarbeiten', description: 'Mauern, Treppen und Einfassungen aus Granit, Sandstein, Muschelkalk.', href: '/leistungen/natursteinarbeiten' },
  { code: 'LV 03', title: 'Terrassenbau', description: 'Naturstein, WPC oder Holz — mit frostsicherem Unterbau.', href: '/leistungen/terrassenbau' },
  { code: 'LV 04', title: 'Pflasterarbeiten', description: 'Einfahrten, Wege und Höfe mit sauberer Entwässerung.', href: '/leistungen/pflasterarbeiten' },
  { code: 'LV 05', title: 'Landschaftsbau', description: 'Erdarbeiten, Hangbefestigung, Modellierung des Geländes.', href: '/leistungen/landschaftsbau' },
  { code: 'LV 06', title: 'Rollrasen', description: 'Bodenvorbereitung und Verlegung — sofort nutzbarer Rasen.', href: '/leistungen/rollrasen' },
  { code: 'LV 07', title: 'Sichtschutz', description: 'Zäune, Gabionen und Hecken für Ihre Privatsphäre.', href: '/leistungen/sichtschutz' },
  { code: 'LV 08', title: 'Hausmeisterservice', description: 'Regelmäßige Pflege für Garten und Grundstück.', href: '/leistungen/hausmeisterservice' },
];

const steps = [
  { nr: '01', title: 'Beratung vor Ort', text: 'Kostenlos und unverbindlich: Wir nehmen Maß, prüfen den Bestand und hören zu, was Sie sich wünschen.' },
  { nr: '02', title: 'Konzept & Festpreis', text: 'Sie erhalten ein klares Angebot mit allen Positionen — keine versteckten Kosten, keine Überraschungen.' },
  { nr: '03', title: 'Umsetzung', text: 'Unser eigenes Team baut termingerecht, mit ordentlicher Baustelle und kurzen Wegen zum Chef.' },
  { nr: '04', title: 'Übergabe & Pflege', text: 'Gemeinsame Abnahme, Pflegehinweise und Garantie. Auf Wunsch übernehmen wir die laufende Pflege.' },
];

// 3 aktuelle Projekte fürs Preview
const allProjects = (await getCollection('projects'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const projects = [...allProjects.filter(p => p.data.featured), ...allProjects.filter(p => !p.data.featured)].slice(0, 3);

const categoryLabels: Record<string, string> = {
  gartengestaltung: 'Gartengestaltung',
  naturstein: 'Naturstein',
  terrasse: 'Terrassenbau',
  pflaster: 'Pflasterarbeiten',
  sichtschutz: 'Sichtschutz',
};
---

<MainLayout
  title="Gartenbau Ludwigsburg & Stuttgart | Landschaftsbau & Gartengestaltung"
  description="Professioneller Gartenbau in Ludwigsburg, Stuttgart, Waiblingen & Region. Gartengestaltung, Terrassen, Natursteinarbeiten. Kostenlose Beratung vor Ort."
>
  <Header />

  <Hero />

  <!-- Facts band -->
  <TrustBar />

  <main id="main-content">

    <!-- ==================== Leistungen (Leistungsverzeichnis) ==================== -->
    <section id="leistungen" class="pt-16 pb-20 md:pt-20 md:pb-28 bg-paper">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <p class="eyebrow">Leistungen</p>
          <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mt-5">
            <h2 class="font-display font-extrabold uppercase text-3xl md:text-4xl text-ink" style="font-stretch: 118%;">
              Was wir bauen
            </h2>
            <a
              href="/leistungen"
              class="inline-flex items-center gap-2 text-moss font-semibold transition-colors duration-200 hover:text-pine group"
            >
              Alle Leistungen im Detail
              <span class="inline-block transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <!-- LV list -->
        <div class="grid grid-cols-1 lg:grid-cols-2 lg:gap-x-12 mt-10 border-t border-line">
          {services.map((service, i) => (
            <a
              href={service.href}
              class="lv-row group relative grid grid-cols-[auto_1fr_auto] items-baseline gap-x-5 py-5 px-3 -mx-3 border-b border-line transition-colors duration-200 hover:bg-stone reveal"
              style={`transition-delay: ${(i % 4) * 50}ms`}
            >
              <span class="absolute left-0 top-0 bottom-0 w-[3px] bg-marker scale-y-0 origin-top transition-transform duration-300 group-hover:scale-y-100" aria-hidden="true"></span>
              <span class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-bark/70 tabular-nums">{service.code}</span>
              <span class="min-w-0">
                <span class="block font-display font-bold text-lg text-ink" style="font-stretch: 110%;">{service.title}</span>
                <span class="block text-bark text-sm leading-relaxed mt-0.5">{service.description}</span>
              </span>
              <span class="text-moss transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ==================== Projekte Preview ==================== -->
    <section class="py-20 md:py-28 bg-stone">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <p class="eyebrow">Projekte</p>
          <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mt-5">
            <h2 class="font-display font-extrabold uppercase text-3xl md:text-4xl text-ink" style="font-stretch: 118%;">
              Zuletzt gebaut
            </h2>
            <a
              href="/projekte"
              class="inline-flex items-center gap-2 text-moss font-semibold transition-colors duration-200 hover:text-pine group"
            >
              Alle Projekte
              <span class="inline-block transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-10">
          {projects.map((project, i) => (
            <a
              href={`/projekte/${project.id}`}
              class="group flex flex-col h-full bg-white rounded-lg border border-line overflow-hidden transition-all duration-200 hover:border-ink/20 hover:-translate-y-1 hover:shadow-xl hover:shadow-ink/8 reveal"
              style={`transition-delay: ${i * 80}ms`}
            >
              <div class="relative aspect-[4/3] overflow-hidden">
                <img
                  src={project.data.heroImage}
                  alt={project.data.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  loading="lazy"
                  width="800"
                  height="600"
                />
              </div>
              <!-- Spec strip -->
              <div class="flex items-center justify-between gap-3 font-mono text-[0.65rem] uppercase tracking-[0.13em] text-bark border-b border-line px-5 py-2.5">
                <span>{categoryLabels[project.data.category] ?? project.data.category}</span>
                <span>{project.data.location}{project.data.duration ? ` · ${project.data.duration}` : ''}</span>
              </div>
              <div class="flex flex-col flex-1 p-5">
                <h3 class="font-display font-bold text-lg text-ink leading-snug" style="font-stretch: 110%;">{project.data.title}</h3>
                <p class="text-bark text-sm leading-relaxed mt-2 line-clamp-2 flex-1">{project.data.description}</p>
                <span class="inline-flex items-center gap-1.5 text-moss text-sm font-semibold mt-4">
                  Projekt ansehen
                  <span class="inline-block transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ==================== Ablauf ==================== -->
    <section class="py-20 md:py-28 bg-paper">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <p class="eyebrow">Ablauf</p>
          <h2 class="font-display font-extrabold uppercase text-3xl md:text-4xl text-ink mt-5" style="font-stretch: 118%;">
            Vom Aufmaß zur Übergabe
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10 mt-12">
          {steps.map((step, i) => (
            <div class="reveal" style={`transition-delay: ${i * 80}ms`}>
              <div class="flex items-center gap-4">
                <span class="font-display font-extrabold text-4xl text-line" style="font-stretch: 120%;">{step.nr}</span>
                <div class="dim-line flex-1"></div>
              </div>
              <h3 class="font-display font-bold text-lg text-ink mt-4" style="font-stretch: 110%;">{step.title}</h3>
              <p class="text-bark text-sm leading-relaxed mt-2">{step.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ==================== Reviews ==================== -->
    <ReviewsSection />

    <!-- ==================== Über uns ==================== -->
    <section id="ueber-uns" class="py-20 md:py-28 bg-paper">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

          <!-- Left: real work photo -->
          <figure class="photo-frame reveal">
            <img
              src="/img/baustelle-verdichtung.webp"
              alt="Gartenbau Z.M. bei der Arbeit — Verdichtung der Tragschicht mit der Rüttelplatte"
              class="w-full aspect-[4/5] lg:aspect-[5/6] object-cover object-top rounded-lg border border-line"
              loading="lazy"
              width="1200"
              height="1600"
            />
            <figcaption class="flex items-center justify-between font-mono text-[0.7rem] uppercase tracking-[0.14em] text-bark mt-4 px-0.5">
              <span>Auf der Baustelle</span>
              <span>Verdichtung der Tragschicht</span>
            </figcaption>
          </figure>

          <!-- Right: Text -->
          <div class="reveal" style="transition-delay: 100ms">
            <p class="eyebrow">Über uns</p>

            <h2 class="font-display font-extrabold uppercase text-3xl md:text-4xl text-ink mt-5" style="font-stretch: 118%;">
              Familienbetrieb aus Remseck
            </h2>

            <p class="text-bark leading-relaxed mt-6">
              Gartenbau Z.M. baut seit über zehn Jahren Gärten, Terrassen und
              Außenanlagen in Ludwigsburg, Stuttgart und der Region. Wir arbeiten
              mit eigenem Team, eigener Technik — und einem Anspruch: Was wir
              bauen, muss Jahrzehnte halten.
            </p>

            <p class="text-bark leading-relaxed mt-4">
              Sie sprechen bei uns direkt mit dem, der Ihr Projekt auch umsetzt.
              Kurze Wege, klare Absprachen, ein Festpreis — und eine Baustelle,
              die jeden Abend aufgeräumt ist.
            </p>

            <!-- Checklist -->
            <ul class="mt-8 space-y-3">
              {['Über 10 Jahre Erfahrung', 'Kostenlose Erstberatung vor Ort', 'Faire Festpreise ohne Nachträge', 'Termingarantie'].map((item) => (
                <li class="flex items-center gap-3 text-ink font-medium">
                  <span class="flex items-center justify-center w-5 h-5 bg-marker rounded-sm font-mono text-[0.7rem] text-ink" aria-hidden="true">&#10003;</span>
                  {item}
                </li>
              ))}
            </ul>

            <!-- CTA -->
            <div class="flex flex-col sm:flex-row gap-3 mt-9">
              <a href="/#kontakt" class="btn btn-primary">
                Jetzt beraten lassen
              </a>
              <a href="/galerie" class="btn btn-outline text-ink">
                Galerie ansehen
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== FAQ ==================== -->
    <FAQ />

    <!-- ==================== Kontakt ==================== -->
    <ContactForm />

  </main>

  <Footer />
</MainLayout>
