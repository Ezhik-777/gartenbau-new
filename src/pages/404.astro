---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<MainLayout
  title="Seite nicht gefunden | Gartenbau Z.M."
  description="Die angeforderte Seite wurde nicht gefunden. Entdecken Sie unsere Leistungen oder kehren Sie zur Startseite zurück."
  noindex={true}
>
  <Header />

  <main id="main-content" class="min-h-[80vh] flex items-center justify-center bg-paper pt-32 pb-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 text-center">
      <p class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-bark">
        Fehler / Seite nicht gefunden
      </p>

      <h1
        class="font-display font-extrabold uppercase text-ink leading-none text-[6rem] md:text-[10rem] mt-6 select-none"
        style="font-stretch: 125%;"
      >
        <mark class="mark-marker mark-marker-animate">404</mark>
      </h1>

      <p class="font-display font-bold uppercase text-2xl md:text-3xl text-ink mt-6" style="font-stretch: 118%;">
        Hier ist noch nichts gebaut
      </p>

      <p class="text-bark text-lg mt-4 max-w-md mx-auto leading-relaxed">
        Die Seite, die Sie suchen, existiert nicht oder wurde verschoben.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-10">
        <a href="/" class="btn btn-primary">Zur Startseite</a>
        <a href="/leistungen" class="btn btn-outline text-ink">Leistungen ansehen</a>
      </div>

      <div class="mt-14 pt-8 border-t border-line max-w-lg mx-auto">
        <p class="font-mono text-[0.72rem] uppercase tracking-[0.14em] text-bark mb-4">Vielleicht suchen Sie</p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a href="/projekte" class="text-sm font-semibold text-moss hover:text-pine transition-colors">Projekte</a>
          <span class="text-line" aria-hidden="true">&middot;</span>
          <a href="/galerie" class="text-sm font-semibold text-moss hover:text-pine transition-colors">Galerie</a>
          <span class="text-line" aria-hidden="true">&middot;</span>
          <a href="/blog" class="text-sm font-semibold text-moss hover:text-pine transition-colors">Blog</a>
          <span class="text-line" aria-hidden="true">&middot;</span>
          <a href="/#kontakt" class="text-sm font-semibold text-moss hover:text-pine transition-colors">Kontakt</a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</MainLayout>
